---
import { nav, footer } from '../../lib/copy';
import { destinations, isCurrent, isVisibleDestination } from '../../lib/site-nav';
import type { Account } from '../../lib/atproto/session';

interface Props {
  currentPath?: string;
  compact?: boolean;
  account?: Account;
}

const { currentPath = '/', compact = false, account = { kind: 'unknown' } } = Astro.props;

// The reading pages; the app and the account live in the header (site-nav.ts).
const links = [
  { href: '/', label: nav.home, active: currentPath === '/' },
  ...destinations
    .filter((d) => d.footer && isVisibleDestination(d, account.kind))
    .map((d) => ({ href: d.href, label: d.label, active: isCurrent(currentPath, d.match) })),
];
---

<footer class:list={['border-t border-foreground text-center', compact ? 'pt-3' : 'pt-8']}>
  <nav
    aria-label={nav.footer}
    class="flex flex-wrap items-center justify-center gap-x-5 gap-y-1 label-caps"
  >
    {links.map((link) => (
      <a
        href={link.href}
        aria-current={link.active ? 'page' : undefined}
        class:list={[
          'flex items-center',
          compact ? 'min-h-9' : 'min-h-11',
          link.active ? 'font-bold text-foreground' : 'transition-colors hover:underline hover:underline-offset-4',
        ]}
      >
        {link.label}
      </a>
    ))}
  </nav>

  <div class:list={['flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-meta text-muted-foreground', compact ? 'mt-1.5' : 'mt-5']}>
    <span>{footer.note}</span>
    <span aria-hidden="true">·</span>
    <span>{footer.drinkResponsibly}</span>
  </div>
</footer>
