---
import AppShell from '../../layouts/AppShell.astro';
import AppBar from './AppBar.astro';
import Explore from '../app/Explore';
import { site, explore, nav } from '../../lib/copy';
import { loadRegister } from '../../lib/drinks/register.server';
import { signInEnabled } from '../../lib/atproto/auth';
import type { Account } from '../../lib/atproto/session';
import { mapHref } from '../../lib/site-nav';
import { readMapView } from '../../lib/map/map-url';
import { loadDrinkEntry } from '../../lib/drinks/drink-entry.server';
import { loadRegionEntry } from '../../lib/map/region-entry.server';
import { quadrants, share } from '../../lib/copy';
import { shareImagePath } from '../../lib/share';
import { regionPath } from '../../lib/map/coordinates';

/**
 * The app, on one screen: your map fixed in place, the search in the header,
 * and one card for your menu, a bar's menu, a drink, rating a pour and your
 * pours. The server says whether the reader is a member, so the island knows
 * where their pours live without asking; `?q=` is the header's search, which
 * works before the island does.
 *
 * `client:load` (not `client:only`) so the shell server-renders and the page
 * has painted content before hydration finishes.
 */
interface Props {
  account: Account;
}

const { account } = Astro.props;
const view = readMapView(Astro.url.searchParams);

const register = await loadRegister();
const authEnabled = await signInEnabled();
const member = account.kind === 'member' ? { did: account.did, handle: account.handle } : null;
const initialQuery = Astro.url.searchParams.get('q') ?? '';
// The drink the address opens, written up: drawn with the page, so its card is whole before the script arrives.
// A region the address narrows the map to (`?region=`), written up, and shared as its own card.
const initialRegion = view.region ? { id: view.region, entry: await loadRegionEntry(view.region) } : null;
const region = view.region ? quadrants.find((q) => q.id === view.region)! : null;
const initialEntry = view.drink && register[view.drink.name] ? await loadDrinkEntry(register[view.drink.name].slug) : null;

---

<AppShell
  title={region ? `${region.name} · ${site.name}` : `${site.name} — ${explore.title}`}
  description={region?.gloss}
  image={region ? { path: shareImagePath(region.id), alt: share.regionAlt(region.name) } : undefined}
  canonical={region ? regionPath(region.id) : undefined}
>
  <Explore client:load register={register} signInEnabled={authEnabled} member={member} initialQuery={initialQuery} initialEntry={initialEntry} initialDrink={view.drink?.name ?? null} initialRegion={initialRegion}>
    <AppBar slot="bar" currentPath={mapHref} account={account} title={nav.map} />
  </Explore>
</AppShell>
