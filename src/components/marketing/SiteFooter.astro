---
import { nav, footer } from '../../lib/copy';
import { destinations, isCurrent } from '../../lib/site-nav';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

// The reading pages; the app and the account live in the header (site-nav.ts).
const links = [
  { href: '/', label: nav.home, active: currentPath === '/' },
  ...destinations
    .filter((d) => !d.app)
    .map((d) => ({ href: d.href, label: d.label, active: isCurrent(currentPath, d.match) })),
];
---

<footer class="border-t border-foreground pt-8 text-center">
  <nav
    aria-label={nav.footer}
    class="flex flex-wrap items-center justify-center gap-x-5 gap-y-1 font-condensed text-xs uppercase tracking-label text-muted-foreground"
  >
    {links.map((link) => (
      <a
        href={link.href}
        aria-current={link.active ? 'page' : undefined}
        class:list={[
          'flex min-h-11 items-center',
          link.active ? 'font-bold text-foreground' : 'transition-colors hover:text-primary',
        ]}
      >
        {link.label}
      </a>
    ))}
  </nav>

  <div class="mt-5 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 font-condensed text-3xs uppercase tracking-label text-muted-foreground">
    <span>{footer.note}</span>
    <span aria-hidden="true">·</span>
    <span>{footer.drinkResponsibly}</span>
  </div>
</footer>
