---
import { quadrants } from '../../lib/copy';
import { regionPath } from '../../lib/quadrant';

/**
 * The four regions as a wine-list index: name · leader · axis, the gloss on
 * the line below. The name opens the drinks filtered to that region
 * (asserted in landing-static.spec.ts).
 */
---

<ul class="border-t border-foreground">
  {
    quadrants.map((q) => (
      <li class="border-b border-border py-3.5">
        <div class="dot-leader">
          <a
            href={regionPath(q.id)}
            class="font-serif text-prose font-bold leading-snug text-foreground transition-colors hover:underline hover:underline-offset-4 md:text-heading"
          >
            {q.name}
          </a>
          <span class="leader" aria-hidden="true" />
          <span class="shrink-0 font-condensed text-label uppercase tracking-label text-secondary">
            {q.axis}
          </span>
        </div>
        <p class="mt-1 text-meta text-muted-foreground">{q.gloss}</p>
      </li>
    ))
  }
</ul>
