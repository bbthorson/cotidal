---
import { quadrants } from '../../lib/copy';

/**
 * The four regions as a wine-list index: name · leader · axis, the gloss on
 * the line below. The name opens the region page; the register link reaches
 * the same region's section of /drinks (asserted in landing-static.spec.ts).
 */
---

<ul class="border-t border-foreground">
  {
    quadrants.map((q) => (
      <li class="border-b border-border py-3.5">
        <div class="dot-leader">
          <a
            href={`/regions/${q.id}`}
            class="font-serif text-prose font-bold leading-snug text-foreground transition-colors hover:text-primary md:text-xl"
          >
            {q.name}
          </a>
          <span class="leader" aria-hidden="true" />
          <span class="shrink-0 font-condensed text-xs uppercase tracking-label text-secondary">
            {q.axis}
          </span>
        </div>
        <div class="mt-1 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
          <p class="text-meta text-muted-foreground">{q.gloss}</p>
          <a
            href={`/drinks#${q.id}`}
            class="font-condensed text-xs uppercase tracking-label text-muted-foreground transition-colors hover:text-primary"
          >
            In the register &rarr;
          </a>
        </div>
      </li>
    ))
  }
</ul>
