---
import { quadrants } from '../../lib/copy';

interface Props {
  showExamples?: boolean;
}

const { showExamples = true } = Astro.props;

const examples: Record<string, string[]> = {
  ember: ['Negroni', 'Sazerac', 'Boulevardier'],
  'salt-line': ['Dry Martini', 'Gin & Tonic', 'Gibson'],
  vault: ['Espresso Martini', 'Brandy Alexander', 'Old Fashioned'],
  orchard: ['Daiquiri', 'Margarita', 'Last Word', 'French 75'],
};
---

<ul class="border-b border-border">
  {
    quadrants.map((q) => (
      <li class="menu-row first:border-t-0 flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-4 py-5">
        <div class="min-w-0 flex-1">
          <div class="flex items-baseline gap-3">
            <a
              href={`/regions/${q.id}`}
              class="font-serif text-lg font-bold leading-none text-foreground transition-colors hover:text-primary md:text-xl"
            >
              {q.name}
            </a>
            <span class="label-caps border border-border px-2 py-0.5 text-secondary sm:hidden">
              {q.axis}
            </span>
          </div>
          <p class="mt-1.5 font-serif text-xs leading-relaxed text-muted-foreground md:text-sm">
            {q.gloss}
          </p>
          {showExamples && examples[q.id] && (
            <p class="mt-2 font-serif text-2xs italic text-foreground/75">
              <span class="font-condensed text-3xs uppercase not-italic tracking-label text-muted-foreground mr-1.5">
                Specimens:
              </span>
              {examples[q.id].join(' · ')}
            </p>
          )}
          <div class="mt-3 flex items-center gap-3 font-condensed text-xs uppercase tracking-label">
            <a
              href={`/regions/${q.id}`}
              class="font-bold text-primary hover:underline"
            >
              Explore Region &rarr;
            </a>
            <span aria-hidden="true" class="text-border">·</span>
            <a
              href={`/drinks#${q.id}`}
              class="text-muted-foreground hover:text-foreground transition-colors"
            >
              In Register &rarr;
            </a>
          </div>
        </div>
        <span class="label-caps hidden shrink-0 border border-border px-2.5 py-1.5 text-secondary sm:inline-block">
          {q.axis}
        </span>
      </li>
    ))
  }
</ul>
