---
import type { QuadrantId } from '../../lib/quadrant';
import { band, cotidalLine, labelPoint, HOUR_LINES, SECTORS, RINGS, CENTRE, TILT, FILLED_REGION } from '../../lib/chart-geometry';

/**
 * The one big move on the landing page: a cotidal chart.
 *
 * On a tide chart, cotidal lines radiate from an amphidrome — the one point
 * where the tide does not rise — and join the places that reach high water
 * at the same hour; the rings around it (co-range lines) join places with the
 * same range. The palate map has the same shape: a zero point at its centre,
 * and lines that divide it into the four regions. So the figure is that chart
 * drawn over the map's axes: a cotidal line for every hour, with every
 * third (the four region boundaries, each leaving the centre along an axis)
 * drawn heavier and labelled, dashed co-range rings, and one region's band filled and the coordinate sitting
 * in it, the same mark as on the map itself. Nothing else: no moon or
 * other ornament, so the figure is the mark drawn large (docs/brand.md).
 *
 * Geometry comes from `src/lib/chart-geometry.ts`, which the coaster and
 * the mark share (docs/coasters.md, `src/lib/mark.ts`). The band filled here
 * is the one the mark fills, so the header and the hero are one drawing.
 *
 * Inline SVG, no island. Token classes, not colour attributes.
 */

interface Props {
  /** The band to fill. The landing page fills the mark's; a region's share card fills its own. */
  region?: QuadrantId;
  /** The coordinate in the band. Drawn only in the landing figure's band, where it was placed. */
  dot?: boolean;
  /**
   * Fill the height it is given rather than set it from its width: the
   * front door's first screen gives the chart what the words and the action
   * leave, so it shrinks on a short phone instead of pushing the page long.
   */
  fit?: boolean;
}

const { region = FILLED_REGION, dot = true, fit = false } = Astro.props;

const lines = HOUR_LINES.map(({ hour, param, index }) => ({
  hour,
  index,
  d: cotidalLine(param).d,
  label: labelPoint(param),
}));
const indexLines = lines.filter((l) => l.index);
const hourLines = lines.filter((l) => !l.index);
const filled = band(SECTORS[region].from, SECTORS[region].to);
const showDot = dot && region === FILLED_REGION;
const rotate = `rotate(${TILT} ${CENTRE.x} ${CENTRE.y})`;
const inner = RINGS.slice(0, -1);
const outer = RINGS[RINGS.length - 1];
---

<figure class:list={['mx-auto w-full max-w-sm', fit && 'h-full']}>
  <svg viewBox="0 0 260 184" class:list={['w-full', fit && 'h-full']} fill="none" role="presentation">
    <!-- The band between the 0h and 3h lines, one region: the one filled shape -->
    <path d={filled} class="fill-primary" />

    <!-- The palate map's axes, running past the chart on both sides -->
    <path d="M0 98 H260 M130 6 V178" class="stroke-chart-axis" stroke-width="1" />

    <!-- Co-range rings, dashed as a tide chart dashes them: a different kind of line from the hours -->
    {inner.map(({ rx, ry }) => (
      <ellipse cx={CENTRE.x} cy={CENTRE.y} rx={rx} ry={ry} transform={rotate} class="stroke-chart-ring" stroke-width="1" stroke-dasharray="3 2.5" />
    ))}
    <ellipse cx={CENTRE.x} cy={CENTRE.y} rx={outer.rx} ry={outer.ry} transform={rotate} class="stroke-foreground" stroke-width="1.5" />

    <!-- Cotidal lines, one an hour. Every third is an index line, heavier and
         labelled, as on a contour map: those are the region boundaries. -->
    {hourLines.map(({ d }) => <path d={d} class="stroke-chart-ring" stroke-width="0.75" />)}
    {indexLines.map(({ d }) => <path d={d} class="stroke-foreground" stroke-width="1.25" />)}

    <!-- Hour of high water on the index lines, as a cotidal chart labels them -->
    <g class="fill-muted-foreground font-condensed" font-size="8" letter-spacing="0.5" text-anchor="middle" aria-hidden="true">
      {indexLines.map(({ hour, label }) => <text x={label.x} y={label.y}>{hour}h</text>)}
    </g>

    <!-- The amphidrome: the map's zero point -->
    <circle cx="130" cy="98" r="2.5" class="fill-card stroke-foreground" stroke-width="1" />

    <!-- The coordinate, sitting in the band -->
    {showDot && (
      <>
        <path d="M168.3 47 V79 M152.3 63 H184.3" class="stroke-chart-cross" stroke-width="1" />
        <circle cx="168.3" cy="63" r="4" class="fill-foreground" />
      </>
    )}
  </svg>
</figure>
