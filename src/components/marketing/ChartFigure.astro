---
import { band, cotidalLine, labelPoint, COTIDAL_LINES, SECTORS, RINGS, CENTRE, TILT } from '../../lib/chart-geometry';

/**
 * The one big move on the landing page: a cotidal chart.
 *
 * On a tide chart, cotidal lines radiate from an amphidrome — the one point
 * where the tide does not rise — and join the places that reach high water
 * at the same hour; the rings around it (co-range lines) join places with the
 * same range. The palate map has the same shape: a zero point at its centre,
 * and lines that divide it into the four regions. So the figure is that chart
 * drawn over the map's axes — four cotidal lines, each leaving the centre
 * along an axis — with one region's band filled and the coordinate sitting
 * in it, the same mark as on the map itself. The accent disc is the moon,
 * which is what moves a tide.
 *
 * Geometry comes from `src/lib/chart-geometry.ts`, which the coaster will
 * share (docs/coasters.md).
 *
 * Inline SVG, no island. Token classes, not colour attributes.
 */

const lines = COTIDAL_LINES.map(({ hour, param }) => ({
  hour,
  d: cotidalLine(param).d,
  label: labelPoint(param),
}));
const filled = band(SECTORS.surf.from, SECTORS.surf.to);
const rotate = `rotate(${TILT} ${CENTRE.x} ${CENTRE.y})`;
const inner = RINGS.slice(0, -1);
const outer = RINGS[RINGS.length - 1];
---

<figure class="mx-auto w-full max-w-sm">
  <svg viewBox="0 0 260 184" class="w-full" fill="none" role="presentation">
    <!-- The moon -->
    <circle cx="58" cy="34" r="22" class="fill-accent" />

    <!-- The band between the 0h and 3h lines, one region: the one filled shape -->
    <path d={filled} class="fill-primary" />

    <!-- The palate map's axes, running past the chart on both sides -->
    <path d="M0 98 H260 M130 6 V178" class="stroke-chart-axis" stroke-width="1" />

    <!-- Co-range rings -->
    {inner.map(({ rx, ry }) => (
      <ellipse cx={CENTRE.x} cy={CENTRE.y} rx={rx} ry={ry} transform={rotate} class="stroke-chart-ring" stroke-width="1" />
    ))}
    <ellipse cx={CENTRE.x} cy={CENTRE.y} rx={outer.rx} ry={outer.ry} transform={rotate} class="stroke-foreground" stroke-width="1.5" />

    <!-- Cotidal lines, three hours apart: one per region boundary -->
    {lines.map(({ d }) => <path d={d} class="stroke-foreground" stroke-width="1" />)}

    <!-- Hour of high water, as a cotidal chart labels its lines -->
    <g class="fill-muted-foreground font-condensed" font-size="8" letter-spacing="0.5" text-anchor="middle" aria-hidden="true">
      {lines.map(({ hour, label }) => <text x={label.x} y={label.y}>{hour}h</text>)}
    </g>

    <!-- The amphidrome: the map's zero point -->
    <circle cx="130" cy="98" r="2.5" class="fill-card stroke-foreground" stroke-width="1" />

    <!-- The coordinate, sitting in the band -->
    <path d="M168.3 47 V79 M152.3 63 H184.3" class="stroke-chart-cross" stroke-width="1" />
    <circle cx="168.3" cy="63" r="4" class="fill-foreground" />
  </svg>
</figure>
