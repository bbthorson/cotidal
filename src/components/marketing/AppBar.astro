---
import Monogram from './Monogram.astro';
import { a11y, nav, site } from '../../lib/copy';
import { accountControl, destinations, isCurrent, isVisibleDestination } from '../../lib/site-nav';
import type { Account } from '../../lib/atproto/session';

interface Props {
  currentPath: string;
  account: Account;
  /**
   * The page's name, in the wordmark's place: what the card holds, said once
   * in the bar rather than on a line of its own under it — the name of the
   * way in (docs/design-system.md, rule 16). The front door, which has none,
   * keeps the wordmark.
   */
  title?: string;
  /** A way back, as an arrow before the name: `← Drinks · Aperitivo` goes to all drinks. */
  back?: { href: string; label: string };
  /** The name is the page's only title (Settings): the bar's name is its `h1`. */
  heading?: boolean;
}

const { currentPath, account, title, back, heading = false } = Astro.props;
const Title = heading ? 'h1' : 'p';
const control = accountControl(account, currentPath);

/**
 * The app bar of a map page: the top of the card, since the map has the top
 * of the screen to itself (docs/design-system.md, Navigation). The card is a
 * phone's width at every size, so the bar is laid out for that width:
 *
 * - first row: the mark, then the page's name (or, on the front door, the
 *   wordmark), and on a phone Menu, from `lg` the account control (`@handle`,
 *   Sign in, or Account);
 * - from `lg`, a row of tabs under it: the map and the reading pages a
 *   drinker reads, so nothing is folded away on a wide screen;
 * - on a phone, Menu opens the same tabs as a list, and the account last.
 *
 * Menu is a <details> driving its sibling <nav> through `peer-open`, so the
 * bar needs no script: `/` ships none.
 */
const visible = destinations.filter((d) => isVisibleDestination(d, account.kind) && (d.header || d.menu));
const caps = 'font-condensed uppercase tracking-label';
---

<header class="flex flex-wrap items-center gap-x-2 border-b border-foreground pb-2">
  <a href="/" class="group order-1 flex min-h-11 shrink-0 items-center gap-2.5">
    <Monogram class="h-7 w-7 shrink-0 transition-transform group-hover:scale-105" />
    {
      !title ? (
        <span class="whitespace-nowrap font-serif text-ui font-bold uppercase leading-none tracking-wordmark text-foreground">{site.name}</span>
      ) : (
        <span class="sr-only">{site.name}</span>
      )
    }
  </a>

  {
    title && (
      <div class="order-1 flex min-w-0 flex-1 items-center gap-2">
        {back && (
          <a href={back.href} aria-label={back.label} class:list={['flex min-h-11 shrink-0 items-center px-1 text-meta text-secondary hover:text-foreground', caps]}>
            &larr;
          </a>
        )}
        <Title class:list={['min-w-0 truncate text-meta font-semibold text-foreground', caps]} data-testid="page-name">
          {title}
        </Title>
      </div>
    )
  }

  {!title && <span class="order-1 flex-1" />}

  <details class="peer order-2 lg:hidden">
    <summary class:list={['summary-plain flex min-h-11 cursor-pointer items-center px-1.5 text-meta font-semibold text-muted-foreground transition-colors hover:text-foreground', caps]}>
      {nav.menu}
    </summary>
  </details>

  <a
    href={control.href}
    aria-current={control.current ? 'page' : undefined}
    class:list={[
      'order-2 hidden min-w-0 items-center px-2.5 py-1.5 text-label text-foreground transition-colors lg:flex lg:border lg:border-foreground lg:hover:bg-secondary lg:hover:text-secondary-foreground',
      caps,
    ]}
  >
    <span class:list={['max-w-40 truncate', control.isHandle && 'normal-case tracking-normal']}>{control.label}</span>
  </a>

  <nav
    aria-label={a11y.mainNav}
    class="order-3 hidden basis-full flex-col border-t border-border peer-open:flex lg:mt-1 lg:flex lg:flex-row lg:gap-4 lg:border-t-0"
  >
    {
      visible.map((item) => {
        const active = isCurrent(currentPath, item.match);
        return (
          <a
            href={item.href}
            aria-current={active ? 'page' : undefined}
            class:list={[
              'flex min-h-11 items-center border-b border-border text-meta transition-colors lg:min-h-0 lg:border-b-3 lg:py-1 lg:text-label',
              caps,
              active ? 'font-bold text-foreground lg:border-foreground' : 'text-muted-foreground hover:text-foreground lg:border-transparent',
            ]}
          >
            {item.label}
          </a>
        );
      })
    }
    <a
      href={control.href}
      aria-current={control.current ? 'page' : undefined}
      class:list={['flex min-h-11 items-center justify-between gap-4 border-t border-foreground text-meta text-foreground lg:hidden', caps, control.current && 'font-bold']}
    >
      <span class:list={['truncate', control.isHandle && 'normal-case tracking-normal']}>{control.label}</span>
      {control.opensSettings && <span class="shrink-0 text-label text-muted-foreground">{nav.settings} &rarr;</span>}
    </a>
  </nav>
</header>
