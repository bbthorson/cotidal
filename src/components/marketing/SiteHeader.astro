---
import Monogram from './Monogram.astro';
import { a11y, account as accountCopy, site, nav } from '../../lib/copy';
import { destinations, signIn, signInHref, isCurrent, accountHref } from '../../lib/site-nav';
import { AUTH_BASE_PATH } from '../../lib/atproto/paths';
import type { Account } from '../../lib/atproto/session';

interface Props {
  currentPath?: string;
  account: Account;
  /**
   * An app page (Radio, Compass, Log, the harbour): on a phone the app bar is
   * its navigation, so there is no Menu to repeat it. The reading pages and
   * Go ashore are at the foot of Log.
   */
  appPage?: boolean;
}

const { currentPath = '/', account, appPage = false } = Astro.props;

/**
 * The account control says what the server knows. A member sees their handle
 * (it opens the account, at the foot of Log) and a Sign out button — a plain form post that answers
 * with a redirect, so it works without JavaScript like sign-in does. A guest
 * sees Sign in. A prerendered page was built before anyone visited, so it
 * cannot know, and says Account rather than guess.
 */
const control =
  account.kind === 'member'
    ? {
        href: accountHref,
        label: account.handle ? `@${account.handle}` : accountCopy.neutral,
        isHandle: !!account.handle,
      }
    : account.kind === 'guest'
      ? { href: signInHref(currentPath), label: signIn.label, isHandle: false }
      : { href: accountHref, label: accountCopy.neutral, isHandle: false };
const signOutAction = `${AUTH_BASE_PATH}/logout`;

/**
 * On a phone the header is wordmark · Sign in · Menu, and the five
 * destinations open under "Menu". It used to stack the wordmark over six
 * wrapping items, which pushed the hero ~230px down the first screen.
 *
 * The disclosure is a <details> driving its sibling <nav> through `peer-open`,
 * so it needs no script — `/` must stay free of client JavaScript
 * (tests/landing-static.spec.ts). From `lg` up the nav is always shown inline.
 */
const controlClass =
  'flex min-h-11 items-center px-1.5 font-condensed text-meta font-semibold uppercase tracking-label transition-colors';
---

<header class="border-b border-foreground pb-3.5 lg:pb-4">
  <div class="flex flex-wrap items-center gap-x-0.5 gap-y-2 lg:flex-nowrap lg:gap-x-3">
    <a
      href="/"
      class="group order-1 mr-auto flex items-center gap-2.5 md:gap-3"
    >
      <Monogram class="h-7 w-7 shrink-0 transition-transform group-hover:scale-105 md:h-9 md:w-9" />
      <div class="whitespace-nowrap leading-none">
        <span class="block font-serif text-ui font-bold uppercase tracking-wordmark text-foreground md:text-prose">
          {site.name}
        </span>
        <span class="mt-1 hidden font-condensed text-label uppercase tracking-label text-muted-foreground md:block">
          {site.tagline}
        </span>
      </div>
    </a>

    <a
      href={control.href}
      class:list={[
        controlClass,
        'order-2 min-w-0 shrink text-foreground hover:text-primary lg:order-3 lg:min-h-0 lg:border lg:border-foreground lg:px-3 lg:py-1.5 lg:text-label lg:hover:bg-secondary lg:hover:text-secondary-foreground',
      ]}
    >
      <span class:list={['max-w-40 truncate lg:max-w-48', control.isHandle && 'normal-case tracking-normal']}>
        {control.label}
      </span>
    </a>

    {
      account.kind === 'member' && (
        <form method="POST" action={signOutAction} class="order-4 hidden lg:flex">
          <button
            type="submit"
            class:list={[controlClass, 'text-muted-foreground hover:text-foreground lg:min-h-0 lg:text-label']}
          >
            {nav.signOut}
          </button>
        </form>
      )
    }

    <details class:list={['peer order-2 lg:hidden', appPage && 'hidden']}>
      <summary
        class:list={[controlClass, 'summary-plain cursor-pointer text-muted-foreground hover:text-foreground']}
      >
        {nav.menu}
      </summary>
    </details>

    <nav
      aria-label={a11y.mainNav}
      class="order-3 hidden basis-full flex-col border-t border-border peer-open:flex lg:order-2 lg:flex lg:basis-auto lg:flex-row lg:items-center lg:gap-1 lg:border-t-0"
    >
      {destinations.filter((d) => d.header).map((item) => {
        const active = isCurrent(currentPath, item.match);
        return (
          <a
            href={item.href}
            aria-current={active ? 'page' : undefined}
            class:list={[
              'flex min-h-11 items-center whitespace-nowrap border-b border-border font-condensed text-meta uppercase tracking-label transition-colors lg:min-h-0 lg:border lg:px-2 lg:py-1.5 lg:text-label',
              active
                ? 'font-bold text-primary lg:border-foreground lg:bg-secondary lg:text-secondary-foreground'
                : 'text-foreground hover:text-primary lg:border-transparent lg:text-muted-foreground lg:hover:bg-card lg:hover:text-foreground',
            ]}
          >
            {item.label}
          </a>
        );
      })}
      {
        /* On a phone, Sign out sits at the foot of the folded menu; from `lg` it is beside the handle. */
        account.kind === 'member' && (
          <form method="POST" action={signOutAction} class="lg:hidden">
            <button
              type="submit"
              class="flex min-h-11 w-full items-center border-b border-border font-condensed text-meta uppercase tracking-label text-muted-foreground transition-colors hover:text-foreground"
            >
              {nav.signOut}
            </button>
          </form>
        )
      }
    </nav>
  </div>
</header>
