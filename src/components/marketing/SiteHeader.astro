---
import Monogram from './Monogram.astro';
import { site } from '../../lib/copy';
import { destinations, signIn, isCurrent } from '../../lib/site-nav';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<header class="border-b border-foreground pb-4">
  <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
    <div class="flex items-center">
      <a
        href="/"
        class="group flex items-center gap-3 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
      >
        <Monogram class="h-8 w-8 shrink-0 transition-transform group-hover:scale-105 md:h-9 md:w-9" />
        <div class="whitespace-nowrap leading-none">
          <span class="block font-serif text-sm font-bold uppercase tracking-wordmark text-foreground md:text-base">
            {site.name}
          </span>
          <span class="mt-1 block font-condensed text-3xs uppercase tracking-label text-muted-foreground">
            {site.tagline}
          </span>
        </div>
      </a>
    </div>

    <div class="flex flex-wrap items-center gap-x-3 gap-y-2 lg:flex-nowrap">
      <nav aria-label="Main Navigation" class="flex flex-wrap items-center gap-1 lg:flex-nowrap">
        {destinations.map((item) => {
          const active = isCurrent(currentPath, item.match);
          return (
            <a
              href={item.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'whitespace-nowrap px-2 py-1.5 font-condensed text-xs uppercase tracking-label transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring',
                active
                  ? 'border border-foreground bg-secondary font-bold text-secondary-foreground shadow-bar'
                  : 'border border-transparent text-muted-foreground hover:bg-card hover:text-foreground',
              ]}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <a
        href={signIn.href}
        class="shrink-0 whitespace-nowrap border border-foreground px-3 py-1.5 font-condensed text-xs uppercase tracking-label text-foreground transition-colors hover:bg-secondary hover:text-secondary-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
      >
        {signIn.label}
      </a>
    </div>
  </div>
</header>
