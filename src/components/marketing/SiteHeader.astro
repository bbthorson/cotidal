---
import Monogram from './Monogram.astro';
import { a11y, account as accountCopy, site, nav } from '../../lib/copy';
import { destinations, signIn, signInHref, isCurrent, accountHref } from '../../lib/site-nav';
import type { Account } from '../../lib/atproto/session';

interface Props {
  currentPath?: string;
  account: Account;
}

const { currentPath = '/', account } = Astro.props;

/**
 * The account control says what the server knows. A member sees their handle,
 * which opens Settings — where signing out is, so the header never repeats it.
 * A guest sees Sign in. A prerendered page was built before anyone visited, so
 * it cannot know, and says Account rather than guess.
 */
const control =
  account.kind === 'member'
    ? {
        href: accountHref,
        label: account.handle ? `@${account.handle}` : accountCopy.neutral,
        isHandle: !!account.handle,
        opensSettings: true,
      }
    : account.kind === 'guest'
      ? { href: signInHref(currentPath), label: signIn.label, isHandle: false, opensSettings: false }
      : { href: accountHref, label: accountCopy.neutral, isHandle: false, opensSettings: false };
const onAccount = isCurrent(currentPath, accountHref);

/**
 * On a phone the header is wordmark · Menu on every page, app or reading, so
 * it reads the same wherever you are. Menu opens the whole site in three
 * groups: the app (Compass, Your map), the reading pages, and the account last.
 * On an app page the bar along the foot repeats Compass and Your map; that is the
 * one duplication, and it is the one a thumb wants.
 *
 * The disclosure is a <details> driving its sibling <nav> through `peer-open`,
 * so it needs no script — `/` must stay free of client JavaScript
 * (tests/landing-static.spec.ts). From `lg` the nav is shown inline (the app
 * destinations only; the reading pages are the footer's) and the account is
 * the bordered control beside it.
 */
const app = destinations.filter((d) => d.header);
const reading = destinations.filter((d) => d.menu);
const controlClass =
  'flex min-h-11 items-center px-1.5 font-condensed text-meta font-semibold uppercase tracking-label transition-colors';
const menuItem =
  'flex min-h-11 items-center justify-between gap-4 border-b border-border font-condensed text-meta uppercase tracking-label transition-colors';
---

<header class="border-b border-foreground pb-3.5 lg:pb-4">
  <div class="flex flex-wrap items-center gap-x-0.5 gap-y-2 lg:flex-nowrap lg:gap-x-3">
    <a href="/" class="group order-1 mr-auto flex items-center gap-2.5 md:gap-3">
      <Monogram class="h-7 w-7 shrink-0 transition-transform group-hover:scale-105 md:h-9 md:w-9" />
      <div class="whitespace-nowrap leading-none">
        <span class="block font-serif text-ui font-bold uppercase tracking-wordmark text-foreground md:text-prose">
          {site.name}
        </span>
      </div>
    </a>

    {/* From `lg`: the account, beside the nav. On a phone it is the folded menu's last row. */}
    <a
      href={control.href}
      aria-current={onAccount ? 'page' : undefined}
      class:list={[
        controlClass,
        'order-3 hidden min-w-0 shrink text-foreground lg:flex lg:min-h-0 lg:border lg:border-foreground lg:px-3 lg:py-1.5 lg:text-label lg:hover:bg-secondary lg:hover:text-secondary-foreground',
      ]}
    >
      <span class:list={['max-w-48 truncate', control.isHandle && 'normal-case tracking-normal']}>{control.label}</span>
    </a>

    <details class="peer order-2 lg:hidden">
      <summary class:list={[controlClass, 'summary-plain cursor-pointer text-muted-foreground hover:text-foreground']}>
        {nav.menu}
      </summary>
    </details>

    <nav
      aria-label={a11y.mainNav}
      class="order-3 hidden basis-full flex-col border-t border-border peer-open:flex lg:order-2 lg:flex lg:basis-auto lg:flex-row lg:items-center lg:gap-1 lg:border-t-0"
    >
      {app.map((item) => {
        const active = isCurrent(currentPath, item.match);
        return (
          <a
            href={item.href}
            aria-current={active ? 'page' : undefined}
            class:list={[
              // "You are here" is a bold label over a heavy ink rule (`.tab`); on a phone's folded menu, bold alone.
              menuItem,
              'whitespace-nowrap lg:min-h-0 lg:border-b-3 lg:px-2 lg:py-1.5 lg:text-label',
              active
                ? 'font-bold text-foreground lg:border-foreground'
                : 'text-foreground lg:border-transparent lg:text-muted-foreground lg:hover:text-foreground',
            ]}
          >
            {item.label}
          </a>
        );
      })}

      {/* The reading pages, on a phone only: from `lg` they are the footer's. */}
      {reading.map((item) => {
        const active = isCurrent(currentPath, item.match);
        return (
          <a
            href={item.href}
            aria-current={active ? 'page' : undefined}
            class:list={[menuItem, 'lg:hidden', active ? 'font-bold text-foreground' : 'text-muted-foreground hover:text-foreground']}
          >
            {item.label}
          </a>
        );
      })}

      {/* The account, last: Sign in, your handle (and where it goes), or Account. */}
      <a
        href={control.href}
        aria-current={onAccount ? 'page' : undefined}
        class:list={[
          'flex min-h-11 items-center justify-between gap-4 border-t border-foreground font-condensed text-meta uppercase tracking-label text-foreground lg:hidden',
          onAccount && 'font-bold',
        ]}
      >
        <span class:list={['truncate', control.isHandle && 'normal-case tracking-normal']}>{control.label}</span>
        {control.opensSettings && <span class="shrink-0 text-label text-muted-foreground">{nav.settings} &rarr;</span>}
      </a>
    </nav>
  </div>
</header>
