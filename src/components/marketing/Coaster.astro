---
import { band, cotidalLine, COTIDAL_LINES, SECTORS, RINGS, CENTRE, TILT } from '../../lib/chart-geometry';
import { qrPath } from '../../lib/coaster';
import type { QuadrantId } from '../../lib/quadrant';

/**
 * A coaster: the landing page's cotidal chart on a disc, with one region's
 * band filled and a QR code at the amphidrome (docs/coasters.md). No dot —
 * a coordinate moves with every pour and a coaster does not; the exact point
 * is on the page the code opens.
 *
 * Geometry comes from `src/lib/chart-geometry.ts`, the same as the landing
 * figure, stretched to fill the disc: the chart is a wide ellipse and a
 * coaster is round. The stretch runs along the map's axes, so every band
 * still holds its region. Strokes do not stretch, and the hour labels sit
 * just inside the outer ring, where the disc has room for them, outlined in
 * card so they read on the band. The landing figure's moon is left off: on a
 * full disc there is nowhere for it to sit clear of the rings. The code is drawn server-side as one path, so no script ships.
 * Not yet sized for print.
 */

interface Props {
  region: QuadrantId;
  /** What the code encodes: an absolute URL. */
  href: string;
  /** The accessible name of the drawing. */
  title: string;
}

const { region, href, title } = Astro.props;

const R = 118;
// Largest stretch that keeps the outer ring inside the disc (≈110 at most).
const SX = 1.12;
const SY = 1.5;
const stretch = `translate(${CENTRE.x} ${CENTRE.y}) scale(${SX} ${SY}) translate(${-CENTRE.x} ${-CENTRE.y})`;
const { from, to } = SECTORS[region];
const filled = band(from, to);
const round = (n: number) => Math.round(n * 10) / 10;
const lines = COTIDAL_LINES.map(({ hour, param }) => {
  const { d, end } = cotidalLine(param);
  const dx = (end.x - CENTRE.x) * SX;
  const dy = (end.y - CENTRE.y) * SY;
  const len = Math.hypot(dx, dy);
  // 11 in from where the line meets the ring, then down 2.8 to centre 8px text.
  const label = { x: round(CENTRE.x + dx - (11 * dx) / len), y: round(CENTRE.y + dy - (11 * dy) / len + 2.8) };
  return { hour, d, label };
});
const rotate = `rotate(${TILT} ${CENTRE.x} ${CENTRE.y})`;

// The code sits on a quiet square of card two modules wide on every side.
const qr = qrPath(href);
const QR = 62;
const unit = QR / qr.size;
const quiet = 2 * unit;
const qrX = CENTRE.x - QR / 2;
const qrY = CENTRE.y - QR / 2;
const clipId = `coaster-${region}`;
---

<svg
  viewBox={`${CENTRE.x - R - 2} ${CENTRE.y - R - 2} ${2 * R + 4} ${2 * R + 4}`}
  class="w-full"
  fill="none"
  role="img"
  aria-label={title}
  data-testid="coaster"
  data-code={href}
>
  <defs>
    <clipPath id={clipId}><circle cx={CENTRE.x} cy={CENTRE.y} r={R} /></clipPath>
  </defs>

  <circle cx={CENTRE.x} cy={CENTRE.y} r={R} class="fill-card stroke-foreground" stroke-width="1.5" />

  <g clip-path={`url(#${clipId})`}>
    <path d={`M${CENTRE.x - R} ${CENTRE.y} H${CENTRE.x + R} M${CENTRE.x} ${CENTRE.y - R} V${CENTRE.y + R}`} class="stroke-chart-axis" stroke-width="1" />
    <g transform={stretch}>
      <path d={filled} class="fill-primary" />
      {RINGS.slice(0, -1).map(({ rx, ry }) => (
        <ellipse cx={CENTRE.x} cy={CENTRE.y} rx={rx} ry={ry} transform={rotate} class="stroke-chart-ring" stroke-width="1" vector-effect="non-scaling-stroke" />
      ))}
      <ellipse cx={CENTRE.x} cy={CENTRE.y} rx={RINGS[2].rx} ry={RINGS[2].ry} transform={rotate} class="stroke-foreground" stroke-width="1.5" vector-effect="non-scaling-stroke" />
      {lines.map(({ d }) => <path d={d} class="stroke-foreground" stroke-width="1" vector-effect="non-scaling-stroke" />)}
    </g>
    <g class="fill-muted-foreground stroke-card font-condensed" font-size="8" letter-spacing="0.5" text-anchor="middle" stroke-width="2.5" paint-order="stroke" aria-hidden="true">
      {lines.map(({ hour, label }) => <text x={label.x} y={label.y}>{hour}h</text>)}
    </g>
  </g>

  <rect x={qrX - quiet} y={qrY - quiet} width={QR + 2 * quiet} height={QR + 2 * quiet} rx="2" class="fill-card" />
  <path
    d={qr.d}
    transform={`translate(${qrX} ${qrY}) scale(${unit})`}
    class="fill-foreground"
    shape-rendering="crispEdges"
  />
</svg>
