---
import { principles } from '../../lib/copy';

/* Inline SVGs rather than lucide-react: these are decorative and must not
   pull a React island onto a page that otherwise ships no JavaScript. */
const paths: Record<string, string> = {
  lock: 'M7 11V7a5 5 0 0 1 10 0v4M5 11h14v10H5z',
  book: 'M4 19.5A2.5 2.5 0 0 1 6.5 17H20M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z',
  compass: 'M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20zM16.2 7.8l-2.9 6.4-6.4 2.9 2.9-6.4 6.4-2.9z',
};
---

<ul class="grid grid-cols-1 gap-x-10 gap-y-8 md:grid-cols-3">
  {
    principles.map((p) => (
      <li class="menu-row pt-5">
        <span class="mb-3 block text-secondary">
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.25"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-5 w-5"
          >
            <path d={paths[p.icon]} />
          </svg>
        </span>
        <h3 class="font-serif text-prose font-bold text-foreground">{p.title}</h3>
        <p class="mt-2 font-serif text-label leading-relaxed text-muted-foreground">{p.body}</p>
      </li>
    ))
  }
</ul>
