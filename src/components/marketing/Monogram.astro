---
import { site } from '../../lib/copy';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

/**
 * The mark: the landing page's cotidal chart reduced to a letter. An open
 * ring makes the C; three cotidal lines run from the centre to it; the band
 * between two of them is filled, as on the large figure, which is what keeps
 * the mark legible at favicon size where hairlines alone disappear.
 * `public/icon.svg` is the same drawing with heavier strokes.
 *
 * Inline SVG rather than an icon library: this renders on `/`, which ships
 * no client JavaScript, so nothing here may pull an island.
 *
 * Colours come from Tailwind token classes rather than fill/stroke attributes
 * — a literal `hsl(...)` in an attribute trips the token rule in
 * eslint.config.mjs, which is the point of that rule.
 */
---

<span class={`inline-flex items-center justify-center ${className}`} aria-hidden="true">
  <svg viewBox="0 0 48 48" class="h-full w-full" fill="none">
    <path d="M24 24 Q16.12 18.69 5 24 A19 19 0 0 1 24 5 Q29.31 16.12 24 24 Z" class="fill-primary" />
    <path d="M38.12 36.71 A19 19 0 1 1 38.12 11.29" class="stroke-primary" stroke-width="1.5" stroke-linecap="round" />
    <path d="M24 24 Q18.69 31.88 24 43" class="stroke-primary" stroke-width="1.5" stroke-linecap="round" />
    <path d="M24 24 Q16.12 18.69 5 24" class="stroke-primary" stroke-width="1.5" stroke-linecap="round" />
    <path d="M24 24 Q29.31 16.12 24 5" class="stroke-primary" stroke-width="1.5" stroke-linecap="round" />
  </svg>
  <span class="sr-only">{site.name}</span>
</span>
