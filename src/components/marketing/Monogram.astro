---
import { site } from '../../lib/copy';
import { mark } from '../../lib/mark';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

/**
 * The mark: the landing page's cotidal chart reduced to a disc, as the
 * coaster draws it — the outer ring, the four cotidal lines, and the same
 * band filled. Geometry and weights come from `src/lib/mark.ts`, which also
 * generates `public/icon.svg` and the favicons, so the header, the tab and
 * the hero are one drawing.
 *
 * Inline SVG rather than an icon library: this renders on `/`, which ships
 * no client JavaScript, so nothing here may pull an island.
 *
 * Colours come from Tailwind token classes rather than fill/stroke attributes
 * — a literal colour in an attribute trips the token rule in
 * eslint.config.mjs, which is the point of that rule.
 */
const m = mark('header');
---

<span class={`inline-flex items-center justify-center ${className}`} aria-hidden="true">
  <svg viewBox={m.viewBox} class="h-full w-full" fill="none">
    <path d={m.band} class="fill-primary" />
    {m.lines.map((d) => <path d={d} class="stroke-foreground" stroke-width={m.lineWidth} stroke-linecap="round" />)}
    <path d={m.ring} class="stroke-foreground" stroke-width={m.ringWidth} />
  </svg>
  <span class="sr-only">{site.name}</span>
</span>
