---
import { assistants as copy } from '../../lib/copy';

interface Props {
  /** The `/mcp` address on this host. */
  address: string;
  /** The member's handle, for the example question; absent at `/mcp`, which cannot know. */
  handle?: string | null;
}

/**
 * How to reach a palate from a chat assistant: the address, where to paste
 * it, what to ask, and what it cannot do. Shown on your own `/p/<handle>`,
 * under the map the assistant reads, and at `/mcp` to anyone who opens the
 * address in a browser. No script: the address is text to select.
 */
const { address, handle } = Astro.props;
---

<div class="space-y-10">
  <section class="space-y-3">
    <h3 class="label-caps text-foreground">{copy.urlLabel}</h3>
    <p class="select-all break-all rounded-sm border border-border bg-card px-3.5 py-3 font-code text-ui text-foreground" data-testid="mcp-address">
      {address}
    </p>
  </section>

  <section class="space-y-3">
    <h3 class="section-title">{copy.stepsTitle}</h3>
    <ol class="list-decimal space-y-2 pl-6 text-ui text-foreground">
      {copy.steps.map((step) => <li>{step}</li>)}
    </ol>
    <p class="text-ui text-muted-foreground">{copy.otherClients}</p>
  </section>

  <section class="space-y-3">
    <h3 class="section-title">{copy.canTitle}</h3>
    <ul class="list-disc space-y-2 pl-6 text-ui text-foreground">
      {copy.can.map((line) => <li>{line}</li>)}
    </ul>
    <p class="text-ui text-muted-foreground">{handle ? copy.askWith(handle) : copy.askWithGuest}</p>
  </section>

  <section class="space-y-3">
    <h3 class="section-title">{copy.readOnlyTitle}</h3>
    <p class="text-ui text-muted-foreground">{copy.readOnly}</p>
  </section>
</div>
