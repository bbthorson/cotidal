---
import { drinks as copy, quadrants } from '../../lib/copy';
import { regionPath, type QuadrantId } from '../../lib/quadrant';
import { drinksHref } from '../../lib/site-nav';

interface Props {
  /** The region the list is narrowed to; absent for every drink. */
  current?: QuadrantId;
}

const { current } = Astro.props;

/**
 * The regions as a filter on the drinks: links, not buttons, so each filter
 * is a page that prerenders and works with no script. "All" is `/drinks`.
 * Five items: on a phone each takes a third of the row, so they set 3 + 2
 * rather than wrapping one region onto a line of its own.
 */
const options = [
  { href: drinksHref, label: copy.filterAll, active: !current },
  ...quadrants.map((q) => ({ href: regionPath(q.id), label: q.name, active: q.id === current })),
];
---

<nav aria-label={copy.filterLabel} class="border-y border-foreground py-2">
  <ul class="flex flex-wrap items-center justify-center gap-y-1 sm:gap-x-5 font-condensed text-label uppercase tracking-label text-muted-foreground">
    {options.map((option) => (
      <li class="basis-1/3 sm:basis-auto">
        <a
          href={option.href}
          aria-current={option.active ? 'page' : undefined}
          class:list={[
            'flex min-h-11 items-center justify-center text-center',
            option.active ? 'font-bold text-foreground' : 'transition-colors hover:text-foreground hover:underline hover:underline-offset-4',
          ]}
        >
          {option.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
