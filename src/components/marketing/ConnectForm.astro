---
import { connect } from '../../lib/copy';
import { AUTH_BASE_PATH } from '../../lib/atproto/paths';

interface Props {
  enabled: boolean;
  error?: string | null;
}

const { enabled, error } = Astro.props;

/**
 * The static twin of the in-app sign-in sheet (src/components/app/SignInSheet):
 * same benefits, same label, same one verb. A plain form post, so `/` keeps
 * working with JavaScript off.
 */
---

<div class="space-y-4">
  <ol class="border-t border-foreground">
    {
      connect.buys.map((b, i) => (
        <li class="flex gap-3 border-b border-border py-3">
          <span class="w-3.5 shrink-0 font-condensed text-sm font-bold text-primary">{i + 1}</span>
          <div class="space-y-0.5">
            <p class="text-ui font-bold text-foreground">{b.title}</p>
            <p class="text-meta text-muted-foreground">{b.body}</p>
          </div>
        </li>
      ))
    }
  </ol>

  {
    /* Rendered outside the enabled/disabled branches: a callback failure can
       redirect here with an error even when sign-in is switched off. */
    error && (
      <p role="alert" class="text-meta text-destructive">
        {error}
      </p>
    )
  }

  {
    enabled ? (
      <form method="POST" action={`${AUTH_BASE_PATH}/login`} class="space-y-4">
        <input type="hidden" name="returnTo" value="/taste" />
        <label for="handle" class="flex flex-col gap-1.5">
          <span class="font-condensed text-xs uppercase tracking-label text-muted-foreground">
            {connect.label}
          </span>
          <input
            id="handle"
            name="handle"
            type="text"
            required
            autocomplete="username"
            autocapitalize="none"
            spellcheck="false"
            placeholder={connect.placeholder}
            class="min-h-12 w-full rounded-sm border border-border bg-card px-3.5 font-body text-base text-foreground placeholder:text-muted-foreground transition-colors focus:border-primary focus:outline-none"
          />
        </label>
        <button
          type="submit"
          class="btn btn-primary btn-lg w-full px-4"
        >
          {connect.submit}
        </button>
      </form>
    ) : (
      <p class="border border-border bg-muted px-3 py-2.5 text-meta text-muted-foreground">
        {connect.disabled}
      </p>
    )
  }
</div>
