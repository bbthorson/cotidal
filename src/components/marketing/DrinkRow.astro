---
import type { CollectionEntry } from 'astro:content';
import type { Drink } from '../../lib/data';

interface Props {
  entry: CollectionEntry<'drinks'>;
  drink: Drink;
}

/** One drink in a list: title · leader · coordinate, the summary under it. */
const { entry, drink } = Astro.props;
const sign = (n: number) => (n > 0 ? `+${n}` : `${n}`);
---

<li class="menu-row">
  <a href={`/drinks/${entry.id}`} class="group block py-4">
    <span class="dot-leader">
      <span class="font-serif text-prose font-bold text-foreground transition-colors group-hover:underline group-hover:underline-offset-4">
        {entry.data.title}
      </span>
      <span class="leader" aria-hidden="true" />
      <span class="label-caps shrink-0 tabular-nums">{sign(drink.x)}, {sign(drink.y)}</span>
    </span>
    <p class="mt-1 max-w-xl text-meta leading-relaxed text-muted-foreground">{entry.data.summary}</p>
  </a>
</li>
