---
import Base from './Base.astro';
import SiteHeader from '../components/marketing/SiteHeader.astro';

interface Props {
  title?: string;
  description?: string;
  currentPath: string;
  eyebrow?: string;
  backLink?: { href: string; label: string };
  width?: 'prose' | 'standard' | 'wide';
}

const {
  title,
  description,
  currentPath,
  eyebrow,
  backLink,
  width = 'standard',
} = Astro.props;

const widthClass = {
  prose: 'max-w-2xl',
  standard: 'max-w-3xl',
  wide: 'max-w-4xl',
}[width];
---

<Base title={title} description={description}>
  <div class="bar-texture min-h-screen bg-background text-foreground">
    <div class:list={['mx-auto w-full px-6 py-10 md:py-14', widthClass]}>
      <SiteHeader currentPath={currentPath} eyebrow={eyebrow} backLink={backLink} />
      <slot />
    </div>
  </div>
</Base>
