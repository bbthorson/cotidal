---
import Base from './Base.astro';

interface Props {
  title?: string;
  description?: string;
  /** The share card (see Base.astro). */
  image?: { path: string; alt: string };
  /** The page's own address for search engines (`Base`'s `canonical`). */
  canonical?: string;
}

/**
 * The page's frame, and nothing else: every page is the map and its card
 * (`MapScreen`), whose top is the app bar and whose foot is the footer, so
 * the frame draws neither (docs/design-system.md, One kind of page). The same
 * for every page, the app screens too: on a phone the page scrolls and the
 * card scrolls up over the map; from `lg` it fills the window and the card
 * scrolls on its own.
 */
const { title, description, image, canonical } = Astro.props;
---

<Base title={title} description={description} image={image} canonical={canonical}>
  <div class="bar-texture flex min-h-dvh flex-col bg-background text-foreground lg:h-dvh lg:overflow-hidden">
    <div class="flex min-h-0 flex-1 flex-col">
      <slot />
    </div>
  </div>
</Base>
