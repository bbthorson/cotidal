---
import Base from './Base.astro';
import SiteHeader from '../components/marketing/SiteHeader.astro';
import SiteFooter from '../components/marketing/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
  currentPath: string;
  backLink?: { href: string; label: string };
  width?: 'prose' | 'standard' | 'wide';
}

const { title, description, currentPath, backLink, width = 'standard' } = Astro.props;

/**
 * The header and footer sit in one fixed band on every route; `width` sizes
 * only the content column between them. Applying it to the header as well
 * made the logo and nav jump sideways from page to page.
 */
const widthClass = {
  prose: 'max-w-2xl',
  standard: 'max-w-3xl',
  wide: 'max-w-4xl',
}[width];
---

<Base title={title} description={description}>
  <div class="bar-texture min-h-screen bg-background text-foreground">
    <div data-site-chrome class="mx-auto w-full max-w-5xl px-6 pt-5 md:pt-14">
      <SiteHeader currentPath={currentPath} />
    </div>

    <div class:list={['mx-auto w-full px-6', widthClass]}>
      {backLink && (
        <nav aria-label="Breadcrumb" class="pt-6">
          <a
            href={backLink.href}
            class="font-condensed text-xs uppercase tracking-label text-muted-foreground transition-colors hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
          >
            &larr; {backLink.label}
          </a>
        </nav>
      )}
      <slot />
    </div>

    <div data-site-chrome class="mx-auto w-full max-w-5xl px-6 pb-10 pt-16 md:pb-14">
      <SiteFooter currentPath={currentPath} />
    </div>
  </div>
</Base>
