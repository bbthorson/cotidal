---
import Base from './Base.astro';
import SiteHeader from '../components/marketing/SiteHeader.astro';
import SiteFooter from '../components/marketing/SiteFooter.astro';
import AppBar from '../components/marketing/AppBar.astro';
import PickButton from '../components/marketing/PickButton.astro';
import { accountFor } from '../lib/atproto/session';
import { a11y } from '../lib/copy';

interface Props {
  title?: string;
  description?: string;
  currentPath: string;
  backLink?: { href: string; label: string };
  width?: 'prose' | 'standard' | 'wide' | 'frame';
  /**
   * An app page (Radio, Compass, Log, the harbour): Radio · Compass · Log is pinned to
   * the bottom of a phone (`AppBar`). Below `lg` the
   * footer is left out there: it repeats the header's Menu, and with the bar
   * it was a screen of padding under the content. The content clears the bar.
   */
  bottomBar?: boolean;
}

const { title, description, currentPath, backLink, width = 'standard', bottomBar = false } = Astro.props;

// Read here once, so every route's header tells the truth about who is signed in.
const account = await accountFor(Astro.request, Astro.isPrerendered);

/**
 * The header and footer sit in one fixed band on every route; `width` sizes
 * only the content column between them. Applying it to the header as well
 * made the logo and nav jump sideways from page to page.
 */
const widthClass = {
  prose: 'max-w-2xl',
  standard: 'max-w-3xl',
  wide: 'max-w-4xl',
  // The header's own band: a screen laid out in columns on a wide screen.
  frame: 'max-w-5xl',
}[width];
---

<Base title={title} description={description}>
  <div class="bar-texture min-h-screen bg-background text-foreground">
    <div data-site-chrome class="mx-auto w-full max-w-5xl px-6 pt-5 md:pt-14">
      <SiteHeader currentPath={currentPath} account={account} appPage={bottomBar} />
    </div>

    <div class:list={['mx-auto w-full px-6', widthClass, bottomBar && 'pb-tabbar lg:pb-0']}>
      {backLink && (
        <nav aria-label={a11y.breadcrumb} class="pt-6">
          <a
            href={backLink.href}
            class="font-condensed text-label uppercase tracking-label text-muted-foreground transition-colors hover:text-foreground"
          >
            &larr; {backLink.label}
          </a>
        </nav>
      )}
      <slot />
      {/* Room to scroll the last of the content out from under "Pick a drink". */}
      {bottomBar && <div aria-hidden="true" class="h-16" />}
    </div>

    <div
      data-site-chrome
      class:list={['mx-auto w-full max-w-5xl px-6 pt-16 pb-10 md:pb-14', bottomBar && 'hidden lg:block']}
    >
      <SiteFooter currentPath={currentPath} />
    </div>

    {bottomBar && <AppBar currentPath={currentPath} />}
    {bottomBar && !currentPath.startsWith('/harbour') && <PickButton />}
  </div>
</Base>
