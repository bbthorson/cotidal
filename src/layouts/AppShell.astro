---
import Base from './Base.astro';
import SiteHeader from '../components/marketing/SiteHeader.astro';
import SiteFooter from '../components/marketing/SiteFooter.astro';
import { accountFor } from '../lib/atproto/session';
import { a11y } from '../lib/copy';

interface Props {
  title?: string;
  description?: string;
  /** The share card (see Base.astro). */
  image?: { path: string; alt: string };
  currentPath: string;
  backLink?: { href: string; label: string };
  width?: 'prose' | 'standard' | 'wide' | 'frame';
  /**
   * The app screen, the map: the header (with the search in it) and the
   * screen fill the window exactly, edge to edge, and nothing scrolls but the
   * screen's own card. No footer: the reading pages are in the header.
   */
  app?: boolean;
  /**
   * The header and the content fill the first screen exactly (100dvh, the
   * viewport less a phone browser's own bars), and the footer starts below
   * it. The front door uses it so its one action sits at the foot of the
   * first screen; the content lays itself out in the space with flex.
   */
  fill?: boolean;
  /**
   * A map page with no script (`MapPage.astro`): the header, then the map and
   * its card. On a phone the page scrolls, and the card scrolls up over the
   * map; from `lg` it fills the window like the app, and the card scrolls.
   * The footer is the card's foot.
   */
  map?: boolean;
  /** The search in the header: the map's alone (`app` pages only). */
  search?: boolean;
}

const { title, description, image, currentPath, backLink, width = 'standard', app = false, fill = false, map = false, search = false } = Astro.props;

// Read here once, so every route's header tells the truth about who is signed in.
const account = await accountFor(Astro.request, Astro.isPrerendered);

/**
 * The header and footer sit in one fixed band on every route; `width` sizes
 * only the content column between them. Applying it to the header as well
 * made the logo and nav jump sideways from page to page.
 */
const widthClass = {
  prose: 'max-w-2xl',
  standard: 'max-w-3xl',
  wide: 'max-w-4xl',
  // The header's own band: a screen laid out in columns on a wide screen.
  frame: 'max-w-5xl',
}[width];
---

<Base title={title} description={description} image={image}>
  {map ? (
    <div class="bar-texture flex min-h-dvh flex-col bg-background text-foreground lg:h-dvh lg:overflow-hidden">
      <div data-site-chrome class="mx-auto w-full max-w-5xl shrink-0 px-4 pt-3 md:px-6">
        <SiteHeader currentPath={currentPath} account={account} />
      </div>
      <div class="flex flex-1 flex-col lg:min-h-0">
        <slot />
      </div>
    </div>
  ) : app ? (
    <div class="bar-texture flex h-dvh flex-col overflow-hidden bg-background text-foreground">
      <div data-site-chrome class="mx-auto w-full max-w-5xl shrink-0 px-4 pt-3 md:px-6">
        <SiteHeader currentPath={currentPath} account={account} search={search} />
      </div>
      <div class="flex min-h-0 flex-1 flex-col">
        <slot />
      </div>
    </div>
  ) : (
  <div class:list={['bar-texture min-h-dvh bg-background text-foreground', fill && 'flex flex-col']}>
    <div data-site-chrome class:list={['mx-auto w-full max-w-5xl px-6', fill ? 'pt-4 md:pt-8' : 'pt-5 md:pt-14']}>
      <SiteHeader currentPath={currentPath} account={account} />
    </div>

    <div class:list={['mx-auto w-full px-6', widthClass, fill && 'flex flex-1 flex-col']}>
      {backLink && (
        <nav aria-label={a11y.breadcrumb} class="pt-6">
          <a
            href={backLink.href}
            class="font-condensed text-label uppercase tracking-label text-muted-foreground transition-colors hover:text-foreground"
          >
            &larr; {backLink.label}
          </a>
        </nav>
      )}
      <slot />
    </div>

    <div
      data-site-chrome
      class:list={[
        'mx-auto w-full max-w-5xl px-6',
        fill ? 'pt-3 pb-4 md:pt-4 md:pb-6' : 'pt-16 pb-10 md:pb-14',
      ]}
    >
      <SiteFooter currentPath={currentPath} compact={fill} account={account} />
    </div>
  </div>
  )}
</Base>
