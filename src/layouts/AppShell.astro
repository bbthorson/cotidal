---
import Base from './Base.astro';
import SiteHeader from '../components/marketing/SiteHeader.astro';
import SiteFooter from '../components/marketing/SiteFooter.astro';
import { accountFor } from '../lib/atproto/session';

interface Props {
  title?: string;
  description?: string;
  currentPath: string;
  backLink?: { href: string; label: string };
  width?: 'prose' | 'standard' | 'wide';
  /** The page pins a bar to the bottom of a phone (/taste): keep the footer clear of it. */
  bottomBar?: boolean;
}

const { title, description, currentPath, backLink, width = 'standard', bottomBar = false } = Astro.props;

// Read here once, so every route's header tells the truth about who is signed in.
const account = await accountFor(Astro.request, Astro.isPrerendered);

/**
 * The header and footer sit in one fixed band on every route; `width` sizes
 * only the content column between them. Applying it to the header as well
 * made the logo and nav jump sideways from page to page.
 */
const widthClass = {
  prose: 'max-w-2xl',
  standard: 'max-w-3xl',
  wide: 'max-w-4xl',
}[width];
---

<Base title={title} description={description}>
  <div class="bar-texture min-h-screen bg-background text-foreground">
    <div data-site-chrome class="mx-auto w-full max-w-5xl px-6 pt-5 md:pt-14">
      <SiteHeader currentPath={currentPath} account={account} />
    </div>

    <div class:list={['mx-auto w-full px-6', widthClass]}>
      {backLink && (
        <nav aria-label="Breadcrumb" class="pt-6">
          <a
            href={backLink.href}
            class="font-condensed text-xs uppercase tracking-label text-muted-foreground transition-colors hover:text-primary"
          >
            &larr; {backLink.label}
          </a>
        </nav>
      )}
      <slot />
    </div>

    <div
      data-site-chrome
      class:list={['mx-auto w-full max-w-5xl px-6 pt-16 md:pb-14', bottomBar ? 'pb-28 lg:pb-14' : 'pb-10']}
    >
      <SiteFooter currentPath={currentPath} />
    </div>
  </div>
</Base>
