---
import AppShell from './AppShell.astro';
import SiteFooter from '../components/marketing/SiteFooter.astro';
import AppBar from '../components/marketing/AppBar.astro';
import { CardHead, MapScreen } from '../components/app/MapScreen';
import { PalateMap } from '../components/app/PalateMap';
import { accountFor } from '../lib/atproto/session';
import { explore } from '../lib/copy';

interface Props {
  title?: string;
  description?: string;
  image?: { path: string; alt: string };
  currentPath: string;
  /** The card's accessible name. */
  label: string;
  /**
   * The card head's caps line: the name of the way in (docs/design-system.md,
   * rule 16). A page with a `head` slot of its own leaves it out.
   */
  eyebrow?: string;
  /** A way back, on the right of the card's head: `← All drinks`. */
  back?: { href: string; label: string };
  /** How much of a phone's first screen the card takes (`MapScreen`'s `rest`). */
  rest?: 'standard' | 'tall';
}

/**
 * Every page that is not an app screen: the map and a card, with no script
 * (docs/design-system.md, One kind of page). The same `MapScreen` that `/map`
 * draws, rendered on the server with no directive.
 *
 * Slots: `map` (a `PalateMap`; without one, the map with the tide turning
 * on it), `head` (a `CardHead`; without one, `eyebrow` and `back` make it),
 * and the card's body. The app bar (`AppBar`) is the card's top and the site
 * footer its foot: the map has the top of the screen to itself.
 */
const { title, description, image, currentPath, label, eyebrow, back, rest } = Astro.props;
const account = await accountFor(Astro.request, Astro.isPrerendered);
const hasMap = Astro.slots.has('map');
const hasHead = Astro.slots.has('head');
---

<AppShell title={title} description={description} image={image}>
  <MapScreen mode="static" label={label} rest={rest}>
    <AppBar slot="bar" currentPath={currentPath} account={account} />
    {hasMap ? <Fragment slot="map"><slot name="map" /></Fragment> : <PalateMap slot="map" label={explore.chartLabel} tide />}
    {
      hasHead ? (
        <Fragment slot="head"><slot name="head" /></Fragment>
      ) : (
        eyebrow && (
          <CardHead slot="head">
            <span class="label-caps">{eyebrow}</span>
            {back && (
              <a slot="action" href={back.href} class="link-caps shrink-0 text-secondary">
                &larr; {back.label}
              </a>
            )}
          </CardHead>
        )
      )
    }
    <div class="pt-4"><slot /></div>
    <div class="pt-12">
      <SiteFooter currentPath={currentPath} compact account={account} />
    </div>
  </MapScreen>
</AppShell>
