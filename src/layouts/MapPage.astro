---
import AppShell from './AppShell.astro';
import SiteFooter from '../components/marketing/SiteFooter.astro';
import { MapScreen } from '../components/app/MapScreen';
import { accountFor, type Account } from '../lib/atproto/session';

interface Props {
  title?: string;
  description?: string;
  image?: { path: string; alt: string };
  currentPath: string;
  /** The card's accessible name. */
  label: string;
  /** How much of a phone's first screen the card takes (`MapScreen`'s `rest`). */
  rest?: 'standard' | 'tall';
  /** Pass when the caller already resolved `accountFor`, so SSR pages read the session once. */
  account?: Account;
}

/**
 * A page that is the map and a card, with no script: a drink, the front
 * door. The same `MapScreen` that `/map` draws, rendered on the server with
 * no directive (docs/map-first.md, The map on every page).
 *
 * Slots: `map` (a `PalateMap`), `head` (a `CardHead`), and the card's body.
 * The site footer is the card's foot.
 */
const { title, description, image, currentPath, label, rest } = Astro.props;
const account = Astro.props.account ?? (await accountFor(Astro.request, Astro.isPrerendered));
---

<AppShell title={title} description={description} image={image} currentPath={currentPath} account={account} map>
  <MapScreen mode="static" label={label} rest={rest}>
    <Fragment slot="map"><slot name="map" /></Fragment>
    <Fragment slot="head"><slot name="head" /></Fragment>
    <slot />
    <div class="pt-12">
      <SiteFooter currentPath={currentPath} compact account={account} />
    </div>
  </MapScreen>
</AppShell>
