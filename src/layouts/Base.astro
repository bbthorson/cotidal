---
import '../styles/globals.css';
import { site, nav, share } from '../lib/copy';
import { SHARE_IMAGES, SHARE_SIZE } from '../lib/share';
import { MARK_COLOURS } from '../lib/mark';
import { DEFAULT_SITE_ORIGIN } from '../lib/pages/sitemap';

interface Props {
  title?: string;
  description?: string;
  /**
   * The share card a link to this page unfurls into: a path under
   * `public/share/` (`npm run images`). Defaults to the site's.
   */
  image?: { path: string; alt: string };
  /** Keep the page out of search: the share cards' own source pages. */
  noindex?: boolean;
  /**
   * The page's own address, for search engines: by default its path with no
   * parameters, since the parameters only change what the map draws
   * (`map-url.ts`); a page that answers at more than one path names its one.
   */
  canonical?: string;
}

const {
  title = site.name,
  description = site.description,
  image = { path: SHARE_IMAGES.site, alt: share.siteAlt },
  noindex = false,
  canonical,
} = Astro.props;

/**
 * A scraper wants an absolute image URL. A server-rendered page knows the
 * origin it was asked on; a prerendered page has no request, so it resolves
 * against the canonical production origin.
 */
const imageUrl = new URL(image.path, Astro.isPrerendered ? DEFAULT_SITE_ORIGIN : Astro.url).toString();
const canonicalPath = canonical ?? Astro.url.pathname;
const pageUrl = Astro.isPrerendered ? null : new URL(canonicalPath, Astro.url).toString();
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {pageUrl && <meta property="og:url" content={pageUrl} />}
    {!noindex && <link rel="canonical" href={pageUrl ?? canonicalPath} />}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={String(SHARE_SIZE.width)} />
    <meta property="og:image:height" content={String(SHARE_SIZE.height)} />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    {noindex && <meta name="robots" content="noindex" />}
    <!-- Generated from src/lib/mark.ts by `npm run images`. -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content={MARK_COLOURS.paper} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700&family=PT+Sans:wght@400;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="font-body antialiased bg-background text-foreground">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-5 focus:py-2.5 focus:bg-card focus:text-foreground focus:border focus:border-foreground focus:shadow-bar focus:rounded-sm label-caps font-bold text-foreground transition-all"
    >
      {nav.skipToContent}
    </a>
    <main id="main-content">
      <slot />
    </main>
  </body>
</html>
