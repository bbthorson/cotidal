{
  "lexicon": 1,
  "id": "app.crystalcoupe.drinkLog",
  "defs": {
    "main": {
      "type": "record",
      "description": "A log of a drink consumed or rated by a user, providing sensory feedback",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["drinkName", "hedonicScale", "createdAt"],
        "properties": {
          "drinkName": {
            "type": "string",
            "description": "Name of the drink"
          },
          "location": {
            "type": "string",
            "description": "Name of the location/bar where the drink was ordered",
            "maxLength": 100
          },
          "hedonicScale": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9,
            "description": "1: Dislike Extremely, 5: Neutral, 9: Like Extremely"
          },
          "deviations": {
            "type": "array",
            "items": {
              "type": "string",
              "knownValues": [
                "too-sweet", "not-sweet-enough",
                "too-sour", "not-sour-enough",
                "too-bitter", "too-smoky", "too-anise",
                "too-rich", "too-crisp",
                "too-flat", "too-fizzy"
              ]
            }
          },
          "note": {
            "type": "string",
            "description": "Optional text note or comment",
            "maxLength": 300
          },
          "palateShift": {
            "type": "object",
            "required": ["x", "y"],
            "properties": {
              "x": { "type": "number" },
              "y": { "type": "number" }
            }
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
