{
  "lexicon": 1,
  "id": "app.cotidal.palate",
  "defs": {
    "main": {
      "type": "record",
      "description": "A user's psychophysical palate profile and dynamic preference state from Cotidal. The AT Protocol data model has no floats, so every fractional quantity is an integer in hundredths, named for it (`xHundredths: -420` is −4.20). Records written before this encoding carried `mapCoordinates.x`/`y`, `latentVector`, `covarianceDiagonal` and `vibeTags` as floats, and records written before `vibeTagWeights` carried `vibeTagsHundredths` as an object and a `phenotypes` guess; readers accept all three, writers emit only this one.",
      "key": "literal:self",
      "record": {
        "type": "object",
        "required": [
          "mapCoordinates",
          "dynamicState",
          "aversions",
          "vibeTagWeights",
          "createdAt"
        ],
        "properties": {
          "mapCoordinates": {
            "type": "ref",
            "ref": "#mapCoordinates"
          },
          "dynamicState": {
            "type": "ref",
            "ref": "#dynamicState",
            "description": "Computed Extended Kalman Filter state vector and error covariance."
          },
          "aversions": {
            "type": "ref",
            "ref": "#aversions"
          },
          "vibeTagWeights": {
            "type": "array",
            "description": "Tag affinity from quiz answers and tasting history, one entry per tag.",
            "maxLength": 32,
            "items": {
              "type": "ref",
              "ref": "#vibeTagWeight"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "updatedAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    },
    "mapCoordinates": {
      "type": "object",
      "description": "Where the palate sits on the map, in hundredths.",
      "required": [
        "xHundredths",
        "yHundredths"
      ],
      "properties": {
        "xHundredths": {
          "type": "integer",
          "minimum": -1000,
          "maximum": 1000,
          "description": "Position on the Rich (−10) to Crisp (+10) axis, in hundredths."
        },
        "yHundredths": {
          "type": "integer",
          "minimum": -1000,
          "maximum": 1000,
          "description": "Position on the Savory (−10) to Sweet (+10) axis, in hundredths."
        }
      }
    },
    "aversions": {
      "type": "object",
      "description": "Hard filters: drinks with these never reach the menu.",
      "required": [
        "smoke",
        "bitter",
        "anise"
      ],
      "properties": {
        "smoke": {
          "type": "boolean"
        },
        "bitter": {
          "type": "boolean"
        },
        "anise": {
          "type": "boolean"
        }
      }
    },
    "dynamicState": {
      "type": "object",
      "required": [
        "latentVectorHundredths",
        "covarianceDiagonalHundredths",
        "eventCount"
      ],
      "properties": {
        "latentVectorHundredths": {
          "type": "array",
          "minLength": 5,
          "maxLength": 5,
          "items": {
            "type": "integer"
          },
          "description": "5-dimensional latent preference state, in hundredths: [x_crisp, y_sweet, theta_bitter, theta_tannin, theta_complexity]."
        },
        "covarianceDiagonalHundredths": {
          "type": "array",
          "minLength": 5,
          "maxLength": 5,
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "description": "Diagonal of the EKF error covariance P_k, in hundredths."
        },
        "eventCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Count of sequential tastings processed."
        },
        "lastUpdate": {
          "type": "string",
          "format": "datetime"
        }
      }
    },
    "vibeTagWeight": {
      "type": "object",
      "required": [
        "tag",
        "weightHundredths"
      ],
      "properties": {
        "tag": {
          "type": "string",
          "maxLength": 32,
          "knownValues": [
            "bold",
            "classic",
            "visual",
            "social",
            "comfort",
            "complex",
            "sweet",
            "messy",
            "polarizing",
            "prestige",
            "warm",
            "spice",
            "crushable"
          ]
        },
        "weightHundredths": {
          "type": "integer",
          "description": "Affinity for the tag, in hundredths."
        }
      }
    }
  }
}
