{
  "lexicon": 1,
  "id": "app.crystalcoupe.palate",
  "defs": {
    "main": {
      "type": "record",
      "description": "A user's psychophysical palate profile and dynamic preference state from The Crystal Coupe. The AT Protocol data model has no floats, so every fractional quantity is an integer in hundredths, named for it (`xHundredths: -420` is −4.20). Records written before this encoding carried `mapCoordinates.x`/`y`, `latentVector`, `covarianceDiagonal` and `vibeTags` as floats; readers accept both, writers emit only this one.",
      "key": "literal:self",
      "record": {
        "type": "object",
        "required": [
          "mapCoordinates",
          "dynamicState",
          "phenotypes",
          "aversions",
          "vibeTagsHundredths",
          "createdAt"
        ],
        "properties": {
          "mapCoordinates": {
            "type": "object",
            "required": [
              "xHundredths",
              "yHundredths"
            ],
            "properties": {
              "xHundredths": {
                "type": "integer",
                "minimum": -1000,
                "maximum": 1000,
                "description": "Position on the Rich (−10) to Crisp (+10) axis, in hundredths."
              },
              "yHundredths": {
                "type": "integer",
                "minimum": -1000,
                "maximum": 1000,
                "description": "Position on the Savory (−10) to Sweet (+10) axis, in hundredths."
              }
            }
          },
          "dynamicState": {
            "type": "ref",
            "ref": "#dynamicState",
            "description": "Computed Extended Kalman Filter state vector and error covariance."
          },
          "phenotypes": {
            "type": "ref",
            "ref": "#phenotypes",
            "description": "Physiological sensitivity proxies (TAS2R38, TRPV1)."
          },
          "aversions": {
            "type": "object",
            "required": [
              "smoke",
              "bitter",
              "anise"
            ],
            "properties": {
              "smoke": {
                "type": "boolean"
              },
              "bitter": {
                "type": "boolean"
              },
              "anise": {
                "type": "boolean"
              }
            }
          },
          "vibeTagsHundredths": {
            "type": "object",
            "description": "Tag affinity from quiz answers and tasting history: each key a vibe tag, each value an integer weight in hundredths."
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "updatedAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    },
    "dynamicState": {
      "type": "object",
      "required": [
        "latentVectorHundredths",
        "covarianceDiagonalHundredths",
        "eventCount"
      ],
      "properties": {
        "latentVectorHundredths": {
          "type": "array",
          "minLength": 5,
          "maxLength": 5,
          "items": {
            "type": "integer"
          },
          "description": "5-dimensional latent preference state, in hundredths: [x_crisp, y_sweet, theta_bitter, theta_tannin, theta_complexity]."
        },
        "covarianceDiagonalHundredths": {
          "type": "array",
          "minLength": 5,
          "maxLength": 5,
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "description": "Diagonal of the EKF error covariance P_k, in hundredths."
        },
        "eventCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Count of sequential tastings processed."
        },
        "lastUpdate": {
          "type": "string",
          "format": "datetime"
        }
      }
    },
    "phenotypes": {
      "type": "object",
      "properties": {
        "tas2r38BitterSensitivity": {
          "type": "string",
          "knownValues": [
            "non-taster",
            "medium-taster",
            "super-taster"
          ],
          "description": "Bitter receptor expression density behavioral proxy."
        },
        "trigeminalTolerance": {
          "type": "string",
          "knownValues": [
            "low",
            "moderate",
            "high"
          ],
          "description": "TRPV1 thermal / ethanol burn tolerance."
        }
      }
    }
  }
}
