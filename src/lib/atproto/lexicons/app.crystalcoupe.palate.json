{
  "lexicon": 1,
  "id": "app.crystalcoupe.palate",
  "defs": {
    "main": {
      "type": "record",
      "description": "A user's psychophysical palate profile and dynamic preference state from The Crystal Coupe",
      "key": "literal:self",
      "record": {
        "type": "object",
        "required": ["mapCoordinates", "dynamicState", "phenotypes", "aversions", "vibeTags", "createdAt"],
        "properties": {
          "mapCoordinates": {
            "type": "object",
            "required": ["x", "y"],
            "properties": {
              "x": {
                "type": "number",
                "description": "Position on Rich(-10) to Crisp(+10) axis",
                "minimum": -10,
                "maximum": 10
              },
              "y": {
                "type": "number",
                "description": "Position on Savory(-10) to Sweet(+10) axis",
                "minimum": -10,
                "maximum": 10
              }
            }
          },
          "dynamicState": {
            "type": "ref",
            "ref": "#dynamicState",
            "description": "Computed Extended Kalman Filter state vector and error covariance."
          },
          "phenotypes": {
            "type": "ref",
            "ref": "#phenotypes",
            "description": "Physiological sensitivity proxies (TAS2R38, TRPV1)."
          },
          "aversions": {
            "type": "object",
            "required": ["smoke", "bitter", "anise"],
            "properties": {
              "smoke": { "type": "boolean" },
              "bitter": { "type": "boolean" },
              "anise": { "type": "boolean" }
            }
          },
          "vibeTags": {
            "type": "object",
            "description": "Tag affinity scores from quiz responses and tasting history"
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "updatedAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    },
    "dynamicState": {
      "type": "object",
      "required": ["latentVector", "covarianceDiagonal", "eventCount"],
      "properties": {
        "latentVector": {
          "type": "array",
          "items": { "type": "number" },
          "description": "5-dimensional latent preference state: [x_crisp, y_sweet, theta_bitter, theta_tannin, theta_complexity]"
        },
        "covarianceDiagonal": {
          "type": "array",
          "items": { "type": "number" },
          "description": "Diagonal of EKF error covariance matrix P_k representing multidimensional uncertainty."
        },
        "eventCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Count of sequential tastings processed."
        },
        "lastUpdate": {
          "type": "string",
          "format": "datetime"
        }
      }
    },
    "phenotypes": {
      "type": "object",
      "properties": {
        "tas2r38BitterSensitivity": {
          "type": "string",
          "knownValues": ["non-taster", "medium-taster", "super-taster"],
          "description": "Bitter receptor expression density behavioral proxy."
        },
        "trigeminalTolerance": {
          "type": "string",
          "knownValues": ["low", "moderate", "high"],
          "description": "TRPV1 thermal / ethanol burn tolerance."
        }
      }
    }
  }
}
