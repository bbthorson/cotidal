{
  "lexicon": 1,
  "id": "app.crystalcoupe.palate",
  "defs": {
    "main": {
      "type": "record",
      "description": "A user's rich sensory palate profile from The Crystal Coupe",
      "key": "literal:self",
      "record": {
        "type": "object",
        "required": ["mapCoordinates", "sensoryVector", "aversions", "vibeTags", "createdAt"],
        "properties": {
          "mapCoordinates": {
            "type": "object",
            "required": ["x", "y"],
            "properties": {
              "x": {
                "type": "number",
                "description": "Position on Rich(-10) to Crisp(+10) axis",
                "minimum": -10,
                "maximum": 10
              },
              "y": {
                "type": "number",
                "description": "Position on Savory(-10) to Sweet(+10) axis",
                "minimum": -10,
                "maximum": 10
              }
            }
          },
          "sensoryVector": {
            "type": "object",
            "required": ["tastes", "aromas", "textures"],
            "properties": {
              "tastes": {
                "type": "object",
                "required": ["sweet", "sour", "salty", "bitter", "umami"],
                "properties": {
                  "sweet": { "type": "number", "minimum": 0, "maximum": 10 },
                  "sour": { "type": "number", "minimum": 0, "maximum": 10 },
                  "salty": { "type": "number", "minimum": 0, "maximum": 10 },
                  "bitter": { "type": "number", "minimum": 0, "maximum": 10 },
                  "umami": { "type": "number", "minimum": 0, "maximum": 10 }
                }
              },
              "aromas": {
                "type": "object",
                "required": ["smoky", "herbaceous", "spicy", "fruity", "floral"],
                "properties": {
                  "smoky": { "type": "number", "minimum": 0, "maximum": 10 },
                  "herbaceous": { "type": "number", "minimum": 0, "maximum": 10 },
                  "spicy": { "type": "number", "minimum": 0, "maximum": 10 },
                  "fruity": { "type": "number", "minimum": 0, "maximum": 10 },
                  "floral": { "type": "number", "minimum": 0, "maximum": 10 }
                }
              },
              "textures": {
                "type": "object",
                "required": ["body", "effervescence"],
                "properties": {
                  "body": { "type": "number", "minimum": 0, "maximum": 10, "description": "Viscosity/richness" },
                  "effervescence": { "type": "number", "minimum": 0, "maximum": 10, "description": "Carbonation" }
                }
              }
            }
          },
          "aversions": {
            "type": "object",
            "required": ["smoke", "bitter", "anise"],
            "properties": {
              "smoke": { "type": "boolean" },
              "bitter": { "type": "boolean" },
              "anise": { "type": "boolean" }
            }
          },
          "vibeTags": {
            "type": "object",
            "description": "Tag affinity scores from quiz responses"
          },
          "createdAt": {
            "type": "string",
            "format": "datetime"
          },
          "updatedAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
