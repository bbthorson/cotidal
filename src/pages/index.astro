---
import FrontDoor from '../components/site/FrontDoor.astro';
import AppScreen from '../components/site/AppScreen.astro';
import { accountFor } from '../lib/atproto/session';
import { readerHasTaste } from '../lib/device-presence';
import { readMapView, viewHref } from '../lib/map/map-url';
import { publicMapPath } from '../lib/atproto/paths';
import { FRONT_DOOR_PARAM } from '../lib/site-nav';

/**
 * The one address. `/` is the app (`AppScreen`, the one island), and the
 * front door (`FrontDoor`, no script) is its state for someone with nothing
 * on the map: no session, no coordinate on this device (its presence cookie,
 * `device-presence.ts`) and nothing asked of the map. Decided here, on the
 * server, so nothing flashes and a stranger's first page ships no JavaScript
 * (`tests/landing-static.spec.ts`, `tests/front-door.spec.ts`).
 *
 * `?about=1` (`frontDoorHref`) asks for the front door outright: How it works
 * is its card, pulled up.
 */
export const prerender = false;

const params = Astro.url.searchParams;
// Someone else's palate (`?palate=`, map-url.ts) is their public map, read-only and drawn on the
// server: the same page `/p/<handle>` is, at this address, with the drink it is about.
const view = readMapView(params);
if (view.palate) return Astro.rewrite(viewHref(publicMapPath(view.palate), { drink: view.drink, with: view.with }));

const account = await accountFor(Astro.request, false);
const hasTaste = readerHasTaste(account, Astro.request.headers.get('cookie'));
const frontDoor = params.has(FRONT_DOOR_PARAM) || (!hasTaste && params.size === 0);
---

{frontDoor ? <FrontDoor account={account} /> : <AppScreen account={account} />}
