---
import AppShell from '../layouts/AppShell.astro';
import ChartFigure from '../components/marketing/ChartFigure.astro';
import { hero } from '../lib/copy';
import { questionsHref } from '../lib/site-nav';

/**
 * The front door asks a stranger one thing: find your coordinate. The chart
 * (the one large move), the headline, one line, and the button with its cost.
 * Everything else has a page of its own — How it works, Drinks, Sign in —
 * and the footer and header carry them.
 *
 * Ships zero JavaScript: `tests/landing-static.spec.ts` fails if it does.
 */
---

<AppShell currentPath="/" width="standard">
  <section class="pb-14 pt-8 text-center md:pb-20 md:pt-14">
    <div class="mx-auto max-w-xs md:max-w-sm">
      <ChartFigure />
    </div>

    <h1 class="mx-auto mt-8 max-w-2xl font-serif text-hero font-bold text-foreground md:mt-12 md:text-hero-lg">
      {hero.headline}<br />
      <em class="font-normal italic text-primary">{hero.headlineAccent}</em>
    </h1>

    <p class="mx-auto mt-4.5 max-w-xs font-serif text-prose text-muted-foreground md:max-w-md md:text-plate">
      {hero.body}
    </p>

    <div class="mx-auto mt-8 flex max-w-sm flex-col items-center md:mt-10">
      <a href={questionsHref} class="btn btn-primary btn-lg w-full px-8">
        {hero.primaryCta}
      </a>
      <p class="mt-2.5 text-meta text-muted-foreground">{hero.cost}</p>
    </div>
  </section>
</AppShell>
