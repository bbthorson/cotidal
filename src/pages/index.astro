---
import Base from '../layouts/Base.astro';
import ConnectForm from '../components/marketing/ConnectForm.astro';
import QuadrantGrid from '../components/marketing/QuadrantGrid.astro';
import Principles from '../components/marketing/Principles.astro';
import Monogram from '../components/marketing/Monogram.astro';
import CoupeFigure from '../components/marketing/CoupeFigure.astro';
import { site, hero, connect, footer, drinks, sections } from '../lib/copy';

/**
 * The landing page ships zero JavaScript. Everything interactive lives at
 * /taste, which is where the React island is mounted. Sign-in is a plain
 * form post (see src/pages/api/auth/atproto/login.ts).
 *
 * Laid out as a printed menu — hairline rules, one section per idea, and the
 * coupe as the single large move. See docs/brand.md.
 */

const atprotoEnabled = !!(
  import.meta.env.PUBLIC_ATPROTO_ENABLED ?? import.meta.env.ATPROTO_ENABLED
);

const errorCodes: Record<string, string> = {
  not_configured: 'Sign-in is not configured right now.',
  invalid_handle: 'That handle does not look right. Try again.',
  invalid_request: 'Something went wrong with that request.',
  authorize_failed: 'We could not reach your provider. Try again.',
  atproto_not_configured: 'Sign-in is not configured right now.',
  atproto_callback_failed: 'Sign-in did not complete. Try again.',
};

const errorParam = Astro.url.searchParams.get('error');
const error = errorParam ? (errorCodes[errorParam] ?? errorCodes.authorize_failed) : null;
---

<Base>
  <div class="bar-texture min-h-screen bg-background text-foreground">
    <div class="mx-auto w-full max-w-3xl px-6 py-10 md:py-14">
      <!-- Header -->
      <header class="flex items-center justify-between border-b border-foreground pb-4">
        <div class="flex items-center gap-3">
          <Monogram class="h-9 w-9" />
          <span class="font-serif text-sm font-bold uppercase tracking-wordmark text-foreground">
            {site.name}
          </span>
        </div>
        <p class="label-caps">{hero.eyebrow}</p>
      </header>

      <!-- Hero. The deck sits above the figure so the coupe is the last beat
           before the call to action, rather than an interruption in the middle
           of the argument. -->
      <section class="pb-16 pt-14 text-center md:pb-20 md:pt-20">
        <h1
          class="mx-auto max-w-2xl font-serif text-4xl font-bold leading-display text-foreground md:text-6xl"
        >
          {hero.headline}<br />
          <em class="font-normal italic text-primary">{hero.headlineAccent}</em>
        </h1>

        <p
          class="mx-auto mt-7 max-w-md font-serif text-base leading-relaxed text-muted-foreground md:text-lg"
        >
          {hero.body}
        </p>

        <div class="mt-12 md:mt-14">
          <CoupeFigure />
        </div>

        <a
          href="/taste"
          class="mt-12 inline-flex items-center justify-center border border-foreground bg-secondary px-8 py-3.5 font-condensed text-xs font-bold uppercase tracking-label text-secondary-foreground transition-colors hover:bg-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
        >
          {hero.primaryCta}
        </a>
      </section>

      <!-- The map, as a menu -->
      <section class="pb-16 md:pb-20">
        <h2 class="label-caps border-b border-foreground pb-2 text-foreground">
          {sections.map}
        </h2>
        <p class="mb-5 mt-3 font-serif text-sm italic text-muted-foreground">
          {sections.mapNote}
        </p>
        <QuadrantGrid />
        <a
          href="/taste?browse=1"
          class="mt-5 inline-block font-serif text-xs italic text-muted-foreground underline underline-offset-4 transition-colors hover:text-primary"
        >
          {hero.secondaryCta}
        </a>
      </section>

      <!-- Sign in -->
      <section class="pb-16 md:pb-20">
        <h2 class="label-caps mb-5 border-b border-foreground pb-2 text-foreground">
          {sections.connect}
        </h2>
        <div class="coaster border border-border bg-card p-6 shadow-bar md:p-8">
          <h3 class="font-serif text-xl font-bold text-foreground">{connect.title}</h3>
          <p class="mt-2 max-w-md font-serif text-sm leading-relaxed text-muted-foreground">
            {connect.body}
          </p>
          <div class="mt-6 max-w-sm">
            <ConnectForm enabled={atprotoEnabled} error={error} />
          </div>
        </div>
      </section>

      <!-- Principles -->
      <section class="pb-16 md:pb-20">
        <h2 class="label-caps mb-5 border-b border-foreground pb-2 text-foreground">
          {sections.principles}
        </h2>
        <Principles />
      </section>

      <footer
        class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1 border-t border-foreground pt-5 text-center font-condensed text-3xs uppercase tracking-label text-muted-foreground"
      >
        <a href="/drinks" class="transition-colors hover:text-primary">{drinks.navLabel}</a>
        <span aria-hidden="true">·</span>
        <span>{footer.note}</span>
        <span aria-hidden="true">·</span>
        <span>{footer.drinkResponsibly}</span>
      </footer>
    </div>
  </div>
</Base>
