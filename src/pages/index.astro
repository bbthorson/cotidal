---
import AppShell from '../layouts/AppShell.astro';
import ConnectForm from '../components/marketing/ConnectForm.astro';
import QuadrantGrid from '../components/marketing/QuadrantGrid.astro';
import Principles from '../components/marketing/Principles.astro';
import ChartFigure from '../components/marketing/ChartFigure.astro';
import { hero, connect, drinks, sections } from '../lib/copy';
import { signInEnabled } from '../lib/atproto/auth';
import { AUTH_ERROR_MESSAGES, AUTH_ERROR_PARAM, isAuthErrorCode } from '@bbthorson/atproto-cf-auth/client';

/**
 * The landing page ships zero JavaScript. Everything interactive lives at
 * /taste, which is where the React island is mounted. Sign-in is a plain
 * form post (see src/pages/api/auth/atproto/[...route].ts).
 *
 * Laid out as a printed specimen and menu — hairline rules, one section per idea,
 * and the cotidal chart as the single large move. See docs/brand.md.
 */

// The server's runtime answer, the same one the login route acts on — not a
// build-time variable, which is what let the two disagree.
const atprotoEnabled = await signInEnabled();

// `auth_error` is what @bbthorson/atproto-cf-auth redirects back with, in the
// package's own words: the same ones the in-app sheet shows.
const errorParam = Astro.url.searchParams.get(AUTH_ERROR_PARAM);
const error = errorParam
  ? AUTH_ERROR_MESSAGES[isAuthErrorCode(errorParam) ? errorParam : 'authorize_failed']
  : null;
---

<AppShell currentPath="/" width="standard">
  <!-- Hero. One move (the chart) and one action. The deck sits above the
       figure so the chart is the last beat before the call to action. -->
  <section class="pb-14 pt-10 text-center md:pb-20 md:pt-16">
    <p class="label-caps mb-3.5">{hero.edition}</p>

    <h1
      class="mx-auto max-w-2xl font-serif text-hero font-bold text-foreground md:text-6xl md:leading-display"
    >
      {hero.headline}<br />
      <em class="font-normal italic text-primary">{hero.headlineAccent}</em>
    </h1>

    <p class="mx-auto mt-4.5 max-w-xs font-serif text-prose text-muted-foreground md:max-w-md md:text-lg">
      {hero.body}
    </p>

    <div class="mx-auto mt-7 max-w-xs md:mt-12 md:max-w-sm">
      <ChartFigure />
    </div>

    <div class="mx-auto mt-7 flex max-w-sm flex-col items-center md:mt-10">
      <a
        href="/taste"
        class="btn btn-primary btn-lg w-full px-8"
      >
        {hero.primaryCta}
      </a>
      <p class="mt-2.5 text-meta text-muted-foreground">{hero.cost}</p>
      <a
        href="#regions"
        class="mt-4 inline-flex min-h-11 items-center font-serif text-ui italic text-foreground underline decoration-primary underline-offset-4 transition-colors hover:text-primary"
      >
        {hero.readFirst}
      </a>
    </div>
  </section>

  <!-- The map, as a menu -->
  <section id="regions" class="scroll-mt-8 pb-16 md:pb-20">
    <div class="flex items-baseline justify-between border-b border-foreground pb-2">
      <h2 class="font-serif text-xl font-bold text-foreground">
        {sections.map}
      </h2>
      <span class="label-caps text-secondary">{sections.mapLabel}</span>
    </div>
    <p class="mb-4 mt-3 font-serif text-sm italic text-muted-foreground">
      {sections.mapNote}
    </p>
    <QuadrantGrid />
    <div class="mt-4 flex flex-wrap items-center justify-between gap-x-6">
      <a
        href="/taste?browse=1"
        class="inline-flex min-h-11 items-center font-serif text-sm italic text-muted-foreground underline underline-offset-4 transition-colors hover:text-primary"
      >
        {hero.secondaryCta}
      </a>
      <a
        href="/drinks"
        class="inline-flex min-h-11 items-center font-condensed text-xs uppercase tracking-label text-muted-foreground transition-colors hover:text-primary"
      >
        {drinks.navLabel} &rarr;
      </a>
    </div>
  </section>

  <!-- From the register: one sheet, one idea -->
  <section class="pb-16 md:pb-20">
    <div class="flex items-baseline justify-between border-b border-foreground pb-2">
      <h2 class="font-serif text-xl font-bold text-foreground">
        {sections.registerSpotlight}
      </h2>
      <span class="label-caps text-secondary">{sections.registerSpotlightLabel}</span>
    </div>
    <p class="mb-5 mt-3 font-serif text-sm italic text-muted-foreground">
      {sections.registerSpotlightNote}
    </p>
    <div class="border border-border bg-card p-5 shadow-bar md:p-8">
      <span class="label-caps block text-secondary">{sections.registerCardLabel}</span>
      <h3 class="mt-2 font-serif text-xl font-bold text-foreground">
        {drinks.title}
      </h3>
      <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
        {drinks.intro}
      </p>
      <a
        href="/drinks"
        class="btn btn-outline mt-4 px-5"
      >
        {hero.registerCta}
      </a>
    </div>
  </section>

  <!-- Sign in: the same promise as the in-app sheet -->
  <section id="connect" class="scroll-mt-8 pb-16 md:pb-20">
    <h2 class="label-caps mb-5 border-b border-foreground pb-2 text-foreground">
      {sections.connect}
    </h2>
    <div class="max-w-md">
      <h3 class="font-serif text-title font-bold text-foreground">{connect.title}</h3>
      <p class="mt-1 font-serif text-prose italic text-foreground">{connect.lede}</p>
      <p class="mt-2 font-serif text-prose text-muted-foreground">
        {connect.body}
      </p>
      <div class="mt-6">
        <ConnectForm enabled={atprotoEnabled} error={error} />
      </div>
    </div>
  </section>

  <!-- Principles -->
  <section>
    <h2 class="label-caps mb-5 border-b border-foreground pb-2 text-foreground">
      {sections.principles}
    </h2>
    <Principles />
  </section>
</AppShell>
