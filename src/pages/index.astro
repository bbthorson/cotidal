---
import AppShell from '../layouts/AppShell.astro';
import ConnectForm from '../components/marketing/ConnectForm.astro';
import QuadrantGrid from '../components/marketing/QuadrantGrid.astro';
import Principles from '../components/marketing/Principles.astro';
import CoupeFigure from '../components/marketing/CoupeFigure.astro';
import { hero, connect, drinks, sections } from '../lib/copy';

/**
 * The landing page ships zero JavaScript. Everything interactive lives at
 * /taste, which is where the React island is mounted. Sign-in is a plain
 * form post (see src/pages/api/auth/atproto/login.ts).
 *
 * Laid out as a printed specimen and menu — hairline rules, one section per idea,
 * and the coupe as the single large move. See docs/brand.md.
 */

const atprotoEnabled = !!(
  import.meta.env.PUBLIC_ATPROTO_ENABLED ?? import.meta.env.ATPROTO_ENABLED
);

const errorCodes: Record<string, string> = {
  not_configured: 'Sign-in is not configured right now.',
  invalid_handle: 'That handle does not look right. Try again.',
  invalid_request: 'Something went wrong with that request.',
  authorize_failed: 'We could not reach your provider. Try again.',
  atproto_not_configured: 'Sign-in is not configured right now.',
  atproto_callback_failed: 'Sign-in did not complete. Try again.',
};

const errorParam = Astro.url.searchParams.get('error');
const error = errorParam ? (errorCodes[errorParam] ?? errorCodes.authorize_failed) : null;
---

<AppShell currentPath="/" width="standard">
  <!-- Hero. The deck sits above the figure so the coupe is the last beat
           before the call to action, rather than an interruption in the middle
           of the argument. -->
      <section class="pb-16 pt-12 text-center md:pb-20 md:pt-16">
        <p class="label-caps mb-4 tracking-label text-muted-foreground">{hero.edition}</p>

        <h1
          class="mx-auto max-w-2xl font-serif text-4xl font-bold leading-display text-foreground md:text-6xl"
        >
          {hero.headline}<br />
          <em class="font-normal italic text-primary">{hero.headlineAccent}</em>
        </h1>

        <p
          class="mx-auto mt-6 max-w-md font-serif text-base leading-relaxed text-muted-foreground md:text-lg"
        >
          {hero.body}
        </p>

        <div class="mt-10 md:mt-12">
          <CoupeFigure />
        </div>

        <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
          <a
            href="/taste"
            class="inline-flex items-center justify-center border border-foreground bg-secondary px-8 py-3.5 font-condensed text-xs font-bold uppercase tracking-label text-secondary-foreground transition-colors hover:bg-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
          >
            {hero.primaryCta}
          </a>
          <a
            href="/drinks"
            class="inline-flex items-center justify-center border border-border bg-card px-6 py-3.5 font-condensed text-xs uppercase tracking-label text-foreground shadow-bar transition-colors hover:border-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
          >
            {hero.registerCta}
          </a>
        </div>
      </section>

      <!-- The map, as a menu -->
      <section id="regions" class="scroll-mt-8 pb-16 md:pb-20">
        <div class="flex items-baseline justify-between border-b border-foreground pb-2">
          <h2 class="font-serif text-xl font-bold text-foreground">
            {sections.map}
          </h2>
          <span class="label-caps text-secondary">Grid Index</span>
        </div>
        <p class="mb-5 mt-3 font-serif text-sm italic text-muted-foreground">
          {sections.mapNote}
        </p>
        <QuadrantGrid />
        <div class="mt-5 flex items-center justify-between">
          <a
            href="/taste?browse=1"
            class="inline-block font-serif text-xs italic text-muted-foreground underline underline-offset-4 transition-colors hover:text-primary"
          >
            {hero.secondaryCta}
          </a>
          <a
            href="/drinks"
            class="font-condensed text-xs uppercase tracking-label text-muted-foreground transition-colors hover:text-primary"
          >
            {drinks.navLabel} &rarr;
          </a>
        </div>
      </section>

      <!-- Field Notes / Register Spotlight -->
      <section class="pb-16 md:pb-20">
        <div class="flex items-baseline justify-between border-b border-foreground pb-2">
          <h2 class="font-serif text-xl font-bold text-foreground">
            {sections.registerSpotlight}
          </h2>
          <span class="label-caps text-secondary">Documented</span>
        </div>
        <p class="mb-5 mt-3 font-serif text-sm italic text-muted-foreground">
          {sections.registerSpotlightNote}
        </p>
        <div class="coaster border border-border bg-card p-6 shadow-bar md:p-8">
          <div class="flex flex-col gap-4 sm:flex-row sm:items-baseline sm:justify-between">
            <div>
              <span class="label-caps block text-secondary">Primary Source Discipline</span>
              <h3 class="mt-1 font-serif text-lg font-bold text-foreground md:text-xl">
                {drinks.title}
              </h3>
            </div>
            <a
              href="/drinks"
              class="font-condensed text-xs uppercase tracking-label text-primary transition-colors hover:underline"
            >
              Browse all &rarr;
            </a>
          </div>
          <p class="mt-3 font-serif text-sm leading-relaxed text-muted-foreground">
            {drinks.intro}
          </p>
        </div>
      </section>

      <!-- Sign in -->
      <section id="connect" class="scroll-mt-8 pb-16 md:pb-20">
        <h2 class="label-caps mb-5 border-b border-foreground pb-2 text-foreground">
          {sections.connect}
        </h2>
        <div class="coaster border border-border bg-card p-6 shadow-bar md:p-8">
          <h3 class="font-serif text-xl font-bold text-foreground">{connect.title}</h3>
          <p class="mt-2 max-w-md font-serif text-sm leading-relaxed text-muted-foreground">
            {connect.body}
          </p>
          <div class="mt-6 max-w-sm">
            <ConnectForm enabled={atprotoEnabled} error={error} />
          </div>
        </div>
      </section>

      <!-- Principles -->
      <section>
        <h2 class="label-caps mb-5 border-b border-foreground pb-2 text-foreground">
          {sections.principles}
        </h2>
        <Principles />
      </section>
</AppShell>
