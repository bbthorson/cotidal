---
import AppShell from '../layouts/AppShell.astro';
import ChartFigure from '../components/marketing/ChartFigure.astro';
import { hero } from '../lib/copy';
import { questionsHref } from '../lib/site-nav';

/**
 * The front door asks a stranger one thing: find your coordinate. The chart
 * (the one large move), the headline, one line, and the button with its cost.
 * Everything else has a page of its own — How it works, Drinks, Sign in —
 * and the footer and header carry them.
 *
 * Ships zero JavaScript: `tests/landing-static.spec.ts` fails if it does.
 */
---

<AppShell currentPath="/" width="standard" fill>
  <!-- The first screen, exactly: header, chart, words, one action, and footer all within 100dvh. -->
  <section class="flex flex-1 flex-col justify-center py-3 text-center md:py-4">
    <div class="my-auto">
      <div class="mx-auto w-44 sm:w-52 md:w-56">
        <ChartFigure />
      </div>

      <h1 class="mx-auto mt-4 max-w-2xl font-serif text-hero font-bold text-foreground md:mt-5 md:text-hero-lg">
        {hero.headline}<br />
        <em class="font-normal italic text-primary">{hero.headlineAccent}</em>
      </h1>

      <p class="mx-auto mt-2.5 max-w-xs font-serif text-prose text-muted-foreground md:mt-3 md:max-w-md md:text-plate">
        {hero.body}
      </p>

      <div class="mx-auto flex w-full max-w-sm flex-col items-center pt-4 md:pt-5">
        <a href={questionsHref} class="btn btn-primary btn-lg w-full px-8">
          {hero.primaryCta}
        </a>
        <p class="mt-2 text-meta text-muted-foreground">{hero.cost}</p>
      </div>
    </div>
  </section>
</AppShell>
