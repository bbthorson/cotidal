---
import AppShell from '../layouts/AppShell.astro';
import SiteHeader from '../components/marketing/SiteHeader.astro';
import Explore from '../components/app/Explore';
import { site, explore } from '../lib/copy';
import { loadRegister } from '../lib/register.server';
import { signInEnabled } from '../lib/atproto/auth';
import { accountFor } from '../lib/atproto/session';
import { mapHref } from '../lib/site-nav';

/**
 * The app, on one screen: your map fixed in place, the search in the header,
 * and one card for your menu, a bar's menu, a drink, rating a pour and your
 * pours. The server says whether the reader is a member, so the island knows
 * where their pours live without asking; `?q=` is the header's search, which
 * works before the island does.
 *
 * `client:load` (not `client:only`) so the shell server-renders and the page
 * has painted content before hydration finishes.
 */
export const prerender = false;

const register = await loadRegister();
const authEnabled = await signInEnabled();
const account = await accountFor(Astro.request, false);
const member = account.kind === 'member' ? { did: account.did, handle: account.handle } : null;
const initialQuery = Astro.url.searchParams.get('q') ?? '';
---

<AppShell title={`${site.name} — ${explore.title}`} currentPath={mapHref} app>
  <Explore client:load register={register} signInEnabled={authEnabled} member={member} initialQuery={initialQuery}>
    <SiteHeader slot="bar" currentPath={mapHref} account={account} search compact />
  </Explore>
</AppShell>
