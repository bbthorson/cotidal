---
import { getCollection, getEntry, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import AppShell from '../../layouts/AppShell.astro';
import PageTitle from '../../components/marketing/PageTitle.astro';
import OnTheRecord from '../../components/marketing/OnTheRecord.astro';
import { site, sections, quadrants, regionPage as copy, coaster } from '../../lib/copy';
import { regionCoasterPath } from '../../lib/coaster';
import { drinkDatabase } from '../../lib/data';
import { sharedIngredients } from '../../lib/ingredients';
import { QUADRANT_ORDER, quadrantIdFor, type QuadrantId } from '../../lib/quadrant';

/** Static, like `/drinks`. No island, no client JavaScript. */
export const prerender = true;

/** The ids are URLs, linked from `/`, `/drinks#<id>` and `/p/<handle>`. */
export const getStaticPaths = (() => QUADRANT_ORDER.map((id) => ({ params: { id } }))) satisfies GetStaticPaths;

const { id } = Astro.params as { id: QuadrantId };
const region = quadrants.find((q) => q.id === id)!;

/**
 * The prose, from `src/content/regions/<id>.md`. A region without an entry
 * still has a page — everything below the prose is derived — and
 * `tests/region-content.spec.ts` is what insists all four are written.
 */
const entry = await getEntry('regions', id);
const Content = entry ? (await render(entry)).Content : null;

/** Which drinks live here is the map's answer, never the entry's. */
const placed = (await getCollection('drinks'))
  .map((drinkEntry) => {
    const drink = drinkDatabase.find((d) => d.name === drinkEntry.data.name);
    return drink ? { entry: drinkEntry, drink } : null;
  })
  .filter((v): v is NonNullable<typeof v> => v !== null)
  .filter(({ drink }) => quadrantIdFor(drink.x, drink.y) === id)
  .sort((a, b) => a.entry.data.title.localeCompare(b.entry.data.title));

const shared = sharedIngredients(placed.map(({ entry }) => entry.data));
const others = quadrants.filter((q) => q.id !== id);
---

<AppShell
  title={`${region.name} · ${site.name}`}
  description={region.gloss}
  currentPath={`/regions/${region.id}`}
  backLink={{ href: '/#regions', label: copy.backLabel }}
  width="prose"
>
  <article>
    <PageTitle eyebrow={region.axis} title={region.name} lede={region.gloss} ruled />

    <!-- What the region is -->
    {
      Content && (
        <div class="prose-entry py-12">
          <Content />
        </div>
      )
    }

    <!-- What ordering from it says about you -->
    <section class="pb-12">
      <h2 class="section-title">
        {copy.orderingLabel}
      </h2>
      <p class="mt-4 font-serif text-ui leading-relaxed text-foreground">
        {copy.ordering(region.name, region.axis)}
      </p>
    </section>

    <!-- The drinks that live there -->
    <section class="pb-12">
      <div class="flex items-baseline justify-between gap-4 border-b border-foreground pb-1.5">
        <h2 class="font-serif text-heading font-bold text-foreground">{copy.drinksLabel}</h2>
        <a
          href={`/drinks#${region.id}`}
          class="label-caps text-muted-foreground transition-colors hover:text-foreground"
        >
          {sections.regionDrinks} &rarr;
        </a>
      </div>
      <ul class="border-b border-border">
        {
          placed.map(({ entry: drinkEntry, drink }) => (
            <li class="menu-row first:border-t-0">
              <a href={`/drinks/${drinkEntry.id}`} class="group block py-3">
                <span class="dot-leader">
                  <span class="font-serif text-prose font-bold text-foreground transition-colors group-hover:underline group-hover:underline-offset-4">
                    {drinkEntry.data.title}
                  </span>
                  <span class="leader" aria-hidden="true" />
                  <span class="label-caps shrink-0 tabular-nums">
                    {drink.x > 0 ? '+' : ''}
                    {drink.x}, {drink.y > 0 ? '+' : ''}
                    {drink.y}
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-3 font-serif text-ui italic leading-relaxed text-muted-foreground">
        {copy.placedNote}
      </p>
    </section>

    <!-- The ingredients they share -->
    {
      shared.length > 0 && (
        <section class="pb-12">
          <h2 class="section-title">
            {copy.sharedLabel}
          </h2>
          <ul class="border-b border-border">
            {shared.map((ingredient) => (
              <li class="menu-row dot-leader py-2.5 first:border-t-0">
                <span class="font-serif text-ui text-foreground">{ingredient.name}</span>
                <span class="leader" aria-hidden="true" />
                <span class="shrink-0 font-condensed text-ui tabular-nums text-secondary">
                  {copy.sharedCount(ingredient.count, placed.length)}
                </span>
              </li>
            ))}
          </ul>
          <p class="mt-3 font-serif text-ui italic leading-relaxed text-muted-foreground">
            {copy.sharedNote(placed.length)}
          </p>
        </section>
      )
    }

    {entry && <OnTheRecord {...entry.data} />}

    <p class="pb-10 text-center font-serif text-ui">
      <a href={regionCoasterPath(region.id)} class="text-foreground underline decoration-muted-foreground underline-offset-4 hover:decoration-foreground" data-testid="region-coaster-link">
        {coaster.regionLink}
      </a>
    </p>

    <!-- The other three -->
    <nav aria-label={copy.otherLabel} class="border-t border-foreground pt-10 pb-4">
      <p class="label-caps text-center">{copy.otherLabel}</p>
      <ul class="mt-4 border-b border-border">
        {
          others.map((other) => (
            <li class="menu-row first:border-t-0">
              <a href={`/regions/${other.id}`} class="group block py-3">
                <span class="dot-leader">
                  <span class="font-serif text-prose font-bold text-foreground transition-colors group-hover:underline group-hover:underline-offset-4">
                    {other.name}
                  </span>
                  <span class="leader" aria-hidden="true" />
                  <span class="label-caps shrink-0">{other.axis}</span>
                </span>
                <p class="mt-1 font-serif text-ui italic leading-relaxed text-muted-foreground">
                  {other.gloss}
                </p>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </article>
</AppShell>
