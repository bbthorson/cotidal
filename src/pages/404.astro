---
import MapPage from '../layouts/MapPage.astro';
import { ScreenHeader } from '../components/app/ui';
import { notFound as copy, site } from '../lib/copy';
import { questionsHref } from '../lib/site-nav';

/**
 * Any address that is not a page. Without this file the host answered with
 * Astro's own dark 404, the one screen that did not look like Cotidal.
 *
 * The map with the tide turning, and a way back in the card. Prerendered,
 * zero client JavaScript.
 */
export const prerender = true;
---

<MapPage title={`${site.name} — ${copy.title}`} currentPath="/404" label={copy.title}>
  <ScreenHeader title={copy.title} gloss={copy.lede} />
  <div class="space-y-4 pt-6 text-center">
    <a href={questionsHref} class="btn btn-primary btn-lg w-full">{copy.cta}</a>
    <a href="/drinks" class="link-serif inline-block text-ui">{copy.drinks}</a>
  </div>
</MapPage>
