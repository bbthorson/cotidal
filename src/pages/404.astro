---
import AppShell from '../layouts/AppShell.astro';
import PageTitle from '../components/marketing/PageTitle.astro';
import { notFound as copy, site } from '../lib/copy';
import { questionsHref } from '../lib/site-nav';

/**
 * Any address that is not a page. Without this file the host answered with
 * Astro's own dark 404, the one screen that did not look like Cotidal.
 *
 * Prerendered, zero client JavaScript, like the other reading pages.
 */
export const prerender = true;
---

<AppShell title={`${site.name} — ${copy.title}`} currentPath="/404" width="prose">
  <article class="space-y-8 py-12 text-center">
    <PageTitle title={copy.title} lede={copy.lede} />
    <div class="mx-auto max-w-sm space-y-4">
      <a href={questionsHref} class="btn btn-primary btn-lg w-full px-8">{copy.cta}</a>
      <a href="/drinks" class="link-serif inline-block text-ui">{copy.drinks}</a>
    </div>
  </article>
</AppShell>
