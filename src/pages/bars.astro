---
import AppShell from '../layouts/AppShell.astro';
import PageTitle from '../components/marketing/PageTitle.astro';
import { site, venuesCopy } from '../lib/copy';
import { exampleVenues } from '../lib/example-menus';

/**
 * The supply side: what a bar can do on the protocol today, and what is
 * still to come, said as "Later:" (docs/brand.md, Claims). Reasoning in
 * docs/venues.md and docs/routes.md.
 *
 * Statically rendered, zero client JavaScript.
 */
---

<AppShell
  title={`${site.name} — ${venuesCopy.eyebrow}`}
  currentPath="/bars"
  width="wide"
>
  <div class="space-y-16">
    <PageTitle eyebrow={venuesCopy.eyebrow} title={venuesCopy.title} lede={venuesCopy.subtitle} />

    {/* Ruled sections, not cards: a spec sheet reads down the page (docs/design-system.md, One sheet per screen). */}
    <section>
      <h2 class="section-title">{venuesCopy.todayTitle}</h2>
      <dl>
        {venuesCopy.today.map((item) => (
          <div class="menu-row flex flex-col gap-1.5 py-5 md:grid md:grid-cols-3 md:gap-8">
            <dt class="font-serif text-plate font-bold text-foreground">{item.title}</dt>
            <dd class="text-ui text-muted-foreground md:col-span-2">{item.description}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section>
      <h2 class="section-title">{venuesCopy.laterTitle}</h2>
      <ul>
        {venuesCopy.later.map((line) => (
          <li class="menu-row py-3 text-ui text-muted-foreground">{line}</li>
        ))}
      </ul>
    </section>

    <section>
      <h2 class="section-title">{venuesCopy.examplesTitle}</h2>
      <p class="mt-3 text-ui text-muted-foreground">{venuesCopy.examplesSubtitle}</p>

      <div class="mt-8 grid grid-cols-1 gap-x-8 gap-y-12 md:grid-cols-2 lg:grid-cols-3">
        {exampleVenues.map((venue) => (
          <article class="border-t border-foreground pt-3">
            <div class="flex items-baseline justify-between gap-3">
              <span class="label-caps">{venue.domain}</span>
              <span class="tag">{venuesCopy.exampleTag}</span>
            </div>
            <h3 class="mt-3 font-serif text-heading font-bold text-foreground">{venue.name}</h3>
            <p class="text-meta text-muted-foreground">{venue.neighborhood} · {venue.city}</p>
            <p class="mt-3 text-ui text-foreground">{venue.summary}</p>
            <p class="label-caps mt-5 text-secondary">{venuesCopy.examplesSpecs(venue.menu.length)}</p>
            <ul class="mt-1">
              {venue.menu.map((item) => (
                <li class="menu-row dot-leader py-2">
                  <span class="font-serif text-ui font-bold text-foreground">{item.name}</span>
                  <span aria-hidden="true" class="leader" />
                  <span class="shrink-0 font-condensed text-meta tabular-nums text-muted-foreground">
                    {item.x > 0 ? `+${item.x}` : item.x} · {item.y > 0 ? `+${item.y}` : item.y}
                  </span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>
  </div>
</AppShell>
