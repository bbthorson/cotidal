---
import AppShell from '../layouts/AppShell.astro';
import PageTitle from '../components/marketing/PageTitle.astro';
import { site, venuesCopy } from '../lib/copy';
import { exampleVenues } from '../lib/example-menus';

/**
 * The supply side: what a bar can do on the protocol today, and what is
 * still to come, said as "Later:" (docs/brand.md, Claims). Reasoning in
 * docs/venues.md and docs/routes.md.
 *
 * Statically rendered, zero client JavaScript.
 */
---

<AppShell
  title={`${site.name} — ${venuesCopy.eyebrow}`}
  currentPath="/bars"
  width="wide"
>
  <div class="space-y-16">
    <PageTitle eyebrow={venuesCopy.eyebrow} title={venuesCopy.title} lede={venuesCopy.subtitle} />

    <section class="space-y-6">
      <div class="border-b border-foreground pb-2">
        <h2 class="label-caps text-foreground">{venuesCopy.todayTitle}</h2>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {venuesCopy.today.map((item) => (
          <article class="coaster border border-border bg-card p-6">
            <h3 class="font-serif text-plate font-bold text-foreground mb-3">{item.title}</h3>
            <p class="font-serif text-ui leading-relaxed text-muted-foreground">{item.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="space-y-6">
      <div class="border-b border-foreground pb-2">
        <h2 class="label-caps text-foreground">{venuesCopy.laterTitle}</h2>
      </div>

      <ul class="space-y-3">
        {venuesCopy.later.map((line) => (
          <li class="font-serif text-ui leading-relaxed text-muted-foreground">{line}</li>
        ))}
      </ul>
    </section>

    <section class="space-y-6">
      <div class="border-b border-foreground pb-2">
        <h2 class="font-serif text-subtitle font-bold text-foreground">{venuesCopy.examplesTitle}</h2>
        <p class="font-serif text-meta text-muted-foreground mt-1">{venuesCopy.examplesSubtitle}</p>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {exampleVenues.map((venue) => (
          <article class="coaster border border-border bg-card p-6 space-y-4">
            <div class="flex items-center justify-between border-b border-border pb-2">
              <span class="font-condensed text-label uppercase tracking-label text-muted-foreground">{venue.domain}</span>
              <span class="tag">
                {venuesCopy.exampleTag}
              </span>
            </div>
            <div>
              <h3 class="font-serif text-heading font-bold text-foreground mb-1">{venue.name}</h3>
              <p class="font-serif text-label text-muted-foreground mb-3">{venue.neighborhood} · {venue.city}</p>
              <p class="font-serif text-label leading-relaxed text-foreground">{venue.summary}</p>
            </div>
            <div class="border-t border-border pt-3">
              <span class="label-caps text-secondary block mb-2">{venuesCopy.examplesSpecs(venue.menu.length)}</span>
              <ul class="space-y-1.5 font-serif text-label text-foreground">
                {venue.menu.map((item) => (
                  <li class="flex items-center justify-between">
                    <span class="font-medium">{item.name}</span>
                    <span class="font-condensed text-meta tabular-nums text-muted-foreground">[{item.x > 0 ? `+${item.x}` : item.x}, {item.y > 0 ? `+${item.y}` : item.y}]</span>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </section>
  </div>
</AppShell>
