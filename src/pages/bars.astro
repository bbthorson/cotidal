---
import MapPage from '../layouts/MapPage.astro';
import { Notice, ScreenHeader } from '../components/app/ui';
import { DrinkRow } from '../components/app/DrinkRow';
import { barPublish as copy, site, venuesCopy } from '../lib/copy';
import { formatCoordinate } from '../lib/map/coordinates';
import { exampleVenues } from '../lib/drinks/example-menus';
import { accountFor, oauthSession } from '../lib/atproto/session';
import { publishVenueAndMenu } from '../lib/atproto/venue-publish';
import { verifyVenueDomain } from '../lib/atproto/venue-verify';
import { barsHref, signIn } from '../lib/site-nav';

/**
 * The supply side, as one page: what a bar can do on the protocol, then
 * claiming one — the form for a signed-in bar account, a way to sign in for
 * anyone else — then what is on the protocol today and what is still to
 * come, said as "Later:" (docs/brand.md, Claims). Reasoning in
 * docs/venues.md and docs/routes.md.
 *
 * Claiming verifies that the bar's website URL resolves to the signed-in
 * account's DID before writing `app.cotidal.venue` at `rkey: self`. A plain
 * POST form to this page, so it ships no client JavaScript.
 */
export const prerender = false;

const account = await accountFor(Astro.request, false);

let error: string | null = null;
let values = { name: '', description: '', website: '', menuTitle: '', menuLines: '' };

if (Astro.request.method === 'POST' && account.kind === 'member') {
  const form = await Astro.request.formData();
  values = {
    name: String(form.get('name') ?? '').trim(),
    description: String(form.get('description') ?? '').trim(),
    website: String(form.get('website') ?? '').trim(),
    menuTitle: String(form.get('menuTitle') ?? '').trim(),
    menuLines: String(form.get('menuLines') ?? '').trim(),
  };

  if (!values.name) {
    error = copy.needName;
  } else if (!values.website) {
    error = copy.needWebsite;
  } else if (!/^https?:\/\//i.test(values.website)) {
    error = copy.invalidWebsite;
  } else {
    const check = await verifyVenueDomain(values.website, account.did, account.handle);
    if (!check.ok) {
      error =
        check.reason === 'invalid-url'
          ? copy.invalidWebsite
          : check.reason === 'unavailable'
            ? copy.domainCheckFailed
            : copy.domainMismatch(check.domain ?? values.website, account.did);
    } else {
      const session = await oauthSession(Astro.request);
      if (!session) return Astro.redirect(signIn.href, 303);
      try {
        await publishVenueAndMenu(session, values);
        return Astro.redirect(`/v/${encodeURIComponent(account.handle ?? account.did)}`, 303);
      } catch (e) {
        console.error('Could not publish venue:', e);
        error = copy.publishFailed;
      }
    }
  }
}

const actorLabel = account.kind === 'member' ? (account.handle ? `@${account.handle}` : account.did) : '';
Astro.response.headers.set('Cache-Control', account.kind === 'member' ? 'no-store' : 'public, max-age=60, s-maxage=300');
---

<MapPage title={`${site.name} — ${venuesCopy.eyebrow}`} currentPath={barsHref} label={venuesCopy.eyebrow} eyebrow={venuesCopy.eyebrow} account={account}>
  <div class="space-y-12">
    <ScreenHeader title={venuesCopy.title} gloss={venuesCopy.subtitle} />

    <section id="claim" class="scroll-mt-4 space-y-6" data-testid="claim">
      <h2 class="section-title">{venuesCopy.publishCta}</h2>
      <p class="text-meta text-muted-foreground">{copy.lede}</p>
      {
        account.kind === 'member' ? (
          <>
      <p class="text-meta text-muted-foreground">
        {copy.publishingAs} <span class="font-bold text-foreground">{actorLabel}</span>
      </p>

      {error && (
        <Notice tone="alert">{error}</Notice>
      )}

      <form method="POST" action={`${barsHref}#claim`} class="space-y-5">
        <label class="flex flex-col gap-1.5">
          <span class="label-caps">{copy.nameLabel}</span>
          <input
            name="name"
            value={values.name}
            placeholder={copy.namePlaceholder}
            required
            maxlength={200}
            class="field min-h-11"
          />
        </label>

        <label class="flex flex-col gap-1.5">
          <span class="label-caps">{copy.descriptionLabel}</span>
          <textarea
            name="description"
            placeholder={copy.descriptionPlaceholder}
            rows={2}
            maxlength={2000}
            class="field py-2.5"
          >{values.description}</textarea>
        </label>

        <label class="flex flex-col gap-1.5">
          <span class="label-caps">{copy.websiteLabel}</span>
          <input
            name="website"
            type="url"
            value={values.website}
            placeholder={copy.websitePlaceholder}
            required
            maxlength={500}
            class="field min-h-11"
          />
        </label>

        <label class="flex flex-col gap-1.5">
          <span class="label-caps">{copy.menuTitleLabel}</span>
          <input
            name="menuTitle"
            value={values.menuTitle}
            placeholder={copy.menuTitlePlaceholder}
            maxlength={200}
            class="field min-h-11"
          />
        </label>

        <label class="flex flex-col gap-1.5">
          <span class="label-caps">{copy.menuLinesLabel}</span>
          <textarea
            name="menuLines"
            placeholder={copy.menuLinesPlaceholder}
            rows={8}
            class="field py-2.5"
          >{values.menuLines}</textarea>
        </label>

        <button type="submit" class="btn btn-primary w-full">
          {copy.submit}
        </button>

        <p class="text-meta text-muted-foreground">{copy.postcardNote}</p>
      </form>
          </>
        ) : (
          <a href={signIn.href} class="btn btn-primary w-full">{copy.signInToClaim}</a>
        )
      }
    </section>

    {/* Ruled sections, not cards: a spec sheet reads down the page (docs/design-system.md, One sheet per screen). */}
    <section>
      <h2 class="section-title">{venuesCopy.todayTitle}</h2>
      <dl>
        {venuesCopy.today.map((item) => (
          <div class="menu-row flex flex-col gap-1.5 py-5">
            <dt class="font-serif text-plate font-bold text-foreground">{item.title}</dt>
            <dd class="text-ui text-muted-foreground">{item.description}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section>
      <h2 class="section-title">{venuesCopy.laterTitle}</h2>
      <ul>
        {venuesCopy.later.map((line) => (
          <li class="menu-row py-3 text-ui text-muted-foreground">{line}</li>
        ))}
      </ul>
    </section>

    <section>
      <h2 class="section-title">{venuesCopy.examplesTitle}</h2>
      <p class="mt-3 text-ui text-muted-foreground">{venuesCopy.examplesSubtitle}</p>

      <div class="mt-8 space-y-12">
        {exampleVenues.map((venue) => (
          <article class="border-t border-foreground pt-3">
            <div class="flex items-baseline justify-between gap-3">
              <span class="label-caps">{venue.domain}</span>
              <span class="tag">{venuesCopy.exampleTag}</span>
            </div>
            <h3 class="mt-3 font-serif text-plate font-bold text-foreground">{venue.name}</h3>
            <p class="text-meta text-muted-foreground">{venue.neighborhood} · {venue.city}</p>
            <p class="mt-3 text-ui text-foreground">{venue.summary}</p>
            <p class="label-caps mt-5 text-secondary">{venuesCopy.examplesSpecs(venue.menu.length)}</p>
            <ul class="mt-1 border-t border-border">
              {venue.menu.map((item) => (
                <DrinkRow title={item.name} figure={formatCoordinate(item.x, item.y)} />
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>
  </div>
</MapPage>
