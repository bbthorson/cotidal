---
import AppShell from '../layouts/AppShell.astro';
import PageTitle from '../components/marketing/PageTitle.astro';
import { site, venuesCopy } from '../lib/copy';

/**
 * The Supply Side: Venues and bars on the AT Protocol.
 *
 * Statically rendered, zero client JavaScript.
 * Explains the B2B proposition: handle-as-domain claim, canonical menu publishing,
 * palate density analytics, and recipe syndication.
 */
---

<AppShell
  title={`${site.name} — ${venuesCopy.eyebrow}`}
  currentPath="/bars"
  width="wide"
>
  <div class="space-y-16">
    <PageTitle eyebrow={venuesCopy.eyebrow} title={venuesCopy.title} lede={venuesCopy.subtitle} />

    <!-- Four Pillars Grid -->
    <section class="space-y-6">
      <div class="border-b border-foreground pb-2">
        <h2 class="label-caps text-foreground">The Four Pillars</h2>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {venuesCopy.pillars.map((pillar) => (
          <article class="coaster border border-border bg-card p-6 transition-all hover:border-primary">
            <span class="label-caps text-secondary block mb-2">{pillar.label}</span>
            <h3 class="font-serif text-xl font-bold text-foreground mb-3">
              {pillar.title}
            </h3>
            <p class="font-serif text-sm leading-relaxed text-muted-foreground">
              {pillar.description}
            </p>
          </article>
        ))}
      </div>
    </section>

    <!-- Domain Claim / Lookup Card -->
    <section class="border border-border bg-card p-8 coaster space-y-6">
      <div class="space-y-2">
        <span class="label-caps text-primary block">{venuesCopy.lookupEyebrow}</span>
        <h2 class="font-serif text-2xl font-bold text-foreground">
          {venuesCopy.lookupTitle}
        </h2>
        <p class="font-serif text-sm leading-relaxed text-foreground/80">
          {venuesCopy.lookupDescription}
        </p>
      </div>

      <div class="space-y-4 pt-2">
        <div class="flex flex-col sm:flex-row gap-3">
          <input
            type="text"
            placeholder={venuesCopy.domainPlaceholder}
            disabled
            class="flex-1 rounded-sm border border-border bg-background px-4 py-2.5 font-serif text-sm text-foreground placeholder:text-muted-foreground focus:border-primary focus:outline-none"
            aria-label="Venue domain"
          />
          <button
            type="button"
            disabled
            class="rounded-sm border border-foreground bg-primary px-5 py-2.5 font-condensed text-xs uppercase tracking-label text-primary-foreground opacity-90 cursor-not-allowed"
          >
            {venuesCopy.checkDomainCta}
          </button>
        </div>

        <div class="border-t border-border/60 pt-4">
          <p class="font-serif text-xs italic text-muted-foreground">
            {venuesCopy.earlyAccessNotice}
          </p>
        </div>
      </div>
    </section>
  </div>
</AppShell>
