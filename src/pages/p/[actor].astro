---
import MapPage from '../../layouts/MapPage.astro';
import { PalateMap } from '../../components/app/PalateMap';
import { Readout, ScreenHeader } from '../../components/app/ui';
import { DrinkRow } from '../../components/app/DrinkRow';
import { site, publicMap, coaster, assistants, explore, taste as taste_ } from '../../lib/copy';
import { formatCoordinate } from '../../lib/coordinate';
import { readPublicPalate } from '../../lib/atproto/public-read';
import { publicMapPath } from '../../lib/atproto/paths';
import { accountHref, questionsHref } from '../../lib/site-nav';
import { oauthSession } from '../../lib/atproto/session';
import { compareTerrains, TOP, type MapPoint } from '../../lib/overlap';
import { leanings, sampleTerrain } from '../../lib/terrain';
import { evidenceFor, menuOf, nearestHilltop, ratingsOf, terrainOf } from '../../lib/taste-reading';
import { readFollowedPalates, type FollowedOverlap } from '../../lib/atproto/follows-overlap';
import { loadRegister } from '../../lib/register.server';
import { titleOf } from '../../lib/register';
import type { Drink } from '../../lib/data';
import { readMapView, viewHref } from '../../lib/map-url';
import { wayTo } from '../../lib/drink-search';
import { mapHref } from '../../lib/site-nav';

/**
 * Someone's coordinate at a public URL: `/p/<handle>` or `/p/<did>`.
 *
 * The record is public in its author's repository, so the page needs no
 * permission to draw it — only the lookups in `public-read.ts`. A signed-in
 * visitor with a palate of their own gets their dot beside it and the
 * distance between: two dots, no feed, no follows (docs/routes.md, Friends).
 *
 * `/map?palate=<handle>` is this page at the map's address (`map-url.ts`),
 * and `?drink=` marks a drink on it and says how far and which way it lies
 * from them: `/map?palate=alice.bsky.social&drink=negroni`.
 *
 * Server-rendered with no island, like `/`: a link sent to a stranger paints
 * before anything could hydrate.
 */

export const prerender = false;

const result = await readPublicPalate(Astro.params.actor ?? '', { taste: true });
const { drink: viewDrink, with: withParam } = readMapView(Astro.url.searchParams);

const session = result.status === 'ok' ? await oauthSession(Astro.request) : null;
const isSelf = !!session && result.status === 'ok' && session.did === result.actor.did;

const subject: MapPoint | null =
  result.status === 'ok'
    ? { x: result.palate.x, y: result.palate.y, aversions: result.palate.aversions }
    : null;

/** A palate's ground, read as `/map` reads yours (`terrainOf`). */
const groundOf = (r: Awaited<ReturnType<typeof readPublicPalate>>) =>
  r.status === 'ok' ? terrainOf(r.taste?.start ?? null, r.palate, r.taste?.pours ?? []) : null;

// Whom to compare with (`with=`, map-url.ts): anyone named, or else a signed-in reader on someone else's map.
// Both are read the same way, from public records, so a comparison of two other people is a link too.
const otherActor = withParam ?? (session && !isSelf ? session.did : null);
const otherResult =
  subject && otherActor && result.status === 'ok' && otherActor !== result.actor.did && otherActor !== result.actor.handle
    ? await readPublicPalate(otherActor, { taste: true })
    : null;
const other = otherResult?.status === 'ok' ? otherResult : null;
const otherIsYou = !!session && !!other && other.actor.did === session.did;
const otherTerrain = other ? groundOf(other) : null;
const otherGround = otherTerrain ? sampleTerrain(otherTerrain, 0.5) : null;
/** A reader with no map of their own is asked to make one: a guest, or a member with no palate. */
const readerHasNoMap = !isSelf && (!session || (!withParam && !other));
/** How each side is named: "you" for the reader, a handle for anyone else. */
/** A made-up person (`sample-people.ts`): their page says so first, and stays out of search. */
const isSample = (result.status === 'ok' || result.status === 'no-palate') && result.actor.sample === true;
const subjectWho = isSelf ? publicMap.drinkFromYou : publicMap.title(result.status === 'ok' ? (result.actor.handle ?? result.actor.did) : '');
const otherWho = other ? (otherIsYou ? publicMap.drinkFromYou : publicMap.title(other.actor.handle ?? other.actor.did)) : '';

// On your own map: the people you follow who have one, to compare with.
// Read on the server inside a budget, so a slow follow graph shows fewer
// people rather than holding the page back.
const follows: FollowedOverlap[] =
  isSelf && session && subject && result.status === 'ok'
    ? await readFollowedPalates(session.did, { terrain: groundOf(result)!, aversions: subject.aversions }, { budgetMs: 2500 })
    : [];
const register = subject ? await loadRegister() : {};

// Their taste as ground, from their questions and pours (`public-taste.ts`); with
// neither on record, from their point, as `/map` does for a palate with no quiz.
const taste = result.status === 'ok' ? (result.taste ?? null) : null;
const terrain = groundOf(result);
const ground = terrain ? sampleTerrain(terrain, 0.5) : null;
const lean = terrain ? leanings(terrain, 2) : [];
const rated = ratingsOf(taste?.pours ?? []);
/** What put a drink where it stands on their ground: their ratings near it, or their answers. */
const reasonFor = (d: Drink) =>
  terrain
    ? publicMap.reason(
        evidenceFor(terrain, d).map((e) => ({ ...e, name: titleOf(register, e.name) })),
        rated.get(d.name)
      )
    : '';
const comparison =
  terrain && otherTerrain && other && subject
    ? compareTerrains({ terrain, aversions: subject.aversions }, { terrain: otherTerrain, aversions: other.palate.aversions })
    : null;
const menu = terrain && subject && !comparison ? menuOf(terrain, subject.aversions, rated) : [];
/** Which way a drink lies, measured from the nearest of their hilltops (docs/map-first.md). */
const nearestTop = (d: Drink) => (terrain && subject ? nearestHilltop(terrain, d, subject) : subject!);
const entryHref = (drink: Drink) => {
  const entry = register[drink.name];
  return entry ? `/drinks/${entry.slug}` : null;
};
const titleFor = (drink: Drink) => titleOf(register, drink.name);

const name =
  result.status === 'ok' || result.status === 'no-palate'
    ? (result.actor.handle ?? result.actor.did)
    : result.status === 'unavailable' && result.actor
      ? (result.actor.handle ?? result.actor.did)
      : null;


// Canonical by handle when it is verified; a DID link still works and
// is what the feed share uses, because a handle can change and a post cannot.
const selfLink =
  isSelf && result.status === 'ok'
    ? new URL(publicMapPath(result.actor.handle ?? result.actor.did), Astro.url).toString()
    : null;

if (result.status === 'invalid' || result.status === 'not-found') {
  Astro.response.status = 404;
} else if (result.status === 'no-palate') {
  Astro.response.status = 404;
} else if (result.status === 'unavailable') {
  Astro.response.status = 503;
  Astro.response.headers.set('Retry-After', '30');
}

// A page with the visitor's own dot on it is theirs alone; the bare map is
// the same for everyone and may be cached briefly at the edge.
Astro.response.headers.set(
  'Cache-Control',
  session ? 'private, no-store' : 'public, max-age=60, s-maxage=300'
);

const pageTitle = name ? `${publicMap.title(name)} · ${site.name}` : site.name;
// A person is described by their taste, not a region (docs/map-first.md), and unfurls into the site's card.
const description = name && lean.length > 0 ? publicMap.description(name, taste_.phrases(lean)) : site.description;
// One address for someone's map: by their verified handle, else their DID; `/map?palate=` and `/p/<did>` point here.
const canonical = result.status === 'ok' ? publicMapPath(result.actor.handle ?? result.actor.did) : undefined;

// Leading with disagreement (docs/routes.md, Friends): what each would reach for that the other would not, then one for both.
const pairs: { label: string; drink: Drink }[] = comparison
  ? [
      { label: publicMap.onlyLabel(subjectWho, otherWho), drink: comparison.firstOnly },
      { label: publicMap.onlyLabel(otherWho, subjectWho), drink: comparison.secondOnly },
      { label: publicMap.bothLabel, drink: comparison.shared },
    ].flatMap(({ label, drink }) => (drink ? [{ label, drink }] : []))
  : [];

// What a chat assistant reads is this map: on someone else's, what to ask
// yours about them. Setting one up is the member's own business, at /map.
const subjectHandle = result.status === 'ok' ? result.actor.handle : null;

const ctaClass =
  'btn btn-primary w-full';
---

<MapPage
  title={pageTitle}
  description={description}
  canonical={canonical}
  noindex={isSample}
  currentPath="/p"
  label={name ? publicMap.title(name) : site.name}
  eyebrow={isSelf ? publicMap.selfEyebrow : publicMap.eyebrow}
>
  <PalateMap
    slot="map"
    label={name && subject ? publicMap.plotLabel(publicMap.title(name)) : explore.chartLabel}
    ground={ground}
    ratings={rated}
    against={otherGround}
    selected={viewDrink?.name ?? null}
    named={menu.map((d) => d.name)}
    tide={!subject}
  />

  {
    isSample && (
      <p role="note" class="mb-6 border-b border-foreground pb-2.5 text-meta text-muted-foreground" data-testid="sample-note">
        {publicMap.sampleNote}
      </p>
    )
  }
  {result.status === 'ok' && subject && name ? (
    <article class="space-y-10" data-testid="public-map">
      <ScreenHeader title={publicMap.title(name)}>
        {lean.length > 0 && (
          <p class="mt-2" data-testid="leanings">
            <span class="label-caps">{publicMap.leanLabel(isSelf)} </span>
            <span class="font-serif text-ui italic text-primary">{taste_.phrases(lean)}</span>
          </p>
        )}
      </ScreenHeader>

      {viewDrink && (
        <section class="border-y border-foreground py-4" data-testid="palate-drink">
          <p class="label-caps">{publicMap.drinkLabel}</p>
          {entryHref(viewDrink) ? (
            <a href={entryHref(viewDrink)!} class="mt-1 block font-serif text-plate font-bold text-foreground hover:underline hover:underline-offset-4">
              {titleFor(viewDrink)}
            </a>
          ) : (
            <p class="mt-1 font-serif text-plate font-bold text-foreground">{titleFor(viewDrink)}</p>
          )}
          <p class="mt-1 text-meta text-muted-foreground">{reasonFor(viewDrink)}</p>
          <p class="mt-1 text-meta text-muted-foreground">
            {publicMap.drinkWay(isSelf ? publicMap.drinkFromYou : publicMap.title(name), wayTo(nearestTop(viewDrink), viewDrink).distance, wayTo(nearestTop(viewDrink), viewDrink).words)}
          </p>
          {!isSelf && (
            <a href={viewHref(mapHref, { drink: viewDrink })} class="btn btn-outline mt-4 px-4">
              {publicMap.drinkForYou}
            </a>
          )}
        </section>
      )}

      <Readout
        cells={[
          { label: isSelf ? publicMap.you : publicMap.them, value: formatCoordinate(subject.x, subject.y), figure: true },
          { label: publicMap.poursLabel, value: result.palate.pours ? String(result.palate.pours) : publicMap.quizOnly, figure: true },
        ]}
      />

      {comparison && (
        <section class="space-y-4" data-testid="overlap">
          <div>
            <span class="label-caps text-muted-foreground">{publicMap.betweenLabel(subjectWho, otherWho)}</span>
            <p class="mt-1 font-serif text-plate font-bold text-foreground">{publicMap.inCommon(comparison.inCommon, TOP)}</p>
            <p class="mt-1 text-meta text-muted-foreground">{publicMap.compareKey(otherWho, otherIsYou)}</p>
          </div>
          <ul class="border-t border-foreground">
            {pairs.map(({ label, drink }) => (
              <DrinkRow href={entryHref(drink) ?? undefined} title={titleFor(drink)} note={label} />
            ))}
          </ul>
        </section>
      )}

      {menu.length > 0 && (
        <section class="space-y-3" data-testid="their-menu">
          <h2 class="section-title">{publicMap.menuLabel(isSelf)}</h2>
          <ol>
            {menu.map((drink) => (
              <DrinkRow href={entryHref(drink) ?? undefined} title={titleFor(drink)} note={reasonFor(drink)} />
            ))}
          </ol>
        </section>
      )}

      {isSelf && selfLink && (
        <section class="space-y-2 border-t border-foreground pt-4">
          <p class="font-serif text-ui italic text-foreground">{publicMap.selfNote}</p>
          <label class="block">
            <span class="label-caps text-muted-foreground">{publicMap.linkLabel}</span>
            <input
              type="text"
              readonly
              value={selfLink}
              class="mt-1 w-full rounded-sm border border-border bg-card p-2.5 font-condensed text-meta text-foreground focus:border-primary focus:outline-none"
            />
          </label>
          <p class="pt-2 font-serif text-ui text-muted-foreground">
            <a href={`${accountHref}#code`} class="link-inline" data-testid="make-code">
              {coaster.findIt}
            </a>
          </p>
        </section>
      )}

      {isSelf && (
        <section id="compare" class="scroll-mt-4 space-y-3" data-testid="compare">
          <h2 class="section-title">{publicMap.compareTitle}</h2>
          {follows.length > 0 && (
            <>
              <p class="text-meta text-muted-foreground">{publicMap.followsLede}</p>
              <ul class="border-t border-border">
                {follows.map((f) => (
                  <DrinkRow
                    href={f.path}
                    title={`@${f.handle}`}
                    figure={publicMap.inCommon(f.inCommon, TOP)}
                    note={
                      <>
                        {f.leans}
                        {f.theirs && <> · {publicMap.followsContrast(titleOf(register, f.theirs))}</>}
                      </>
                    }
                  />
                ))}
              </ul>
            </>
          )}
          <form method="GET" action="/p" class="flex flex-col gap-2 pt-1">
            <label for="compare-handle" class="text-meta text-muted-foreground">{publicMap.compareHint}</label>
            <div class="flex gap-2">
              <input
                id="compare-handle"
                name="handle"
                required
                placeholder={publicMap.comparePlaceholder}
                aria-label={publicMap.compareLabel}
                autocomplete="off"
                autocapitalize="none"
                autocorrect="off"
                spellcheck="false"
                inputmode="url"
                class="field min-h-11 flex-1"
              />
              <button type="submit" class="btn btn-outline shrink-0 px-4">{publicMap.compareSubmit}</button>
            </div>
          </form>
        </section>
      )}

      {!isSelf && subjectHandle && (
        <p class="font-serif text-ui italic text-muted-foreground" data-testid="assistant-ask">
          {assistants.visitorAsk(subjectHandle)}{' '}
          <a href="/mcp" class="not-italic link-inline">
            {assistants.setUp}
          </a>
        </p>
      )}

      {readerHasNoMap && (
        <section class="space-y-3" data-testid="public-map-cta">
          <h2 class="font-serif text-plate font-bold text-foreground">{publicMap.guestTitle}</h2>
          <p class="text-ui text-muted-foreground">
            {session ? publicMap.memberNoPalateBody : publicMap.guestBody}
          </p>
          <a href={questionsHref} class={ctaClass}>{publicMap.guestCta}</a>
        </section>
      )}
    </article>
  ) : (
    <article class="space-y-8" data-testid="public-map-empty">
      <ScreenHeader
        title={
          result.status === 'no-palate'
            ? publicMap.noPalateTitle
            : result.status === 'unavailable'
              ? publicMap.unavailableTitle
              : publicMap.notFoundTitle
        }
        gloss={
          result.status === 'no-palate'
            ? publicMap.noPalateBody
            : result.status === 'unavailable'
              ? publicMap.unavailableBody
              : publicMap.notFoundBody
        }
      />
      <a href={questionsHref} class={ctaClass}>{publicMap.guestCta}</a>
    </article>
  )}
</MapPage>
