---
import MapPage from '../../layouts/MapPage.astro';
import { PalateMap } from '../../components/app/PalateMap';
import { PourLedger } from '../../components/app/PourLedger';
import { TrackFigure } from '../../components/app/TrackFigure';
import { Readout, ScreenHeader, SectionTitle } from '../../components/app/ui';
import { DrinkRow } from '../../components/app/DrinkRow';
import { site, publicMap, coaster, assistants, explore, mapPage, taste as taste_ } from '../../lib/copy';
import { formatCoordinate } from '../../lib/map/coordinates';
import { accountHref, mapHref, questionsHref } from '../../lib/site-nav';
import { TOP } from '../../lib/palate/overlap';
import { compareWith } from '../../lib/palate/compare';
import { Comparison } from '../../components/app/Comparison';
import { viewHref } from '../../lib/map/map-url';
import { loadPublicMapPage } from '../../lib/pages/public-map.server';

/**
 * Someone's coordinate at a public URL: `/p/<handle>` or `/p/<did>`.
 * Server-rendered with no island, like `/`: a link sent to a stranger paints
 * before anything could hydrate. Data loading lives in `public-map.server.ts`.
 */
export const prerender = false;

const {
  result,
  viewDrink,
  session,
  isSelf,
  subject,
  otherIsYou,
  otherGround,
  readerHasNoMap,
  isSample,
  subjectWho,
  otherWho,
  subjectWhose,
  follows,
  register,
  selfPours,
  selfTrack,
  selfStats,
  ground,
  lean,
  rated,
  reasonFor,
  subjectSide,
  comparison,
  menu,
  compared,
  entryHref,
  titleFor,
  titleOfName,
  name,
  selfLink,
  httpStatus,
  cacheControl,
  pageTitle,
  description,
  canonical,
  subjectHandle,
} = await loadPublicMapPage(Astro.params.actor ?? '', Astro.url, Astro.request);

if (httpStatus !== 200) {
  Astro.response.status = httpStatus;
  if (httpStatus === 503) Astro.response.headers.set('Retry-After', '30');
}
Astro.response.headers.set('Cache-Control', cacheControl);

const ctaClass = 'btn btn-primary w-full';
---

<MapPage
  title={pageTitle}
  description={description}
  canonical={canonical}
  noindex={isSample}
  currentPath="/p"
  label={name ? publicMap.title(name) : site.name}
  eyebrow={isSelf ? publicMap.selfEyebrow : publicMap.eyebrow}
  asksForCoordinate
>
  <PalateMap
    slot="map"
    label={name && subject ? publicMap.plotLabel(publicMap.title(name)) : explore.chartLabel}
    ground={ground}
    ratings={rated}
    against={otherGround}
    selected={viewDrink?.name ?? null}
    focus={compared ? new Set(compared.map((d) => d.name)) : null}
    named={(compared ?? menu).map((d) => d.name)}
    tide={!subject}
  />

  {
    isSample && (
      <p role="note" class="mb-6 border-b border-foreground pb-2.5 text-meta text-muted-foreground" data-testid="sample-note">
        {publicMap.sampleNote}
      </p>
    )
  }
  {result.status === 'ok' && subject && name ? (
    <article class="space-y-10" data-testid="public-map">
      <ScreenHeader title={publicMap.title(name)}>
        {lean.length > 0 && (
          <p class="mt-2" data-testid="leanings">
            <span class="label-caps">{publicMap.leanLabel(isSelf)} </span>
            <span class="font-serif text-ui italic text-primary">{taste_.phrases(lean)}</span>
          </p>
        )}
      </ScreenHeader>

      {viewDrink && (
        <section class="border-y border-foreground py-4" data-testid="palate-drink">
          <p class="label-caps">{publicMap.drinkLabel}</p>
          {entryHref(viewDrink) ? (
            <a href={entryHref(viewDrink)!} class="mt-1 block font-serif text-plate font-bold text-foreground hover:underline hover:underline-offset-4">
              {titleFor(viewDrink)}
            </a>
          ) : (
            <p class="mt-1 font-serif text-plate font-bold text-foreground">{titleFor(viewDrink)}</p>
          )}
          {subjectSide && (
            <Comparison
              comparison={compareWith(subjectSide, { kind: 'drink', drink: viewDrink })}
              whose={subjectWhose}
              who={subjectWho}
              reason={reasonFor(viewDrink)}
            />
          )}
          {!isSelf && (
            <a href={viewHref(mapHref, { drink: viewDrink })} class="btn btn-outline mt-4 px-4">
              {publicMap.drinkForYou}
            </a>
          )}
        </section>
      )}

      {isSelf && (
        <section id="yours" class="scroll-mt-4" data-testid="self-pours">
          <SectionTitle>{explore.yoursTitle}</SectionTitle>
          {selfStats.length > 0 && <Readout className="border-t-0" cells={selfStats.map((st) => ({ ...st, figure: true }))} />}
          {selfTrack && selfTrack.length > 1 && (
            <div class="mt-4 flex flex-col gap-2">
              <p class="label-caps">{mapPage.upClose}</p>
              <TrackFigure track={selfTrack} />
            </div>
          )}
          {selfPours.length > 0 && <SectionTitle as="h3" className="mt-6">{mapPage.ledgerTitle}</SectionTitle>}
          <PourLedger
            pours={selfPours}
            register={register}
            empty={mapPage.ledgerEmpty}
            track={selfTrack}
            startLabel={mapPage.started}
          />
        </section>
      )}

      <Readout
        cells={[
          { label: isSelf ? publicMap.you : publicMap.them, value: formatCoordinate(subject.x, subject.y), figure: true },
          { label: publicMap.poursLabel, value: result.palate.pours ? String(result.palate.pours) : publicMap.quizOnly, figure: true },
        ]}
      />

      {comparison && (
        <section class="space-y-4" data-testid="overlap">
          <p class="text-meta text-muted-foreground">{publicMap.compareKey(otherWho, otherIsYou)}</p>
          <Comparison
            comparison={comparison}
            whose={subjectWhose}
            who={subjectWho}
            other={otherWho}
            pair={(drink) => ({ title: titleFor(drink), href: entryHref(drink) ?? undefined })}
            name={titleOfName}
          />
        </section>
      )}

      {menu.length > 0 && (
        <section class="space-y-3" data-testid="their-menu">
          <h2 class="section-title">{publicMap.menuLabel(isSelf)}</h2>
          <ol>
            {menu.map((drink) => (
              <DrinkRow href={entryHref(drink) ?? undefined} title={titleFor(drink)} note={reasonFor(drink)} />
            ))}
          </ol>
        </section>
      )}

      {isSelf && selfLink && (
        <section class="space-y-2 border-t border-foreground pt-4">
          <p class="font-serif text-ui italic text-foreground">{publicMap.selfNote}</p>
          <label class="block">
            <span class="label-caps text-muted-foreground">{publicMap.linkLabel}</span>
            <input
              type="text"
              readonly
              value={selfLink}
              class="mt-1 w-full rounded-sm border border-border bg-card p-2.5 font-condensed text-meta text-foreground focus:border-primary focus:outline-none"
            />
          </label>
          <p class="pt-2 font-serif text-ui text-muted-foreground">
            <a href={`${accountHref}#code`} class="link-inline" data-testid="make-code">
              {coaster.findIt}
            </a>
          </p>
        </section>
      )}

      {isSelf && (
        <section id="compare" class="scroll-mt-4 space-y-3" data-testid="compare">
          <h2 class="section-title">{publicMap.compareTitle}</h2>
          {follows.length > 0 && (
            <>
              <p class="text-meta text-muted-foreground">{publicMap.followsLede}</p>
              <ul class="border-t border-border">
                {follows.map((f) => (
                  <DrinkRow
                    href={f.path}
                    title={`@${f.handle}`}
                    figure={publicMap.inCommon(f.inCommon, TOP)}
                    note={
                      <>
                        {f.leans}
                        {f.theirs && <> · {publicMap.followsContrast(titleOfName(f.theirs))}</>}
                      </>
                    }
                  />
                ))}
              </ul>
            </>
          )}
          <form method="GET" action="/p" class="flex flex-col gap-2 pt-1">
            <label for="compare-handle" class="text-meta text-muted-foreground">{publicMap.compareHint}</label>
            <div class="flex gap-2">
              <input
                id="compare-handle"
                name="handle"
                required
                placeholder={publicMap.comparePlaceholder}
                aria-label={publicMap.compareLabel}
                autocomplete="off"
                autocapitalize="none"
                autocorrect="off"
                spellcheck="false"
                inputmode="url"
                class="field min-h-11 flex-1"
              />
              <button type="submit" class="btn btn-outline shrink-0 px-4">{publicMap.compareSubmit}</button>
            </div>
          </form>
        </section>
      )}

      {!isSelf && subjectHandle && (
        <p class="font-serif text-ui italic text-muted-foreground" data-testid="assistant-ask">
          {assistants.visitorAsk(subjectHandle)}{' '}
          <a href="/mcp" class="not-italic link-inline">
            {assistants.setUp}
          </a>
        </p>
      )}

      {readerHasNoMap && (
        <section class="space-y-3" data-testid="public-map-cta">
          <h2 class="font-serif text-plate font-bold text-foreground">{publicMap.guestTitle}</h2>
          <p class="text-ui text-muted-foreground">
            {session ? publicMap.memberNoPalateBody : publicMap.guestBody}
          </p>
          <a href={questionsHref} class={ctaClass}>{publicMap.guestCta}</a>
        </section>
      )}
    </article>
  ) : (
    <article class="space-y-8" data-testid="public-map-empty">
      <ScreenHeader
        title={
          result.status === 'no-palate'
            ? publicMap.noPalateTitle
            : result.status === 'unavailable'
              ? publicMap.unavailableTitle
              : publicMap.notFoundTitle
        }
        gloss={
          result.status === 'no-palate'
            ? publicMap.noPalateBody
            : result.status === 'unavailable'
              ? publicMap.unavailableBody
              : publicMap.notFoundBody
        }
      />
      <a href={questionsHref} class={ctaClass}>{publicMap.guestCta}</a>
    </article>
  )}
</MapPage>
