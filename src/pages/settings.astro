---
import MapPage from '../layouts/MapPage.astro';
import { PalateMap } from '../components/app/PalateMap';
import { MapCode } from '../components/app/MapCode';
import { Notice } from '../components/app/ui';
import { account as accountCopy, coaster, explore, publicMap, settings as copy, site } from '../lib/copy';
import { accountFor } from '../lib/atproto/session';
import { AUTH_BASE_PATH, startOverPath } from '../lib/atproto/paths';
import { accountHref, signIn } from '../lib/site-nav';
import { handleSettingsPost, loadSettingsPage } from '../lib/pages/settings.server';

/**
 * A member's account, on their map, as rows in the card. Server-rendered with
 * plain form posts, so it ships no JavaScript. Form handling and data loading
 * live in `src/lib/pages/settings.server.ts`.
 */
export const prerender = false;

const account = await accountFor(Astro.request, false);
if (account.kind !== 'member') return Astro.redirect(signIn.href, 303);

if (Astro.request.method === 'POST') {
  return Astro.redirect(await handleSettingsPost(Astro.request, Astro.url, account), 303);
}

const {
  assistantsEnabled,
  assistants,
  listFailed,
  assistantNotice,
  mapNotice,
  ground,
  rated,
  codeHref,
  qr,
  name,
  mapHref,
} = await loadSettingsPage(Astro.url, account);

const date = (d: Date) => d.toLocaleDateString('en', { year: 'numeric', month: 'long', day: 'numeric' });
const link = 'link-inline';
// One row: what it is, a line about it, and its action on the right.
const row = 'flex items-center justify-between gap-4 border-b border-border py-4';
const rowTitle = 'text-ui font-bold text-foreground';
const rowBody = 'mt-0.5 text-meta text-muted-foreground';
Astro.response.headers.set('Cache-Control', 'no-store');
---

<MapPage title={`${site.name} — ${copy.title}`} currentPath={accountHref} label={copy.title} eyebrow={copy.title} heading account={account}>
  {
    ground ? (
      <PalateMap slot="map" label={publicMap.plotLabel(name)} ground={ground} ratings={rated} />
    ) : (
      <PalateMap slot="map" label={explore.chartLabel} tide />
    )
  }
  <div class="space-y-10">

    <section data-testid="settings-account" class="border-y border-foreground py-4">
      <div class="flex items-center justify-between gap-4">
        <div class="min-w-0">
          <p class="label-caps">{copy.signedInAs}</p>
          <p class="mt-1 truncate font-serif text-plate font-bold text-foreground">{name}</p>
        </div>
        <form method="POST" action={`${AUTH_BASE_PATH}/logout`} class="shrink-0">
          <button type="submit" class="btn btn-outline px-4">{copy.signOut}</button>
        </form>
      </div>
      <p class="mt-3 text-meta text-muted-foreground">{copy.signOutNote}</p>
    </section>

    <section id="map" class="scroll-mt-4" data-testid="settings-map">
      <h2 class="section-title">{copy.mapTitle}</h2>
      {
        mapNotice && (
          <Notice tone={mapNotice.error ? 'alert' : 'status'} className="mt-3">{mapNotice.text}</Notice>
        )
      }
      <div class={row}>
        <div class="min-w-0">
          <p class={rowTitle}>{copy.publicMap}</p>
          <p class={rowBody}>{copy.publicMapBody}</p>
        </div>
        <a href={mapHref} class="btn btn-outline shrink-0 px-4">{copy.open}</a>
      </div>
      <form method="POST" action={accountHref} class={row}>
        <input type="hidden" name="intent" value="share" />
        <div class="min-w-0">
          <p class={rowTitle}>{copy.share}</p>
          <p class={rowBody}>{copy.shareBody}</p>
        </div>
        <button type="submit" class="btn btn-outline shrink-0 px-4">{copy.shareCta}</button>
      </form>
    </section>

    <section id="code" class="scroll-mt-4" data-testid="settings-code">
      <h2 class="section-title">{coaster.memberTitle}</h2>
      <p class="text-meta text-muted-foreground">{coaster.memberLede}</p>
      <div class="mt-4">
        <MapCode href={codeHref} label={coaster.memberLabel(name)} ground={ground} qr={qr} />
      </div>
      <p class="mt-3 text-meta text-muted-foreground">{coaster.printNote}</p>
    </section>

    <section id="assistants" class="scroll-mt-4" data-testid="settings-assistants">
      <h2 class="section-title">{copy.assistantsTitle}</h2>

      {
        assistantNotice && (
          <p role="status" class="border-b border-border py-2.5 text-meta text-foreground">
            {assistantNotice}
          </p>
        )
      }

      {
        !assistantsEnabled ? (
          <p class="border-b border-border py-4 text-ui text-muted-foreground">
            {copy.assistantsOff} <a href="/mcp" class={link}>{copy.howToSetUp}</a>
          </p>
        ) : listFailed ? (
          <Notice tone="alert" className="mt-3">{copy.disconnectFailed}</Notice>
        ) : (
          <>
            <p class="pt-3 text-meta text-muted-foreground">{copy.assistantsLede}</p>
            {assistants && assistants.length > 0 ? (
              <ul>
                {assistants.map((a) => (
                  <li class={row}>
                    <div class="min-w-0 space-y-0.5">
                      <p class={rowTitle}>{a.name ?? copy.unnamed}</p>
                      <p class="text-meta text-muted-foreground">
                        {a.domain ? copy.verified(a.domain) : copy.unverified}
                        {a.redirectHost && <> · {copy.sendsTo(a.redirectHost)}</>}
                      </p>
                      <p class="text-meta text-muted-foreground">
                        {a.canLog ? copy.canLog : copy.canRead} · {copy.connectedOn(date(a.connectedAt))}
                      </p>
                    </div>
                    <form method="POST" action={accountHref} class="shrink-0">
                      <input type="hidden" name="intent" value="disconnect" />
                      <input type="hidden" name="grant" value={a.grantId} />
                      <button type="submit" class="btn btn-outline px-4">
                        {copy.disconnect}
                      </button>
                    </form>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="border-b border-border py-4 text-ui text-muted-foreground">
                {copy.assistantsNone} <a href="/mcp" class={link}>{copy.howToConnect}</a>
              </p>
            )}
          </>
        )
      }
    </section>

    <section data-testid="settings-coordinate">
      <h2 class="section-title">{accountCopy.startOver}</h2>
      <details class="group border-b border-border py-4">
        <summary class="summary-plain flex cursor-pointer items-center justify-between gap-4">
          <span class="text-meta text-muted-foreground">{accountCopy.startOverBody}</span>
          <span class="btn btn-outline shrink-0 px-4 group-open:hidden">{accountCopy.startOver}</span>
        </summary>
        <div class="flex flex-wrap items-center gap-x-5 gap-y-2 pt-3">
          <a href={startOverPath} class="btn btn-primary px-4">{accountCopy.startOverCta}</a>
        </div>
      </details>
    </section>
  </div>
</MapPage>
