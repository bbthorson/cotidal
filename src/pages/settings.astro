---
import AppShell from '../layouts/AppShell.astro';
import PageTitle from '../components/marketing/PageTitle.astro';
import { settings as copy, site } from '../lib/copy';
import { accountFor } from '../lib/atproto/session';
import { AUTH_BASE_PATH, publicMapPath } from '../lib/atproto/paths';
import { authorizeContext } from '../lib/mcp/authorize-context.server';
import { disconnectAssistant, listAssistants, type ConnectedAssistant } from '../lib/settings/assistants.server';

/**
 * A member's account as one page: who they are signed in as, the chat
 * assistants they have let act as them (src/lib/settings/assistants.server.ts),
 * and signing out. Server-rendered with plain form posts, so it ships no
 * JavaScript.
 *
 * Who is asking comes from the session cookie and nothing else: a Disconnect
 * names only a grant id, and grants are stored under the member, so another
 * member's id revokes nothing. Astro refuses cross-site form posts
 * (`security.checkOrigin`), and the session cookie is `SameSite=Lax`.
 */
export const prerender = false;

const account = await accountFor(Astro.request, false);
if (account.kind !== 'member') return Astro.redirect('/sign-in', 303);

const context = await authorizeContext(Astro.url);

if (Astro.request.method === 'POST') {
  let outcome = 'disconnected';
  try {
    const form = await Astro.request.formData();
    if (!context) throw new Error('Assistants are off here');
    await disconnectAssistant(context.oauth, account.did, String(form.get('grant') ?? ''));
  } catch (e) {
    console.error('Could not disconnect an assistant:', e);
    outcome = 'failed';
  }
  // Post, then redirect: a reload must not post again.
  return Astro.redirect(`/settings?${outcome}=1#assistants`, 303);
}

let assistants: ConnectedAssistant[] | null = null;
let listFailed = false;
if (context) {
  try {
    assistants = await listAssistants(context.oauth, account.did);
  } catch (e) {
    console.error('Could not list connected assistants:', e);
    listFailed = true;
  }
}

const notice = Astro.url.searchParams.has('disconnected')
  ? copy.disconnected
  : Astro.url.searchParams.has('failed')
    ? copy.disconnectFailed
    : null;
const date = (d: Date) => d.toLocaleDateString('en', { year: 'numeric', month: 'long', day: 'numeric' });
const name = account.handle ? `@${account.handle}` : account.did;
const label = 'font-condensed text-label uppercase tracking-label text-muted-foreground';
const link = 'text-foreground underline decoration-muted-foreground underline-offset-4 hover:decoration-foreground';
Astro.response.headers.set('Cache-Control', 'no-store');
---

<AppShell title={`${site.name} — ${copy.title}`} currentPath="/settings" width="prose">
  <div class="space-y-12 pb-6">
    <PageTitle eyebrow={copy.eyebrow} title={copy.title} />

    <section class="space-y-2" data-testid="settings-account">
      <p class={label}>{copy.signedInAs}</p>
      <p class="font-serif text-plate font-bold text-foreground">{name}</p>
      <a href={publicMapPath(account.handle ?? account.did)} class:list={['text-ui', link]}>{copy.publicMap}</a>
    </section>

    <section id="assistants" class="scroll-mt-4 space-y-4" data-testid="settings-assistants">
      <h2 class="section-title">{copy.assistantsTitle}</h2>

      {
        notice && (
          <p role="status" class="border-y border-border py-2.5 text-meta text-foreground">
            {notice}
          </p>
        )
      }

      {
        !context ? (
          <p class="text-ui text-muted-foreground">
            {copy.assistantsOff} <a href="/mcp" class={link}>{copy.howToConnect}</a>
          </p>
        ) : listFailed ? (
          <p role="alert" class="text-meta text-destructive">
            {copy.disconnectFailed}
          </p>
        ) : (
          <>
            <p class="text-ui text-muted-foreground">{copy.assistantsLede}</p>
            {assistants && assistants.length > 0 ? (
              <ul class="border-t border-foreground">
                {assistants.map((a) => (
                  <li class="flex flex-col gap-3 border-b border-border py-4 sm:flex-row sm:items-start sm:justify-between">
                    <div class="min-w-0 space-y-1">
                      <p class="text-ui font-bold text-foreground">{a.name ?? copy.unnamed}</p>
                      <p class="text-meta text-muted-foreground">
                        {a.domain ? copy.verified(a.domain) : copy.unverified}
                        {a.redirectHost && <> · {copy.sendsTo(a.redirectHost)}</>}
                      </p>
                      <p class="text-meta text-muted-foreground">
                        {a.canLog ? copy.canLog : copy.canRead} · {copy.connectedOn(date(a.connectedAt))}
                      </p>
                    </div>
                    <form method="POST" action="/settings" class="shrink-0">
                      <input type="hidden" name="grant" value={a.grantId} />
                      <button type="submit" class="btn btn-outline px-4">
                        {copy.disconnect}
                      </button>
                    </form>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="border-y border-border py-3 text-ui text-muted-foreground">
                {copy.assistantsNone} <a href="/mcp" class={link}>{copy.howToConnect}</a>
              </p>
            )}
          </>
        )
      }
    </section>

    <section class="space-y-3">
      <h2 class="section-title">{copy.signOutTitle}</h2>
      <p class="text-ui text-muted-foreground">{copy.signOutBody}</p>
      <form method="POST" action={`${AUTH_BASE_PATH}/logout`}>
        <button type="submit" class="btn btn-outline px-4">{copy.signOutTitle}</button>
      </form>
    </section>
  </div>
</AppShell>
