---
import Base from '../../layouts/Base.astro';
import Monogram from '../../components/marketing/Monogram.astro';
import ChartFigure from '../../components/marketing/ChartFigure.astro';
import { site, hero, quadrants } from '../../lib/copy';
import { SHARE_CARDS, type ShareCard } from '../../lib/share';

/**
 * A share card's source: what a link unfurls into, drawn with the site's own
 * components and tokens, then captured to `public/share/<card>.png` by
 * `npm run images`. Laid out at 600×315 and captured at 2×, so the type
 * scale is the site's own. Not linked from anywhere, and kept out of search.
 */

export const prerender = true;

export function getStaticPaths() {
  return SHARE_CARDS.map((card) => ({ params: { card } }));
}

const card = Astro.params.card as ShareCard;
const region = card === 'site' ? null : quadrants.find((q) => q.id === card)!;
// The gloss's first sentence: three words a reader recognises at a glance.
const lede = region ? region.gloss.split('. ')[0] + '.' : null;
---

<Base title={region ? `${region.name} · ${site.name}` : site.name} noindex>
  <div
    class="bar-texture flex h-screen w-screen items-center gap-4 overflow-hidden bg-background px-8 text-foreground"
    data-share-card={card}
  >
    <div class="flex h-full min-w-0 flex-1 flex-col justify-between py-8">
      <div class="flex items-center gap-2">
        <Monogram class="h-6 w-6" />
        <span class="font-serif text-ui font-bold uppercase tracking-wordmark">{site.name}</span>
      </div>

      {
        region ? (
          <div>
            <span class="font-condensed text-label uppercase tracking-label text-secondary">{region.axis}</span>
            <p class="mt-1 font-serif text-hero font-bold">{region.name}</p>
            <p class="mt-2 font-serif text-prose italic text-muted-foreground">{lede}</p>
          </div>
        ) : (
          <p class="font-serif text-display font-bold">
            {hero.headline}
            <br />
            <em class="font-normal italic text-primary">{hero.headlineAccent}</em>
          </p>
        )
      }

      <span class="font-condensed text-label uppercase tracking-label text-muted-foreground">
        {region ? site.tagline : site.description}
      </span>
    </div>

    <div class="w-56 shrink-0">
      <ChartFigure region={region?.id} dot={!region} />
    </div>
  </div>
</Base>
