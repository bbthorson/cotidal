---
import MapPage from '../layouts/MapPage.astro';
import { PalateMap } from '../components/app/PalateMap';
import { ScreenHeader } from '../components/app/ui';
import { explore, howItWorks as copy, site } from '../lib/copy';
import { questionsHref } from '../lib/site-nav';

/**
 * How the questions place a coordinate and ratings move it, and where each
 * is kept: the public account of belief-state.ts and palate-state.ts, said as
 * they work today (docs/brand.md, Claims). The numbers in the copy are held
 * to the code's constants by tests/unit/how-it-works.test.ts.
 *
 * On the map like every reading page that explains it (`MapPage`): the tide
 * turning behind, the account in the card. Prerendered, zero client
 * JavaScript.
 */
---

<MapPage title={`${site.name} — ${copy.eyebrow}`} currentPath="/how-it-works" label={copy.eyebrow} eyebrow={copy.eyebrow}>
  <PalateMap slot="map" label={explore.chartLabel} tide />

  <ScreenHeader title={copy.title} gloss={copy.lede} />
  <div class="space-y-10 pt-8">
    {copy.sections.map((section) => (
      <section id={section.id} class="scroll-mt-8 space-y-3">
        <h2 class="section-title">{section.title}</h2>
        {section.paragraphs.map((paragraph) => (
          <p class="text-ui text-foreground">{paragraph}</p>
        ))}
      </section>
    ))}

    <section class="space-y-3">
      <h2 class="section-title">{copy.laterTitle}</h2>
      <ul>
        {copy.later.map((line) => (
          <li class="menu-row py-3 text-ui text-muted-foreground">{line}</li>
        ))}
      </ul>
    </section>

    <a href={questionsHref} class="btn btn-primary btn-lg w-full">
      {copy.start}
    </a>
  </div>
</MapPage>
