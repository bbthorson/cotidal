---
import AppShell from '../layouts/AppShell.astro';
import Rate from '../components/app/Rate';
import { site, ratePage } from '../lib/copy';
import { loadRegister } from '../lib/register.server';
import { signInEnabled } from '../lib/atproto/auth';
import { parseDraft } from '../lib/pour-draft';
import { accountFor } from '../lib/atproto/session';

/**
 * Rating one pour. It opens on the drink it was handed ("Log this" on a map,
 * `?drink=`), on a pick from the harbour or a pour drafted in a chat
 * (`draft_pour` on /mcp, `?draft=1`, src/lib/pour-draft.ts), and on the drink
 * closest to you when it was handed nothing. Links to the old /log address
 * with these queries arrive here (log.astro).
 */
export const prerender = false;

const register = await loadRegister();
const authEnabled = await signInEnabled();
const initialDrink = Astro.url.searchParams.get('drink')?.trim().slice(0, 200) || undefined;
const initialDraft = parseDraft(Astro.url.searchParams) ?? undefined;
const account = await accountFor(Astro.request, false);
const member = account.kind === 'member' ? { handle: account.handle } : null;
---

<AppShell title={`${site.name} — ${ratePage.title}`} currentPath="/rate" width="standard">
  <Rate
    client:load
    register={register}
    signInEnabled={authEnabled}
    member={member}
    initialDrink={initialDrink}
    initialDraft={initialDraft}
  />
</AppShell>
