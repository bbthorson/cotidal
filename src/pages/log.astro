---
import AppShell from '../layouts/AppShell.astro';
import ReturnVisit from '../components/app/ReturnVisit';
import { site, returnVisit } from '../lib/copy';
import { loadRegister } from '../lib/register.server';
import { signInEnabled } from '../lib/atproto/auth';

/**
 * The return visit: "Your map, and what moved it."
 *
 * Logging a pour and watching the point move is the core recurring behaviour
 * of the product. Mounts ReturnVisit with client:load so the shell server-renders
 * and paints before hydration finishes.
 */

const register = await loadRegister();
const authEnabled = await signInEnabled();
// "Log this" on the /taste map arrives with the drink (logPathFor in site-nav.ts).
const initialDrink = Astro.url.searchParams.get('drink')?.trim().slice(0, 200) || undefined;
---

<AppShell
  title={`${site.name} — ${returnVisit.eyebrow}`}
  currentPath="/log"
  width="standard"
>
  <ReturnVisit client:load register={register} signInEnabled={authEnabled} initialDrink={initialDrink} />
</AppShell>
