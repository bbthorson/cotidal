---
import AppShell from '../layouts/AppShell.astro';
import Questions from '../components/app/Questions';
import { site, hero } from '../lib/copy';
import { signInEnabled } from '../lib/atproto/auth';
import { accountFor } from '../lib/atproto/session';

/**
 * The questions that place a coordinate, then the reveal. No tab is current
 * here and the bar along the foot is left out: on a phone the island hides
 * the header too (`data-focus-mode`). Someone who already has a coordinate is
 * sent on to Compass by the island, unless they came to start over.
 */
export const prerender = false;

const authEnabled = await signInEnabled();
const account = await accountFor(Astro.request, false);
const member = account.kind === 'member' ? { handle: account.handle } : null;
---

<AppShell title={`${site.name} — ${hero.primaryCta}`} currentPath="/questions" width="wide">
  <Questions client:load signInEnabled={authEnabled} member={member} />
</AppShell>
