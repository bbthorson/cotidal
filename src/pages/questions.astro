---
import AppShell from '../layouts/AppShell.astro';
import AppBar from '../components/marketing/AppBar.astro';
import Questions from '../components/app/Questions';
import { site, hero } from '../lib/copy';
import { signInEnabled } from '../lib/atproto/auth';
import { accountFor } from '../lib/atproto/session';
import { questionsHref } from '../lib/site-nav';

/**
 * The questions that place a coordinate, then the reveal, in the card over
 * the map (`Questions.tsx`). On a phone the island hides the header
 * (`data-focus-mode`) so the map and the question both fit. Someone who already has a coordinate is
 * sent on to Compass by the island, unless they came to start over.
 */
export const prerender = false;

const authEnabled = await signInEnabled();
const account = await accountFor(Astro.request, false);
const member = account.kind === 'member' ? { did: account.did, handle: account.handle } : null;
---

<AppShell title={`${site.name} — ${hero.primaryCta}`}>
  <Questions client:load signInEnabled={authEnabled} member={member}>
    <AppBar slot="bar" currentPath={questionsHref} account={account} />
  </Questions>
</AppShell>
