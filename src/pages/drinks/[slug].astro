---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import { site, drinks as copy, footer } from '../../lib/copy';
import { drinkDatabase } from '../../lib/data';
import { quadrantFor } from '../../lib/quadrant';

/** Static, like `/`. No island, no client JavaScript. */
export const prerender = true;

export const getStaticPaths = (async () => {
  const entries = await getCollection('drinks');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

/**
 * The coordinate is read from `drinkDatabase`, which is the single source of
 * truth for it. Frontmatter deliberately cannot override the map.
 */
const drink = drinkDatabase.find((item) => item.name === d.name);
const quadrant = drink ? quadrantFor(drink.x, drink.y) : null;
---

<Base title={`${d.title} · ${site.name}`} description={d.summary}>
  <div class="bar-texture min-h-screen bg-background px-6 py-12 text-foreground md:py-20">
    <header class="mx-auto mb-12 flex w-full max-w-2xl items-center justify-between border-b border-primary/10 pb-6">
      <a href="/" class="flex items-center gap-3">
        <span class="flex h-8 w-8 items-center justify-center rounded-full border border-primary/40 bg-card font-serif text-sm font-bold text-primary shadow-glow">
          {site.mark}
        </span>
        <span class="font-serif text-sm uppercase tracking-wordmark text-muted-foreground">
          {site.name}
        </span>
      </a>
      <a
        href="/drinks"
        class="font-mono text-3xs uppercase tracking-label text-primary/50 transition-colors hover:text-primary"
      >
        {copy.backLabel}
      </a>
    </header>

    <article class="mx-auto w-full max-w-2xl">
      <p class="font-mono text-3xs uppercase tracking-label text-primary/60">{d.family}</p>
      <h1 class="mt-3 font-serif text-4xl font-bold leading-display text-foreground md:text-5xl">
        {d.title}
      </h1>
      <p class="mt-5 font-serif text-base leading-relaxed text-foreground/80">{d.summary}</p>

      {
        drink && quadrant && (
          <dl class="mt-8 flex flex-wrap items-baseline gap-x-8 gap-y-3 border-y border-primary/10 py-5">
            <div>
              <dt class="font-mono text-3xs uppercase tracking-label text-muted-foreground/50">
                {copy.coordinateLabel}
              </dt>
              <dd class="mt-1 font-mono text-sm tabular-nums text-primary">
                {drink.x > 0 ? '+' : ''}{drink.x}, {drink.y > 0 ? '+' : ''}{drink.y}
              </dd>
            </div>
            <div>
              <dt class="font-mono text-3xs uppercase tracking-label text-muted-foreground/50">
                {quadrant.axis}
              </dt>
              <dd class="mt-1 font-serif text-sm font-bold text-foreground">{quadrant.name}</dd>
            </div>
          </dl>
        )
      }

      <div class="prose-entry mt-10">
        <Content />
      </div>

      <!-- The build -->
      <section class="mt-14 border-t border-primary/10 pt-7">
        <h2 class="font-mono text-3xs uppercase tracking-label text-primary/60">
          {copy.buildLabel}
        </h2>
        <ul class="mt-5 space-y-2">
          {
            d.ingredients.map((i) => (
              <li class="dot-leader text-sm">
                <span class="font-mono tabular-nums text-muted-foreground">{i.amount ?? ''}</span>
                <span class="font-serif text-foreground">
                  {i.name}
                  {i.optional && (
                    <span class="ml-2 font-mono text-3xs uppercase tracking-label text-muted-foreground/50">
                      {copy.optionalLabel}
                    </span>
                  )}
                </span>
              </li>
            ))
          }
        </ul>
        <p class="mt-5 font-serif text-xs leading-relaxed text-muted-foreground">
          {d.build.method} <span class="text-muted-foreground/60">{d.build.glass}.</span>
          {d.build.garnish}
        </p>
      </section>

      <!-- On the record -->
      <section class="mt-12 border-t border-primary/10 pt-7">
        <h2 class="font-mono text-3xs uppercase tracking-label text-primary/60">
          {copy.documentedLabel}
        </h2>
        <ul class="mt-5 space-y-5">
          {
            d.documented.map((item) => (
              <li class="border-l border-primary/30 pl-4">
                <p class="font-serif text-sm leading-relaxed text-foreground/80">{item.claim}</p>
                <p class="mt-1.5 font-mono text-3xs uppercase tracking-label text-muted-foreground/50">
                  {item.source}
                </p>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Claimed, not established -->
      {
        d.claimed.length > 0 && (
          <section class="mt-12 border-t border-primary/10 pt-7">
            <h2 class="font-mono text-3xs uppercase tracking-label text-secondary/70">
              {copy.claimedLabel}
            </h2>
            <ul class="mt-5 space-y-5">
              {d.claimed.map((item) => (
                <li class="border-l border-secondary/30 pl-4">
                  <p class="font-serif text-sm leading-relaxed text-muted-foreground">
                    {item.claim}
                  </p>
                  <p class="mt-1.5 text-2xs leading-relaxed text-muted-foreground/60">{item.note}</p>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <!-- Sources -->
      <section class="mt-12 border-t border-primary/10 pt-7">
        <h2 class="font-mono text-3xs uppercase tracking-label text-primary/60">
          {copy.sourcesLabel}
        </h2>
        <ul class="mt-5 space-y-2">
          {
            d.sources.map((s) => (
              <li class="text-2xs leading-relaxed text-muted-foreground">
                {s.url ? (
                  <a href={s.url} rel="noopener noreferrer" class="underline hover:text-primary">
                    {s.title}
                  </a>
                ) : (
                  <span>{s.title}</span>
                )}
                {s.author && <span class="text-muted-foreground/60"> · {s.author}</span>}
                {s.year && <span class="text-muted-foreground/60"> · {s.year}</span>}
              </li>
            ))
          }
        </ul>
      </section>

      <footer class="mt-16 border-t border-primary/5 pt-6 text-center font-mono text-3xs text-muted-foreground/40">
        {footer.note} · {footer.drinkResponsibly}
      </footer>
    </article>
  </div>
</Base>
