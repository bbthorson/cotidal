---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import AppShell from '../../layouts/AppShell.astro';
import PageTitle from '../../components/marketing/PageTitle.astro';
import OnTheRecord from '../../components/marketing/OnTheRecord.astro';
import Readout from '../../components/marketing/Readout.astro';
import { formatCoordinate } from '../../lib/coordinate';
import { site, drinks as copy } from '../../lib/copy';
import { drinkDatabase } from '../../lib/data';
import { quadrantFor, regionPath } from '../../lib/quadrant';
import { drinkMapHref, drinksHref, questionsHref } from '../../lib/site-nav';

/** Static, like `/`. No island, no client JavaScript. */
export const prerender = true;

export const getStaticPaths = (async () => {
  const entries = await getCollection('drinks');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

/**
 * The coordinate is read from `drinkDatabase`, which is the single source of
 * truth for it. Frontmatter deliberately cannot override the map.
 */
const drink = drinkDatabase.find((item) => item.name === d.name);
const quadrant = drink ? quadrantFor(drink.x, drink.y) : null;

/** Structured data for search and answer engines (SEO / AEO). */
const recipeJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Recipe',
  name: d.title,
  description: d.summary,
  recipeCategory: d.family,
  recipeIngredient: d.ingredients.map((i) =>
    `${i.amount} ${i.name}${i.optional ? ` (${copy.optionalLabel})` : ''}`
  ),
  recipeInstructions: [
    d.build.method,
    ...(d.build.garnish ? [`${copy.garnishLabel}: ${d.build.garnish}`] : []),
  ],
  ...(quadrant ? { keywords: [d.family, quadrant.name, quadrant.axis].join(', ') } : {}),
};
---

<AppShell
  title={`${d.title} · ${site.name}`}
  description={d.summary}
  currentPath={`${drinksHref}/${entry.id}`}
  backLink={{ href: drinksHref, label: copy.backLabel }}
  width="prose"
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(recipeJsonLd)} />

  <article>
        <PageTitle eyebrow={`${copy.eyebrow} · ${d.family}`} title={d.title} lede={d.summary} ruled>
          {
            drink && quadrant && (
              <Readout
                cells={[
                  { label: copy.coordinateLabel, value: formatCoordinate(drink.x, drink.y), figure: true },
                  { label: quadrant.axis, value: quadrant.name, href: regionPath(quadrant.id) },
                ]}
              />
            )
          }
        </PageTitle>

        <!-- Compare to your palate -->
        {
          drink && (
            <section class="border-b border-foreground py-8">
              <p class="label-caps text-secondary">{copy.compareLabel}</p>
              <h2 class="mt-1.5 font-serif text-heading font-bold text-foreground">
                {copy.compareTitle(d.title)}
              </h2>
              <p class="mt-2 font-serif text-ui leading-relaxed text-muted-foreground">
                {copy.compareBody}
              </p>
              <div class="mt-5 flex flex-wrap items-center gap-3">
                <a href={drinkMapHref(entry.id)} class="btn btn-primary px-6">
                  {copy.compareMapCta}
                </a>
                <a href={questionsHref} class="btn btn-outline px-6">
                  {copy.compareQuizCta}
                </a>
              </div>
            </section>
          )
        }

        <div class="prose-entry py-12">
          <Content />
        </div>

        <!-- The build -->
        <section class="pb-12">
          <h2 class="section-title">
            {copy.buildLabel}
          </h2>
          {
            d.ingredients.length > 0 && (
              <ul class="border-b border-border">
                {d.ingredients.map((i) => (
                  <li class="menu-row dot-leader py-2.5 first:border-t-0">
                    <span class="font-serif text-ui text-foreground">
                      {i.name}
                      {i.optional && (
                        <em class="ml-2 text-meta not-italic text-muted-foreground">
                          {copy.optionalLabel}
                        </em>
                      )}
                    </span>
                    <span class="leader" aria-hidden="true"></span>
                    <span class="shrink-0 font-condensed text-ui tabular-nums text-secondary">
                      {i.amount}
                    </span>
                  </li>
                ))}
              </ul>
            )
          }
          <dl class="mt-5 space-y-2.5">
            <div class="flex gap-4">
              <dt class="label-caps w-16 shrink-0 pt-0.5">{copy.glassLabel}</dt>
              <dd class="text-meta leading-relaxed text-foreground">
                {d.build.glass}
              </dd>
            </div>
            <div class="flex gap-4">
              <dt class="label-caps w-16 shrink-0 pt-0.5">{copy.methodLabel}</dt>
              <dd class="text-meta leading-relaxed text-foreground">
                {d.build.method}
              </dd>
            </div>
            {
              d.build.garnish && (
                <div class="flex gap-4">
                  <dt class="label-caps w-16 shrink-0 pt-0.5">{copy.garnishLabel}</dt>
                  <dd class="text-meta leading-relaxed text-foreground">
                    {d.build.garnish}
                  </dd>
                </div>
              )
            }
          </dl>
        </section>

        <OnTheRecord documented={d.documented} claimed={d.claimed} sources={d.sources} />
      </article>
</AppShell>
