---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import AppShell from '../../layouts/AppShell.astro';
import PageTitle from '../../components/marketing/PageTitle.astro';
import OnTheRecord from '../../components/marketing/OnTheRecord.astro';
import { site, drinks as copy } from '../../lib/copy';
import { drinkDatabase } from '../../lib/data';
import { quadrantFor } from '../../lib/quadrant';

/** Static, like `/`. No island, no client JavaScript. */
export const prerender = true;

export const getStaticPaths = (async () => {
  const entries = await getCollection('drinks');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

/**
 * The coordinate is read from `drinkDatabase`, which is the single source of
 * truth for it. Frontmatter deliberately cannot override the map.
 */
const drink = drinkDatabase.find((item) => item.name === d.name);
const quadrant = drink ? quadrantFor(drink.x, drink.y) : null;
---

<AppShell
  title={`${d.title} · ${site.name}`}
  description={d.summary}
  currentPath={`/drinks/${entry.id}`}
  backLink={{ href: '/drinks', label: copy.backLabel }}
  width="prose"
>
  <article>
        <PageTitle eyebrow={d.family} title={d.title} lede={d.summary} ruled>
          {
            drink && quadrant && (
              <div class="mt-8 inline-flex items-stretch border-y border-border">
                <div class="border-r border-border px-4 py-2 text-left">
                  <span class="label-caps block">{copy.coordinateLabel}</span>
                  <span class="mt-0.5 block font-condensed text-prose tabular-nums text-foreground">
                    {drink.x > 0 ? '+' : ''}
                    {drink.x}, {drink.y > 0 ? '+' : ''}
                    {drink.y}
                  </span>
                </div>
                <div class="px-4 py-2 text-left">
                  <span class="label-caps block">{quadrant.axis}</span>
                  <span class="mt-0.5 block font-serif text-prose font-bold text-foreground">
                    {quadrant.name}
                  </span>
                </div>
              </div>
            )
          }
        </PageTitle>

        <div class="prose-entry py-12">
          <Content />
        </div>

        <!-- The build -->
        <section class="pb-12">
          <h2 class="section-title">
            {copy.buildLabel}
          </h2>
          {
            d.ingredients.length > 0 && (
              <ul class="border-b border-border">
                {d.ingredients.map((i) => (
                  <li class="menu-row dot-leader py-2.5 first:border-t-0">
                    <span class="font-serif text-ui text-foreground">
                      {i.name}
                      {i.optional && (
                        <em class="ml-2 text-meta not-italic text-muted-foreground">
                          {copy.optionalLabel}
                        </em>
                      )}
                    </span>
                    <span class="leader" aria-hidden="true"></span>
                    <span class="shrink-0 font-condensed text-ui tabular-nums text-secondary">
                      {i.amount}
                    </span>
                  </li>
                ))}
              </ul>
            )
          }
          <dl class="mt-5 space-y-2.5">
            <div class="flex gap-4">
              <dt class="label-caps w-16 shrink-0 pt-0.5">{copy.glassLabel}</dt>
              <dd class="text-meta leading-relaxed text-foreground">
                {d.build.glass}
              </dd>
            </div>
            <div class="flex gap-4">
              <dt class="label-caps w-16 shrink-0 pt-0.5">{copy.methodLabel}</dt>
              <dd class="text-meta leading-relaxed text-foreground">
                {d.build.method}
              </dd>
            </div>
            {
              d.build.garnish && (
                <div class="flex gap-4">
                  <dt class="label-caps w-16 shrink-0 pt-0.5">{copy.garnishLabel}</dt>
                  <dd class="text-meta leading-relaxed text-foreground">
                    {d.build.garnish}
                  </dd>
                </div>
              )
            }
          </dl>
        </section>

        <OnTheRecord documented={d.documented} claimed={d.claimed} sources={d.sources} />
      </article>
</AppShell>
