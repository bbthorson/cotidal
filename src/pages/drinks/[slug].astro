---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import MapPage from '../../layouts/MapPage.astro';
import { PalateMap } from '../../components/app/PalateMap';
import { Readout, ScreenHeader } from '../../components/app/ui';
import { DrinkEntry } from '../../components/app/DrinkEntry';
import { drinkEntryData } from '../../lib/drinks/drink-entry.server';
import { loadRegister } from '../../lib/drinks/register.server';
import { titleOf } from '../../lib/drinks/register';
import { formatCoordinate } from '../../lib/map/coordinates';
import { site, drinks as copy, explore } from '../../lib/copy';
import { drinkDatabase } from '../../lib/drinks/data';
import { quadrantFor, regionPath } from '../../lib/map/coordinates';
import { neighboursOf } from '../../lib/map/map-draw';
import { drinkMapHref, drinkPagePath, questionsForDrink } from '../../lib/site-nav';

/**
 * A drink is a place on the map: the page is the map with the drink marked,
 * its neighbours named and its region washed, the tide turning behind them,
 * and the entry in the card (docs/map-first.md, The map on every page). No
 * terrain is drawn: the page does not know who is reading, and a sample
 * palate behind a drink would read as a verdict on it.
 *
 * Static, like `/`. The map and the card are React rendered on the server
 * with no directive, so the page ships no client JavaScript.
 */
export const prerender = true;

export const getStaticPaths = (async () => {
  const entries = await getCollection('drinks');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const d = entry.data;

/**
 * The coordinate is read from `drinkDatabase`, which is the single source of
 * truth for it. Frontmatter deliberately cannot override the map.
 */
const drink = drinkDatabase.find((item) => item.name === d.name);
const quadrant = drink ? quadrantFor(drink.x, drink.y) : null;

/** The drinks nearest it, named on the map and listed under the entry, linked where they have entries of their own. */
const register = await loadRegister();
const neighbours = drink ? neighboursOf(drink, drinkDatabase, 5) : [];

/** Structured data for search and answer engines (SEO / AEO). */
const recipeJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Recipe',
  name: d.title,
  description: d.summary,
  recipeCategory: d.family,
  recipeIngredient: d.ingredients.map((i) =>
    `${i.amount} ${i.name}${i.optional ? ` (${copy.optionalLabel})` : ''}`
  ),
  recipeInstructions: [
    d.build.method,
    ...(d.build.garnish ? [`${copy.garnishLabel}: ${d.build.garnish}`] : []),
  ],
  ...(quadrant ? { keywords: [d.family, quadrant.name, quadrant.axis].join(', ') } : {}),
};
---

<MapPage
  title={`${d.title} · ${site.name}`}
  description={d.summary}
  currentPath={drinkPagePath(entry.id)}
  label={d.title}
  eyebrow={`${copy.eyebrow} · ${d.family}`}
  back={{ href: drinkMapHref(entry.id), label: copy.backLabel }}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(recipeJsonLd)} />

  <PalateMap
    slot="map"
    label={explore.chartLabel}
    selected={drink?.name ?? null}
    named={neighbours.map((n) => n.name)}
    region={quadrant?.id ?? null}
    tide
  />

  <article>
    <ScreenHeader title={d.title} gloss={d.summary}>
      {
        drink && quadrant && (
          <Readout
            className="mt-6"
            cells={[
              { label: copy.coordinateLabel, value: formatCoordinate(drink.x, drink.y), figure: true },
              { label: quadrant.axis, value: quadrant.name, href: regionPath(quadrant.id) },
            ]}
          />
        )
      }
    </ScreenHeader>

    <!-- Compare to your palate: the card's one action, for a member and a stranger alike -->
    {
      drink && (
        <section class="mt-6 border-y border-foreground py-5">
          <p class="label-caps text-secondary">{copy.compareLabel}</p>
          <h2 class="mt-1.5 font-serif text-plate font-bold text-foreground">{copy.compareTitle(d.title)}</h2>
          <p class="mt-2 text-meta leading-relaxed text-muted-foreground">{copy.compareBody}</p>
          <a href={questionsForDrink(entry.id)} class="btn btn-primary mt-4 w-full">
            {copy.compareCta}
          </a>
        </section>
      )
    }

    <DrinkEntry
      entry={drinkEntryData(entry)}
      neighbours={neighbours.map((n) => ({ ...n, title: titleOf(register, n.name), href: register[n.name] ? drinkPagePath(register[n.name].slug) : undefined }))}
    />
  </article>
</MapPage>
