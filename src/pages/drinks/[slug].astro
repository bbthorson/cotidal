---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/marketing/SiteHeader.astro';
import { site, nav, drinks as copy, footer } from '../../lib/copy';
import { drinkDatabase } from '../../lib/data';
import { quadrantFor } from '../../lib/quadrant';

/** Static, like `/`. No island, no client JavaScript. */
export const prerender = true;

export const getStaticPaths = (async () => {
  const entries = await getCollection('drinks');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

/**
 * The coordinate is read from `drinkDatabase`, which is the single source of
 * truth for it. Frontmatter deliberately cannot override the map.
 */
const drink = drinkDatabase.find((item) => item.name === d.name);
const quadrant = drink ? quadrantFor(drink.x, drink.y) : null;
---

<Base title={`${d.title} · ${site.name}`} description={d.summary}>
  <div class="bar-texture min-h-screen bg-background text-foreground">
    <div class="mx-auto w-full max-w-2xl px-6 py-10 md:py-14">
      <SiteHeader
        currentPath={`/drinks/${entry.id}`}
        backLink={{ href: '/drinks', label: copy.backLabel }}
      />

      <article>
        <!-- Title plate, in the manner of the reference: one name, a lot of air -->
        <div class="border-b border-foreground pb-10 pt-14 text-center md:pt-20">
          <p class="label-caps">{d.family}</p>
          <h1 class="mt-4 font-serif text-4xl font-bold leading-display text-foreground md:text-5xl">
            {d.title}
          </h1>
          <p
            class="mx-auto mt-5 max-w-lg font-serif text-base italic leading-relaxed text-muted-foreground"
          >
            {d.summary}
          </p>

          {
            drink && quadrant && (
              <div class="mt-8 inline-flex items-stretch border border-border">
                <div class="border-r border-border px-4 py-2 text-left">
                  <span class="label-caps block">{copy.coordinateLabel}</span>
                  <span class="mt-0.5 block font-condensed text-base tabular-nums text-primary">
                    {drink.x > 0 ? '+' : ''}
                    {drink.x}, {drink.y > 0 ? '+' : ''}
                    {drink.y}
                  </span>
                </div>
                <div class="px-4 py-2 text-left">
                  <span class="label-caps block">{quadrant.axis}</span>
                  <span class="mt-0.5 block font-serif text-base font-bold text-foreground">
                    {quadrant.name}
                  </span>
                </div>
              </div>
            )
          }
        </div>

        <div class="prose-entry py-12">
          <Content />
        </div>

        <!-- The build -->
        <section class="pb-12">
          <h2 class="label-caps border-b border-foreground pb-2 text-foreground">
            {copy.buildLabel}
          </h2>
          <ul class="border-b border-border">
            {
              d.ingredients.map((i) => (
                <li class="menu-row dot-leader py-2.5 first:border-t-0">
                  <span class="font-serif text-sm text-foreground">
                    {i.name}
                    {i.optional && (
                      <em class="ml-2 font-condensed text-3xs uppercase not-italic tracking-label text-muted-foreground">
                        {copy.optionalLabel}
                      </em>
                    )}
                  </span>
                  <span class="leader" aria-hidden="true"></span>
                  <span class="shrink-0 font-condensed text-sm tabular-nums text-secondary">
                    {i.amount}
                  </span>
                </li>
              ))
            }
          </ul>
          <dl class="mt-5 space-y-2.5">
            <div class="flex gap-4">
              <dt class="label-caps w-16 shrink-0 pt-0.5">{copy.glassLabel}</dt>
              <dd class="font-serif text-xs leading-relaxed text-foreground/80">
                {d.build.glass}
              </dd>
            </div>
            <div class="flex gap-4">
              <dt class="label-caps w-16 shrink-0 pt-0.5">{copy.methodLabel}</dt>
              <dd class="font-serif text-xs leading-relaxed text-foreground/80">
                {d.build.method}
              </dd>
            </div>
            {
              d.build.garnish && (
                <div class="flex gap-4">
                  <dt class="label-caps w-16 shrink-0 pt-0.5">{copy.garnishLabel}</dt>
                  <dd class="font-serif text-xs leading-relaxed text-foreground/80">
                    {d.build.garnish}
                  </dd>
                </div>
              )
            }
          </dl>
        </section>

        <!-- On the record -->
        <section class="pb-12">
          <h2 class="label-caps border-b border-foreground pb-2 text-foreground">
            {copy.documentedLabel}
          </h2>
          <ul>
            {
              d.documented.map((item) => (
                <li class="menu-row py-4 first:border-t-0">
                  <p class="font-serif text-sm leading-relaxed text-foreground/85">{item.claim}</p>
                  <p class="label-caps mt-2 text-secondary">{item.source}</p>
                </li>
              ))
            }
          </ul>
        </section>

        <!-- Claimed, not established -->
        {
          d.claimed.length > 0 && (
            <section class="pb-12">
              <h2 class="label-caps border-b border-foreground pb-2 text-foreground">
                {copy.claimedLabel}
              </h2>
              <ul>
                {d.claimed.map((item) => (
                  <li class="menu-row py-4 first:border-t-0">
                    <p class="font-serif text-sm italic leading-relaxed text-muted-foreground">
                      {item.claim}
                    </p>
                    <p class="mt-2 border-l-2 border-primary pl-3 font-serif text-xs leading-relaxed text-foreground/70">
                      {item.note}
                    </p>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <!-- Sources -->
        <section class="pb-12">
          <h2 class="label-caps border-b border-foreground pb-2 text-foreground">
            {copy.sourcesLabel}
          </h2>
          <ul class="mt-3 space-y-2">
            {
              d.sources.map((s) => (
                <li class="font-serif text-xs leading-relaxed text-muted-foreground">
                  {s.url ? (
                    <a
                      href={s.url}
                      rel="noopener noreferrer"
                      class="text-foreground underline underline-offset-4 transition-colors hover:text-primary"
                    >
                      {s.title}
                    </a>
                  ) : (
                    <span class="text-foreground">{s.title}</span>
                  )}
                  {s.author && <span> · {s.author}</span>}
                  {s.year && <span class="tabular-nums"> · {s.year}</span>}
                </li>
              ))
            }
          </ul>
        </section>
      </article>

      <footer class="mt-16 border-t border-foreground pt-8 text-center">
        <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 font-condensed text-xs uppercase tracking-label text-muted-foreground">
          <a href="/" class="transition-colors hover:text-primary">{nav.home}</a>
          <span aria-hidden="true" class="text-border">·</span>
          <a href="/taste" class="transition-colors hover:text-primary">{nav.map}</a>
          <span aria-hidden="true" class="text-border">·</span>
          <a href="/drinks" class="font-bold text-primary">{nav.register}</a>
          <span aria-hidden="true" class="text-border">·</span>
          <a href="/#regions" class="transition-colors hover:text-primary">{nav.regions}</a>
          <span aria-hidden="true" class="text-border">·</span>
          <a href="/#connect" class="transition-colors hover:text-primary">{nav.signIn}</a>
        </div>

        <div class="mt-5 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 font-condensed text-3xs uppercase tracking-label text-muted-foreground">
          <span>{footer.note}</span>
          <span aria-hidden="true">·</span>
          <span>{footer.drinkResponsibly}</span>
        </div>
      </footer>
    </div>
  </div>
</Base>
