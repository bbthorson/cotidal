---
import { getCollection } from 'astro:content';
import MapPage from '../../layouts/MapPage.astro';
import { PalateMap } from '../../components/app/PalateMap';
import { CardHead } from '../../components/app/MapScreen';
import { ScreenHeader } from '../../components/app/ui';
import RegionFilter from '../../components/marketing/RegionFilter.astro';
import DrinkRow from '../../components/marketing/DrinkRow.astro';
import { site, drinks as copy, explore, quadrants } from '../../lib/copy';
import { drinkDatabase } from '../../lib/data';
import { quadrantIdFor, regionPath } from '../../lib/quadrant';
import { drinksHref } from '../../lib/site-nav';

/**
 * The map with every drink written up named where its label fits, and the
 * list in the card. Static, like `/`: the map and the card are React rendered
 * on the server with no directive, so nothing here ships a script.
 *
 * Set as a printed list: quadrants are section heads the way a wine list uses
 * regions, and each drink is a ruled row. The regions are also a filter
 * (`RegionFilter`): each narrows this list to one region at
 * `/drinks/regions/<id>`.
 */
export const prerender = true;

const entries = await getCollection('drinks');

/**
 * Coordinates come from `drinkDatabase`, never from frontmatter. An entry that
 * does not join is a bug, and `tests/unit/drink-content.test.ts` fails on it — but
 * a missing join must not take the whole page down at build time either.
 */
const placed = entries
  .map((entry) => {
    const drink = drinkDatabase.find((d) => d.name === entry.data.name);
    return drink ? { entry, drink } : null;
  })
  .filter((v): v is NonNullable<typeof v> => v !== null);

const grouped = quadrants.map((quadrant) => ({
  quadrant,
  items: placed
    .filter(({ drink }) => quadrantIdFor(drink.x, drink.y) === quadrant.id)
    .sort((a, b) => a.entry.data.title.localeCompare(b.entry.data.title)),
}));
---

<MapPage title={`${copy.title} · ${site.name}`} description={copy.intro} currentPath={drinksHref} label={copy.title}>
  <PalateMap slot="map" label={explore.chartLabel} named={placed.map(({ drink }) => drink.name)} tide />

  <CardHead slot="head">
    <span class="label-caps">{copy.eyebrow}</span>
  </CardHead>

  <ScreenHeader title={copy.title} gloss={copy.intro} />
  <div class="mt-6">
    <RegionFilter />
  </div>

  <div class="mt-10 space-y-12">
    {
      grouped.map(({ quadrant, items }) => (
        <section id={quadrant.id}>
          <div class="flex items-baseline justify-between border-b border-foreground pb-2">
            <h2 class="font-serif text-heading font-bold text-foreground">
              <a href={regionPath(quadrant.id)} class="hover:underline hover:underline-offset-4">{quadrant.name}</a>
            </h2>
            <span class="label-caps text-secondary">{quadrant.axis}</span>
          </div>
          <p class="mt-2 font-serif text-ui italic leading-relaxed text-muted-foreground">{quadrant.gloss}</p>

          {items.length === 0 ? (
            <p class="mt-5 font-serif text-ui italic text-muted-foreground">{copy.emptyQuadrant}</p>
          ) : (
            <ul class="mt-4 border-b border-border">
              {items.map(({ entry, drink }) => <DrinkRow entry={entry} drink={drink} />)}
            </ul>
          )}
        </section>
      ))
    }
  </div>
</MapPage>
