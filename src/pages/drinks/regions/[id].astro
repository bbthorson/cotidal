---
import { getCollection, getEntry, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import MapPage from '../../../layouts/MapPage.astro';
import { PalateMap } from '../../../components/app/PalateMap';
import { ScreenHeader } from '../../../components/app/ui';
import RegionFilter from '../../../components/marketing/RegionFilter.astro';
import DrinkRow from '../../../components/marketing/DrinkRow.astro';
import OnTheRecord from '../../../components/marketing/OnTheRecord.astro';
import { site, quadrants, regionPage as copy, share, explore, drinks } from '../../../lib/copy';
import { drinksHref } from '../../../lib/site-nav';
import { shareImagePath } from '../../../lib/share';
import { drinkDatabase } from '../../../lib/data';
import { sharedIngredients } from '../../../lib/ingredients';
import { QUADRANT_ORDER, quadrantIdFor, regionPath, type QuadrantId } from '../../../lib/quadrant';

/**
 * A region is a filter on the drinks: `/drinks` narrowed to the drinks the
 * map places here, then what the region is. The map washes the region and
 * names its drinks; the card holds the list and the prose. Static: React
 * rendered on the server with no directive, no island.
 *
 * The ids are URLs: the landing page, `/p/<handle>`, the chat tools and the
 * region coasters link here.
 */
export const prerender = true;

export const getStaticPaths = (() => QUADRANT_ORDER.map((id) => ({ params: { id } }))) satisfies GetStaticPaths;

const { id } = Astro.params as { id: QuadrantId };
const region = quadrants.find((q) => q.id === id)!;

/**
 * The prose, from `src/content/regions/<id>.md`. A region without an entry
 * still has a page — everything else is derived — and
 * `tests/unit/region-content.test.ts` is what insists all four are written.
 */
const entry = await getEntry('regions', id);
const Content = entry ? (await render(entry)).Content : null;

/** Which drinks live here is the map's answer, never the entry's. */
const placed = (await getCollection('drinks'))
  .map((drinkEntry) => {
    const drink = drinkDatabase.find((d) => d.name === drinkEntry.data.name);
    return drink ? { entry: drinkEntry, drink } : null;
  })
  .filter((v): v is NonNullable<typeof v> => v !== null)
  .filter(({ drink }) => quadrantIdFor(drink.x, drink.y) === id)
  .sort((a, b) => a.entry.data.title.localeCompare(b.entry.data.title));

const shared = sharedIngredients(placed.map(({ entry }) => entry.data));
---

<MapPage
  title={`${region.name} · ${site.name}`}
  description={region.gloss}
  image={{ path: shareImagePath(region.id), alt: share.regionAlt(region.name) }}
  currentPath={regionPath(region.id)}
  label={region.name}
  eyebrow={copy.eyebrow(region.axis)}
  back={{ href: drinksHref, label: drinks.backLabel }}
>
  <PalateMap slot="map" label={explore.chartLabel} region={region.id} named={placed.map(({ drink }) => drink.name)} tide />

  <ScreenHeader title={region.name} gloss={region.gloss} />
  <div class="mt-6">
    <RegionFilter current={region.id} />
  </div>

  <!-- The drinks: what the filter is for -->
  <section class="mt-8">
    <ul class="border-b border-border">
      {placed.map(({ entry: drinkEntry, drink }) => <DrinkRow entry={drinkEntry} drink={drink} />)}
    </ul>
    <p class="mt-3 font-serif text-ui italic leading-relaxed text-muted-foreground">{copy.placedNote}</p>
  </section>

  <!-- Then the region itself -->
  <article class="mt-12 border-t border-foreground pt-8">
    <h2 class="font-serif text-heading font-bold text-foreground">{copy.aboutLabel(region.name)}</h2>

    {
      Content && (
        <div class="prose-entry py-8">
          <Content />
        </div>
      )
    }

    <section class="pb-10">
      <h3 class="section-title">{copy.orderingLabel}</h3>
      <p class="mt-4 font-serif text-ui leading-relaxed text-foreground">{copy.ordering(region.name, region.axis)}</p>
    </section>

    {
      shared.length > 0 && (
        <section class="pb-10">
          <h3 class="section-title">{copy.sharedLabel}</h3>
          <ul class="border-b border-border">
            {shared.map((ingredient) => (
              <li class="menu-row dot-leader py-2.5 first:border-t-0">
                <span class="font-serif text-ui text-foreground">{ingredient.name}</span>
                <span class="leader" aria-hidden="true" />
                <span class="shrink-0 font-condensed text-ui tabular-nums text-secondary">
                  {copy.sharedCount(ingredient.count, placed.length)}
                </span>
              </li>
            ))}
          </ul>
          <p class="mt-3 font-serif text-ui italic leading-relaxed text-muted-foreground">{copy.sharedNote(placed.length)}</p>
        </section>
      )
    }

    {entry && <OnTheRecord {...entry.data} />}

  </article>
</MapPage>
