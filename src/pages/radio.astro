---
import AppShell from '../layouts/AppShell.astro';
import Radio from '../components/app/Radio';
import { site, radio } from '../lib/copy';
import { loadRegister } from '../lib/register.server';
import { signInEnabled } from '../lib/atproto/auth';
import { accountFor } from '../lib/atproto/session';

/**
 * Pours as they go out. The server says whether the reader is a member, so
 * the island knows where their pours live — the account or this device —
 * and a guest is told what signing in buys, without waiting on a request.
 */
export const prerender = false;

const register = await loadRegister();
const authEnabled = await signInEnabled();
const account = await accountFor(Astro.request, false);
const member = account.kind === 'member' ? { handle: account.handle } : null;
---

<AppShell title={`${site.name} — ${radio.title}`} currentPath="/radio" width="standard" bottomBar>
  <Radio client:load register={register} signInEnabled={authEnabled} member={member} />
</AppShell>
