---
import AppShell from '../../layouts/AppShell.astro';
import PageTitle from '../../components/marketing/PageTitle.astro';
import { barPublish as copy, nav, site } from '../../lib/copy';
import { accountFor, oauthSession } from '../../lib/atproto/session';
import { publishVenueAndMenu } from '../../lib/atproto/venue-publish';
import { verifyVenueDomain } from '../../lib/atproto/venue-verify';
import { barsHref, signIn } from '../../lib/site-nav';

/**
 * `/bars/publish` — self-serve AT Protocol venue claim & menu publisher.
 * Claiming verifies that the bar's website URL resolves to the signed-in
 * account's DID before writing `app.cotidal.venue` at `rkey: self`.
 * Server-rendered with a plain POST form, shipping zero client JavaScript.
 */
export const prerender = false;

const account = await accountFor(Astro.request, false);
if (account.kind !== 'member') return Astro.redirect(signIn.href, 303);

let error: string | null = null;
let values = { name: '', description: '', website: '', menuTitle: '', menuLines: '' };

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  values = {
    name: String(form.get('name') ?? '').trim(),
    description: String(form.get('description') ?? '').trim(),
    website: String(form.get('website') ?? '').trim(),
    menuTitle: String(form.get('menuTitle') ?? '').trim(),
    menuLines: String(form.get('menuLines') ?? '').trim(),
  };

  if (!values.name) {
    error = copy.needName;
  } else if (!values.website) {
    error = copy.needWebsite;
  } else if (!/^https?:\/\//i.test(values.website)) {
    error = copy.invalidWebsite;
  } else {
    const check = await verifyVenueDomain(values.website, account.did, account.handle);
    if (!check.ok) {
      error =
        check.reason === 'invalid-url'
          ? copy.invalidWebsite
          : check.reason === 'unavailable'
            ? copy.domainCheckFailed
            : copy.domainMismatch(check.domain ?? values.website, account.did);
    } else {
      const session = await oauthSession(Astro.request);
      if (!session) return Astro.redirect(signIn.href, 303);
      try {
        await publishVenueAndMenu(session, values);
        return Astro.redirect(`/v/${encodeURIComponent(account.handle ?? account.did)}`, 303);
      } catch (e) {
        console.error('Could not publish venue:', e);
        error = copy.publishFailed;
      }
    }
  }
}

const actorLabel = account.handle ? `@${account.handle}` : account.did;
Astro.response.headers.set('Cache-Control', 'no-store');
---

<AppShell
  title={`${site.name} — ${copy.eyebrow}`}
  currentPath={`${barsHref}/publish`}
  backLink={{ href: barsHref, label: nav.bars }}
  width="prose"
>
  <div class="space-y-8 pb-8 pt-6">
    <PageTitle eyebrow={copy.eyebrow} title={copy.title} lede={copy.lede} />

    <p class="text-meta text-muted-foreground">
      {copy.publishingAs} <span class="font-bold text-foreground">{actorLabel}</span>
    </p>

    {error && (
      <p role="alert" class="border-y border-destructive py-2.5 text-meta text-destructive">
        {error}
      </p>
    )}

    <form method="POST" action={`${barsHref}/publish`} class="space-y-5">
      <label class="flex flex-col gap-1.5">
        <span class="label-caps">{copy.nameLabel}</span>
        <input
          name="name"
          value={values.name}
          placeholder={copy.namePlaceholder}
          required
          maxlength={200}
          class="field min-h-11"
        />
      </label>

      <label class="flex flex-col gap-1.5">
        <span class="label-caps">{copy.descriptionLabel}</span>
        <textarea
          name="description"
          placeholder={copy.descriptionPlaceholder}
          rows={2}
          maxlength={2000}
          class="field py-2.5"
        >{values.description}</textarea>
      </label>

      <label class="flex flex-col gap-1.5">
        <span class="label-caps">{copy.websiteLabel}</span>
        <input
          name="website"
          type="url"
          value={values.website}
          placeholder={copy.websitePlaceholder}
          required
          maxlength={500}
          class="field min-h-11"
        />
      </label>

      <label class="flex flex-col gap-1.5">
        <span class="label-caps">{copy.menuTitleLabel}</span>
        <input
          name="menuTitle"
          value={values.menuTitle}
          placeholder={copy.menuTitlePlaceholder}
          maxlength={200}
          class="field min-h-11"
        />
      </label>

      <label class="flex flex-col gap-1.5">
        <span class="label-caps">{copy.menuLinesLabel}</span>
        <textarea
          name="menuLines"
          placeholder={copy.menuLinesPlaceholder}
          rows={8}
          class="field py-2.5"
        >{values.menuLines}</textarea>
      </label>

      <button type="submit" class="btn btn-primary btn-lg w-full px-6">
        {copy.submit}
      </button>

      <p class="text-meta text-muted-foreground">{copy.postcardNote}</p>
    </form>
  </div>
</AppShell>
