---
import AppShell from '../layouts/AppShell.astro';
import Home from '../components/app/Home';
import { site, nav } from '../lib/copy';
import { loadRegister } from '../lib/register.server';
import { signInEnabled } from '../lib/atproto/auth';

/**
 * The interactive half of the app. This is the only route that mounts a
 * React island — the landing page at / ships no JavaScript at all.
 *
 * `client:load` (not `client:only`) so the shell server-renders and the
 * page has painted content before hydration finishes.
 */

const register = await loadRegister();
const authEnabled = await signInEnabled();
---

<AppShell
  title={`${site.name} — ${nav.map}`}
  currentPath="/taste"
  width="wide"
>
  <Home client:load register={register} signInEnabled={authEnabled} />
</AppShell>
