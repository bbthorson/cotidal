---
import { getCollection } from 'astro:content';
import AppShell from '../layouts/AppShell.astro';
import Home from '../components/app/Home';
import { site, nav } from '../lib/copy';
import type { Register } from '../lib/register';

/**
 * The interactive half of the app. This is the only route that mounts a
 * React island — the landing page at / ships no JavaScript at all.
 *
 * `client:load` (not `client:only`) so the shell server-renders and the
 * page has painted content before hydration finishes.
 */

const entries = await getCollection('drinks');
const register: Register = Object.fromEntries(
  entries.map((entry) => [
    entry.data.name,
    {
      slug: entry.id,
      title: entry.data.title,
      build: entry.data.ingredients
        .filter((i) => !i.optional)
        .map((i) => i.name)
        .join(' · '),
    },
  ])
);
---

<AppShell
  title={`${site.name} — ${nav.map}`}
  currentPath="/taste"
  width="wide"
>
  <Home client:load register={register} />
</AppShell>
