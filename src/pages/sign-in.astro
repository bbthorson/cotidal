---
import MapPage from '../layouts/MapPage.astro';
import { PalateMap } from '../components/app/PalateMap';
import { ScreenHeader } from '../components/app/ui';
import ConnectForm from '../components/site/ConnectForm.astro';
import Principles from '../components/site/Principles.astro';
import { connect, explore, sections, site } from '../lib/copy';
import { signInEnabled } from '../lib/atproto/auth';
import { signIn } from '../lib/site-nav';
import { AUTH_ERROR_MESSAGES, AUTH_ERROR_PARAM, isAuthErrorCode } from '@bbthorson/atproto-cf-auth/client';

/**
 * Signing in, as a page on the map (`MapPage`, the tide turning behind): the
 * form first in the card (progressively enhanced with `<bsky-sign-in>`,
 * working with JavaScript off too), followed by what signing in keeps and
 * whose log it is.
 */

export const prerender = false;

// The server's runtime answer, the same one the login route acts on.
const enabled = await signInEnabled();

// `auth_error` is what the login route redirects back with when it cannot start.
const errorParam = Astro.url.searchParams.get(AUTH_ERROR_PARAM);
const error = errorParam
  ? AUTH_ERROR_MESSAGES[isAuthErrorCode(errorParam) ? errorParam : 'authorize_failed']
  : null;
---

<MapPage title={`${site.name} — ${sections.connect}`} currentPath={signIn.href} label={sections.connect} eyebrow={sections.connect} asksForCoordinate>
  <PalateMap slot="map" label={explore.chartLabel} tide />

  <ScreenHeader title={connect.title} gloss={connect.lede} />
  <div class="space-y-12 pt-8">
    <section class="space-y-5">
      <ConnectForm enabled={enabled} error={error} />
    </section>

    <section>
      <h2 class="section-title mb-4">{sections.whatItKeeps}</h2>
      <ol>
        {
          connect.buys.map((b, i) => (
            <li class="flex gap-3 border-b border-border py-3.5">
              <span class="w-3.5 shrink-0 font-condensed text-ui font-bold text-muted-foreground">{i + 1}</span>
              <div class="space-y-0.5">
                <p class="text-ui font-bold text-foreground">{b.title}</p>
                <p class="text-meta text-muted-foreground">{b.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section>
      <h2 class="section-title mb-5">{sections.principles}</h2>
      <Principles />
    </section>
  </div>
</MapPage>
