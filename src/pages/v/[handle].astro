---
import MapPage from '../../layouts/MapPage.astro';
import { ScreenHeader, SectionTitle } from '../../components/app/ui';
import { DrinkRow } from '../../components/app/DrinkRow';
import { PalateMap, type Pin } from '../../components/app/PalateMap';
import { readPublicVenue } from '../../lib/atproto/venue-read';
import { formatCoordinate } from '../../lib/map/coordinates';
import { explore, site, venuePage as copy } from '../../lib/copy';

/**
 * `/v/<handle>` — a bar's live AT Protocol venue & menu page: the map with
 * the bar's menu on it as numbered pins, as `/` draws a bar, and the menu
 * in the card. Server-rendered directly from the venue's own PDS
 * (`app.cotidal.venue` + `app.cotidal.menu`), shipping zero client JavaScript.
 */
export const prerender = false;

const handle = Astro.params.handle ?? '';
const result = await readPublicVenue(handle);

if (result.status === 'invalid' || result.status === 'not-found') {
  Astro.response.status = 404;
} else if (result.status === 'unavailable') {
  Astro.response.status = 502;
}

const title =
  result.status === 'ok'
    ? `${result.venue.name} — ${site.name}`
    : `${site.name} — ${copy.eyebrow}`;

/** The menu's drinks that are on the map, numbered in the menu's own order. */
const pins: Pin[] = [];
if (result.status === 'ok' && result.venue.menu) {
  for (const section of result.venue.menu.sections)
    for (const item of section.items)
      if (item.placed && !pins.some((p) => p.drink.name === item.placed!.name)) pins.push({ drink: item.placed, rank: pins.length + 1 });
}

const formatDate = (iso: string) => {
  const d = new Date(iso);
  return Number.isNaN(d.getTime())
    ? iso
    : d.toLocaleDateString('en', { year: 'numeric', month: 'long', day: 'numeric' });
};
---

<MapPage
  title={title}
  currentPath={`/v/${encodeURIComponent(handle)}`}
  label={result.status === 'ok' ? result.venue.name : copy.eyebrow}
  eyebrow={result.status === 'ok' || result.status === 'no-venue' ? (result.actor.handle ? `@${result.actor.handle}` : copy.eyebrow) : copy.eyebrow}
>
  {pins.length > 0 ? <PalateMap slot="map" label={explore.chartLabel} pins={pins} /> : <PalateMap slot="map" label={explore.chartLabel} tide />}
  <div class="space-y-10">
    {result.status === 'ok' ? (
      <>
        <div class="space-y-3">
          <ScreenHeader title={result.venue.name} gloss={result.venue.description ?? undefined} />
          <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
            {result.venue.menu && (
              <a
                href={`/?venue=${encodeURIComponent(result.actor.handle ?? result.actor.did)}`}
                class="btn btn-primary w-full"
              >
                {copy.rankForMe}
              </a>
            )}
            {result.venue.website && (
              <a
                href={result.venue.website}
                rel="noopener noreferrer"
                class="link-caps text-secondary hover:underline hover:underline-offset-4"
              >
                {copy.websiteLabel}
              </a>
            )}
            {result.venue.reservationsUrl && (
              <a
                href={result.venue.reservationsUrl}
                rel="noopener noreferrer"
                class="link-caps text-secondary hover:underline hover:underline-offset-4"
              >
                {copy.reservationsLabel}
              </a>
            )}
            {result.venue.domainVerified && (
              <span class="tag">{copy.domainVerified}</span>
            )}
            {result.venue.menuStyle === 'bespoke' && (
              <span class="tag">{copy.bespokeTag}</span>
            )}
          </div>
          {result.venue.hours && (
            <p class="text-meta text-muted-foreground">{result.venue.hours}</p>
          )}
        </div>

        {result.venue.menu ? (
          <section class="space-y-8">
            <SectionTitle aside={copy.publishedOn(formatDate(result.venue.menu.publishedAt))}>
              {result.venue.menu.title ?? copy.menuTitle}
            </SectionTitle>

            {result.venue.menu.sections.map((section) => (
              <div class="space-y-2">
                {section.name && <SectionTitle as="h3">{section.name}</SectionTitle>}
                <ul class="border-t border-border">
                  {section.items.map((item) => (
                    <DrinkRow
                      rank={item.placed ? pins.find((p) => p.drink.name === item.placed!.name)?.rank : undefined}
                      title={item.name}
                      figure={item.placed ? formatCoordinate(item.placed.x, item.placed.y) : copy.unplaced}
                      note={item.description || undefined}
                    />
                  ))}
                </ul>
              </div>
            ))}
          </section>
        ) : (
          <p class="text-ui text-muted-foreground">
            {result.venue.menuStyle === 'bespoke' ? copy.bespokeMenu : copy.noMenu}
          </p>
        )}
      </>
    ) : result.status === 'no-venue' ? (
      <ScreenHeader title={copy.noVenueTitle} gloss={copy.noVenueBody} />
    ) : result.status === 'unavailable' ? (
      <ScreenHeader title={copy.unavailableTitle} gloss={copy.unavailableBody} />
    ) : (
      <ScreenHeader title={copy.notFoundTitle} gloss={copy.notFoundBody} />
    )}
  </div>
</MapPage>
