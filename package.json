{
  "name": "cotidal",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.7",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --port 9002",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --port 9002",
    "typecheck": "npm run lexicons && ASTRO_TELEMETRY_DISABLED=1 astro check && tsc --noEmit",
    "lexicons": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-lexicons.mjs",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.7",
    "@astrojs/react": "^6.0.2",
    "@atproto/api": "^0.20.42",
    "@atproto/lex-data": "^0.1.8",
    "@atproto/syntax": "^0.7.7",
    "@bbthorson/atproto-cf-auth": "^0.2.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@radix-ui/react-dialog": "^1.1.6",
    "astro": "^7.2.9",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "uqr": "0.1.3",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@atproto/lexicon": "^0.7.17",
    "@playwright/test": "^1.57.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "astro-eslint-parser": "^1.4.0",
    "eslint": "^9.17.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "postcss": "^8",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  }
}
