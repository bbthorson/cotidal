# Local secrets for `astro dev` / `astro preview`. Copy to `.dev.vars`, which
# is gitignored. In production these are Worker secrets set in Cloudflare.

# Generative copy (docs/generation.md). Without it the model routes serve their
# deterministic fallbacks — which looks exactly like working software, so set
# it deliberately rather than discovering it later.
GOOGLE_GENERATIVE_AI_API_KEY=

# AT Protocol OAuth. Sign-in is disabled entirely unless this is truthy. It is
# read at runtime by the server only (src/lib/atproto/auth.ts), so in
# production it is a Worker variable, not a build variable.
# (PUBLIC_ATPROTO_ENABLED is still accepted as an alias.)
ATPROTO_ENABLED=
# Seals sessions. Required on Workers (`wrangler secret put SESSION_SECRET`,
# 32+ random characters); without it sign-in stays off. Open the app at
# http://127.0.0.1:9002, not localhost: client_id and redirect_uri are derived
# from the request's origin.
SESSION_SECRET=
# Optional. Handles resolve over HTTP because the Node resolver needs undici,
# which workerd does not ship. Defaults to https://public.api.bsky.app.
ATPROTO_HANDLE_RESOLVER=
